# En produccion usar el rol abis_app (npm run db:hardening lo crea, privilegios minimos),
# no el superusuario postgres.
DATABASE_URL=postgresql://usuario:password@localhost:5432/abis_db
PORT=3000

# Connection Pool de PostgreSQL (Optimización y Concurrencia)
DB_POOL_MAX=20
DB_POOL_MIN=4
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=45000

# Bot creado con @BotFather (https://t.me/BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=
# Mandale /start a tu bot y consulta https://api.telegram.org/bot<TOKEN>/getUpdates para obtenerlo
TELEGRAM_CHAT_ID=
# Opcional: iniciar bot interactivo automaticamente al ejecutar npm start (true / false)
ENABLE_TELEGRAM_BOT=false

# Clave maestra criptografica para cifrado AES-256-GCM (64 caracteres hexadecimales = 32 bytes)
ENCRYPTION_KEY=4ca912ba6539d028a11e4054d4c2a5c5c3d156b348f241410548ae24a3a2888a

# Clave de autorizacion requerida para la carga de archivos Excel e insercion en la Base de Datos
INGESTA_PASSWORD=pdi2026
