# Conexión a Base de Datos PostgreSQL
# REQUISITO DE SEGURIDAD INSTITUCIONAL:
# - Puerto asignado por informática, arriba de 6000. 6432 es solo un ejemplo: no lo uses
#   hasta que TI confirme que PostgreSQL está configurado para escuchar en ese puerto.
# - No uses el usuario superadministrador de PostgreSQL para la aplicación.
# - En el mismo Windows Server:
DATABASE_URL=postgresql://abis_app:TU_PASSWORD_AQUI@127.0.0.1:6432/sistema_abis
# - Si la DB está en otro servidor de la red institucional (172.x):
# DATABASE_URL=postgresql://abis_app:TU_PASSWORD_AQUI@172.16.X.Y:6432/sistema_abis

# Host de enlace: utilizar la IP institucional asignada por TI. Si no está activa,
# ABIS utiliza localhost; en ese modo solo se puede abrir desde el propio servidor.
HOST=172.25.7.79

# Puerto HTTP del Sistema ABIS:
# Si está ocupado, prueba los siguientes 50 puertos (3001...3050). TI debe autorizar
# el puerto efectivo en el firewall, o todo el rango desde las estaciones permitidas.
PORT=3000
PORT_SEARCH_LIMIT=50
NODE_ENV=production

# Después de registrar SIAD como servicio de Windows y configurar su watchdog,
# mantener ENABLE_SIAD=false para que ABIS no inicie una segunda copia.
ENABLE_SIAD=false
SIAD_URL=http://127.0.0.1:5001

# Opcional: secreto separado para la asercion de sesion ABIS -> SIAD.
# Si queda vacio, se utiliza SECRET_KEY.
ABIS_SSO_SECRET=

# Contraseña inicial temporal para la cuenta 'admin' si la base es nueva.
# Definir un valor único antes del primer inicio y cambiarlo tras la instalación.
ABIS_PASSWORD=CAMBIAR_POR_UNA_CLAVE_TEMPORAL_UNICA

# Connection Pool de PostgreSQL (Optimización y Concurrencia)
DB_POOL_MAX=20
DB_POOL_MIN=4
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=45000

# Bot creado con @BotFather (https://t.me/BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=
# Mandale /start a tu bot y consulta https://api.telegram.org/bot<TOKEN>/getUpdates para obtenerlo
TELEGRAM_CHAT_ID=
# Opcional: iniciar bot interactivo automaticamente al ejecutar npm start (true / false)
ENABLE_TELEGRAM_BOT=false

# Clave maestra criptografica para cifrado AES-256-GCM (64 caracteres hexadecimales = 32 bytes)
# Generarla de forma segura. Si migras datos cifrados existentes, conserva la clave original.
ENCRYPTION_KEY=GENERAR_O_RESTAURAR_LA_CLAVE_HEXADECIMAL_DE_64_CARACTERES

# Clave requerida para JWT y sesiones de ABIS/SIAD; mantenerla igual en ambos módulos.
SECRET_KEY=GENERAR_UN_SECRETO_ALEATORIO_LARGO_Y_UNICO

# Clave de autorizacion requerida para la carga de archivos Excel e insercion en la Base de Datos
INGESTA_PASSWORD=

# Token servidor-a-servidor para que Oracle envie JSON a /api/oracle/populate.
# Generar un valor aleatorio largo y mantenerlo fuera de Git.
ORACLE_INGEST_TOKEN=
ORACLE_INGEST_USER=oracle-integration
