# Conexión a Base de Datos PostgreSQL
# REQUISITO DE SEGURIDAD INSTITUCIONAL:
# - Puerto estrictamente arriba de 6000 (ej. 6432). NUNCA usar 5432 (default), ni 8080 o 8000 (puertos HTTP).
# - En el mismo Windows Server:
DATABASE_URL=postgresql://abis_app:TU_PASSWORD_AQUI@127.0.0.1:6432/sistema_abis
# - Si la DB está en otro servidor de la red institucional (172.x):
# DATABASE_URL=postgresql://abis_app:TU_PASSWORD_AQUI@172.16.X.Y:6432/sistema_abis

# Host de enlace (interfaz de red). En servidor Windows:
# - 'auto': Detecta prioritariamente la IP institucional del servidor (172.25.7.79) y activa enlace dual:
#   Estación 1: Localhost (127.0.0.1) / Estación 2: Red Institucional (172.25.7.79).
#   Si la IP no está activa en la máquina, funciona automáticamente en localhost (127.0.0.1).
# - O IP estática específica: ej. HOST=172.25.7.79
# - '127.0.0.1': Modo local aislado.
# NUNCA usar 0.0.0.0, IP pública ni redes domésticas 192.168.x.x.
HOST=auto

# Puerto HTTP del Sistema ABIS:
# Si el puerto 3000 está ocupado, el sistema busca automáticamente el siguiente puerto libre disponible (3001, 3002...)
PORT=3000
NODE_ENV=production

# SIAD es un servicio de Windows independiente; se inicia al arrancar Windows.
# El supervisor de siad/scripts/watchdog.ps1 lo reinicia si deja de responder.
ENABLE_SIAD=false
SIAD_URL=http://127.0.0.1:5001

# Opcional: secreto separado para la asercion de sesion ABIS -> SIAD.
# Si queda vacio, se utiliza SECRET_KEY.
ABIS_SSO_SECRET=

# Contraseña inicial para la cuenta 'admin' si la base de datos es nueva
ABIS_PASSWORD=PDI_Seguro2026

# Connection Pool de PostgreSQL (Optimización y Concurrencia)
DB_POOL_MAX=20
DB_POOL_MIN=4
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=45000

# Bot creado con @BotFather (https://t.me/BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=
# Mandale /start a tu bot y consulta https://api.telegram.org/bot<TOKEN>/getUpdates para obtenerlo
TELEGRAM_CHAT_ID=
# Opcional: iniciar bot interactivo automaticamente al ejecutar npm start (true / false)
ENABLE_TELEGRAM_BOT=false

# Clave maestra criptografica para cifrado AES-256-GCM (64 caracteres hexadecimales = 32 bytes)
ENCRYPTION_KEY=

# Clave de autorizacion requerida para la carga de archivos Excel e insercion en la Base de Datos
INGESTA_PASSWORD=

# Token servidor-a-servidor para que Oracle envie JSON a /api/oracle/populate.
# Generar un valor aleatorio largo y mantenerlo fuera de Git.
ORACLE_INGEST_TOKEN=
ORACLE_INGEST_USER=oracle-integration
