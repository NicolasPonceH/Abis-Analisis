{
  "name": "sistema-abis",
  "version": "0.1.0",
  "description": "Sistema de Gestion Automatizada de Identificacion Biometrica (ABIS)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test:abis": "node --test tests/abis-refactor.test.cjs tests/abis-operations.test.cjs tests/auth-loading.test.cjs tests/audit-actors.test.cjs tests/schedule-week.test.cjs tests/ingest-deduplication.test.cjs",
    "bench:abis": "node scripts/benchmark-abis.js",
    "db:schema": "node scripts/run-sql.js db/schema.sql",
    "db:seed": "node scripts/run-sql.js db/seed_catalogos.sql",
    "db:views": "node scripts/run-sql.js db/views.sql",
    "db:hardening": "node scripts/run-sql.js db/hardening.sql",
    "db:limpiar": "node scripts/limpiar-registros.js",
    "db:poblar": "node scripts/abis-cli.js ingest",
    "ingest": "node scripts/abis-cli.js validate",
    "etl": "node scripts/abis-cli.js ingest",
    "flujo-diario": "node scripts/abis-cli.js report",
    "validar-integridad": "node scripts/abis-cli.js integrity",
    "telegram:enviar": "node scripts/abis-cli.js send",
    "telegram:caps-fds-2026-10-09-11": "node scripts/enviar-capturas-fds-2026-10-09-11.js",
    "bot": "node scripts/iniciar-bot.js",
    "security:cifrar": "node scripts/abis-cli.js encrypt",
    "security:descifrar": "node scripts/abis-cli.js decrypt",
    "postinstall": "npx playwright install --with-deps chromium",
    "db:crear": "node scripts/abis-cli.js init-db",
    "siad:install": "cd siad && python -m venv .venv && .venv\\Scripts\\pip install -r requirements.txt",
    "setup": "npm install && npm run siad:install && npm run db:crear -- --apply",
    "check:abis": "node scripts/check-abis.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "docx": "^9.7.1",
    "docxtemplater": "^3.71.0",
    "dotenv": "^16.4.5",
    "ejs": "^6.0.1",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsdom": "^30.0.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "oracledb": "^7.0.1",
    "pg": "^8.12.0",
    "pizzip": "^3.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-populate": "^1.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "lucide-static": "^1.47.0",
    "playwright": "^1.62.1"
  }
}
