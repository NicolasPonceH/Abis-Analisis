{
  "name": "sistema-abis",
  "version": "0.1.0",
  "description": "Sistema de Gestion Automatizada de Identificacion Biometrica (ABIS)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "db:schema": "node scripts/run-sql.js db/schema.sql",
    "db:seed": "node scripts/run-sql.js db/seed_catalogos.sql",
    "db:views": "node scripts/run-sql.js db/views.sql",
    "db:hardening": "node scripts/run-sql.js db/hardening.sql",
    "db:limpiar": "node -e \"require('dotenv').config(); const pool = require('./src/db'); pool.query('TRUNCATE registro_enrolamiento RESTART IDENTITY;').then(() => { console.log('✅ Tabla registro_enrolamiento limpiada.'); pool.end(); }).catch(e => { console.error(e); pool.end(); });\"",
    "db:poblar": "node scripts/poblar-desde-excel.js",
    "ingest": "node scripts/ingest-excel.js",
    "etl": "node scripts/procesar-excel.js",
    "flujo-diario": "node scripts/flujo-diario.js",
    "validar-integridad": "node scripts/validar-integridad-historica.js",
    "telegram:enviar": "node scripts/enviar-reporte-telegram.js",
    "security:cifrar": "node scripts/cifrar-archivo.js",
    "security:descifrar": "node scripts/descifrar-archivo.js",
    "postinstall": "npx playwright install --with-deps chromium"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsdom": "^30.0.1",
    "multer": "^2.3.0",
    "oracledb": "^7.0.1",
    "pg": "^8.12.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-populate": "^1.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1"
  }
}
