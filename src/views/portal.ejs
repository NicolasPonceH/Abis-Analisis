<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#000F20">
  <title>Portal de Acceso a Plataformas Operativas | PDI Chile</title>
  <link rel="icon" type="image/png" href="/assets/logo-pdi.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

  <style>
    :root {
      --pdi-gold: #FFD100;
      --pdi-gold-light: #FFE566;
      --pdi-gold-dark: #C69214;
      --pdi-blue: #0077FE;
      --pdi-blue-light: #60A5FA;
      --pdi-blue-dark: #004FA8;
      --navy-950: #010814;
      --navy-900: #021024;
      --navy-850: #041833;
      --white: #FFFFFF;
      --text-muted: #94A3B8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      height: 100%;
      width: 100%;
      overflow: hidden;
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--navy-950);
      color: var(--white);
      -webkit-font-smoothing: antialiased;
    }

    /* Contenedor Principal */
    .portal-wrapper {
      position: relative;
      width: 100%;
      height: 100vh;
      display: flex;
      flex-direction: column;
      isolation: isolate;
      overflow: hidden;
    }

    /* =========================================================
       CABECERA INSTITUCIONAL MINIMALISTA Y ELEGANTE
       ========================================================= */
    .header-bar {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
      padding: 18px 36px;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      background: linear-gradient(180deg, rgba(1, 8, 20, 0.95) 0%, rgba(1, 8, 20, 0.5) 75%, transparent 100%);
      pointer-events: none;
    }

    .header-bar > * {
      pointer-events: auto;
    }

    .access-prompt {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 20px;
      border: 1px solid rgba(255, 209, 0, 0.34);
      border-radius: 999px;
      background: rgba(1, 13, 31, 0.74);
      color: #FFFFFF;
      font-size: 21px;
      font-weight: 900;
      letter-spacing: 0.06em;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.72);
      text-transform: uppercase;
      white-space: nowrap;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3), inset 0 0 14px rgba(255, 209, 0, 0.05);
      backdrop-filter: blur(10px);
    }

    .access-prompt i {
      color: var(--pdi-gold);
      font-size: 18px;
    }

    .header-brand {
      display: flex;
      align-items: center;
      gap: 16px;
      text-decoration: none;
    }

    .header-crest {
      width: 48px;
      height: 48px;
      background: rgba(255, 255, 255, 0.08);
      border: 1.5px solid rgba(255, 209, 0, 0.45);
      border-radius: 12px;
      padding: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(12px);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
      transition: all 0.3s ease;
    }

    .header-brand:hover .header-crest {
      border-color: var(--pdi-gold);
      box-shadow: 0 0 20px rgba(255, 209, 0, 0.45);
      transform: scale(1.05);
    }

    .header-crest img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .header-titles h1 {
      font-size: 15px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #FFFFFF;
      line-height: 1.2;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
    }

    .header-titles p {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--pdi-gold);
      text-shadow: 0 0 10px rgba(255, 209, 0, 0.3);
    }

    .header-meta {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .header-clock {
      position: relative;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: 14px;
      min-width: 238px;
      justify-content: center;
      background: linear-gradient(135deg, rgba(24, 47, 82, 0.98), rgba(1, 12, 30, 0.98));
      border: 2px solid #FFD100;
      padding: 13px 22px;
      border-radius: 18px;
      font-family: ui-monospace, Menlo, Monaco, Consolas, monospace;
      color: #FFFFFF;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.58), 0 0 30px rgba(255, 209, 0, 0.34), inset 0 0 22px rgba(255, 209, 0, 0.12);
      backdrop-filter: blur(12px);
    }

    #liveClockSantiago {
      font-size: 26px;
      font-weight: 900;
      letter-spacing: 0.1em;
      color: #FFFFFF;
      text-shadow: 0 0 8px rgba(255, 255, 255, 0.65), 0 0 22px rgba(255, 209, 0, 0.38);
    }

    .clock-tz-tag {
      font-size: 13px;
      font-weight: 900;
      color: #FFD100;
      letter-spacing: 0.14em;
      border-left: 1px solid rgba(255, 209, 0, 0.45);
      padding-left: 10px;
      margin-left: 2px;
    }

    /* =========================================================
       SPLIT-SCREEN 50/50 CON EXPANSIÓN DINÁMICA MEJORADA
       ========================================================= */
    .split-layout {
      flex: 1;
      display: flex;
      width: 100%;
      height: 100%;
      position: relative;
      background: #F8FAFC;
      isolation: isolate;
    }

    .split-layout::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      background: url('https://res.cloudinary.com/dirgawanf/image/upload/v1791467374/fondo_login_abis_uagfhe.png') center / cover no-repeat;
      opacity: 0.72;
      filter: saturate(0.9) contrast(1.05);
    }

    .split-layout::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: rgba(1, 8, 20, 0.56);
    }

    .split-panel {
      flex: 1;
      height: 100%;
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 100px 60px 80px;
      text-decoration: none;
      color: inherit;
      overflow: hidden;
      cursor: pointer;
      /* Transición de expansión elástica y fluida */
      transition: flex 0.65s cubic-bezier(0.25, 1, 0.35, 1),
                  filter 0.45s ease;
    }

    /* Expansión dinámica al pasar el cursor: el panel activo crece de 50% a ~64% */
    .split-layout:hover .split-panel {
      flex: 0.72;
      filter: brightness(0.65) saturate(0.75);
    }

    .split-layout .split-panel:hover {
      flex: 1.28;
      filter: brightness(1.08) saturate(1.15);
    }

    /* =========================================================
       FONDOS FOTOGRÁFICOS Y ATMÓSFERA PROFUNDA
       ========================================================= */
    .panel-photo-bg {
      display: none;
    }

    .panel-abis .panel-photo-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      display: block;
      background: url('https://res.cloudinary.com/dirgawanf/image/upload/v1791467374/fondo_login_abis_uagfhe.png') center / cover no-repeat;
      opacity: 0.25;
      filter: sepia(0.45) saturate(1.2) contrast(1.05);
      transform: scaleX(-1);
      pointer-events: none;
    }

    /* Panel ABIS: Textura pericial dorada */
    .panel-abis {
      background: radial-gradient(circle at 35% 50%, rgba(255, 209, 0, 0.16) 0%, rgba(3, 20, 42, 0.94) 55%, #010812 100%);
      border-right: 1px solid rgba(255, 209, 0, 0.28);
    }

    .panel-abis .panel-photo-bg {
      background-image: url('https://res.cloudinary.com/dirgawanf/image/upload/v1792585920/fondo_login_abis_cut_u85g9u.png');
      filter: sepia(0.5) hue-rotate(5deg) contrast(1.1);
    }

    /* Panel SIAD: Textura de monitores periciales */
    .panel-siad {
      background: radial-gradient(circle at 65% 50%, rgba(0, 119, 254, 0.18) 0%, rgba(1, 16, 38, 0.94) 55%, #010812 100%);
      border-left: 1px solid rgba(0, 119, 254, 0.28);
    }

    .panel-siad .panel-photo-bg {
      background-image: url('https://res.cloudinary.com/dirgawanf/image/upload/v1792585171/Laboratorio_futurista_de_digitalizaci%C3%B3n_documental_w6k4ah.png');
      filter: hue-rotate(185deg) saturate(1.4) contrast(1.1);
    }
    /* Resplandores Aurales en el Centro de cada Panel */
    .panel-glow-aura {
      position: absolute;
      width: 580px;
      height: 580px;
      border-radius: 50%;
      pointer-events: none;
      z-index: 1;
      opacity: 0.2;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .aura-abis {
      background: radial-gradient(circle, rgba(255, 209, 0, 0.28) 0%, transparent 65%);
      filter: blur(70px);
    }

    .aura-siad {
      background: radial-gradient(circle, rgba(0, 119, 254, 0.32) 0%, transparent 65%);
      filter: blur(70px);
    }

    .split-panel:hover .panel-glow-aura {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.25);
    }

    /* Partículas Flotantes Decorativas */
    .particle-dust {
      position: absolute;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      pointer-events: none;
      z-index: 2;
      opacity: 0.5;
      animation: floatDust 6s ease-in-out infinite;
    }

    @keyframes floatDust {
      0%, 100% { transform: translateY(0) scale(1); opacity: 0.3; }
      50% { transform: translateY(-40px) scale(1.4); opacity: 0.8; }
    }

    /* =========================================================
       CONTENIDO INTERNO DE CADA PANEL
       ========================================================= */
    .panel-content {
      position: relative;
      z-index: 10;
      max-width: 520px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .split-panel:hover .panel-content {
      transform: translateY(-8px);
    }

    /* =========================================================
       EMBLEMA HOLOGRÁFICO CON ANILLO CYBERNETICO Y ESCÁNER LÁSER
       ========================================================= */
    .hologram-hud-wrapper {
      position: relative;
      width: 140px;
      height: 140px;
      margin-bottom: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .split-panel:hover .hologram-hud-wrapper {
      transform: scale(1.12);
    }

    /* Anillo exterior rotatorio cyber */
    .hud-rotating-ring {
      position: absolute;
      inset: -6px;
      border-radius: 50%;
      pointer-events: none;
      transition: all 0.5s ease;
      animation: ringSpin 20s linear infinite;
    }

    .ring-siad {
      border: 2px dashed rgba(0, 119, 254, 0.45);
      box-shadow: 0 0 20px rgba(0, 119, 254, 0.2);
    }

    .split-panel.panel-siad:hover .ring-siad {
      border-color: #60A5FA;
      box-shadow: 0 0 35px rgba(0, 119, 254, 0.5);
      animation-duration: 8s;
    }

    @keyframes ringSpin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    /* Caja de cristal interna con escáner */
    .hud-scanner-core {
      position: relative;
      width: 110px;
      height: 110px;
      border-radius: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      backdrop-filter: blur(12px);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
      transition: all 0.35s ease;
    }

    .core-siad {
      background: linear-gradient(135deg, rgba(0, 119, 254, 0.24) 0%, rgba(0, 119, 254, 0.05) 100%);
      border: 2px solid rgba(0, 119, 254, 0.6);
      color: #60A5FA;
    }

    .split-panel.panel-siad:hover .core-siad {
      box-shadow: 0 0 40px rgba(0, 119, 254, 0.55);
      border-color: #93C5FD;
    }

    .hud-scanner-core .material-symbols-outlined {
      font-size: 60px;
      position: relative;
      z-index: 2;
      filter: drop-shadow(0 4px 10px rgba(0,0,0,0.5));
    }

    /* Haz de escaneo láser en tiempo real */
    .hud-laser-line {
      position: absolute;
      left: 0;
      right: 0;
      height: 3px;
      pointer-events: none;
      z-index: 3;
      opacity: 0.9;
      animation: scanSweep 2.2s ease-in-out infinite;
    }

    .laser-gold {
      background: linear-gradient(90deg, transparent, #FFD100, #FFFFFF, #FFD100, transparent);
      box-shadow: 0 0 16px #FFD100, 0 0 6px #FFFFFF;
    }

    .laser-blue {
      background: linear-gradient(90deg, transparent, #0077FE, #FFFFFF, #0077FE, transparent);
      box-shadow: 0 0 16px #0077FE, 0 0 6px #FFFFFF;
    }

    @keyframes scanSweep {
      0% { top: 6%; opacity: 0; }
      15% { opacity: 1; }
      85% { opacity: 1; }
      100% { top: 92%; opacity: 0; }
    }

    .abis-core {
      position: relative;
      width: 260px;
      height: 174px;
      margin-bottom: 28px;
      display: grid;
      place-items: center;
      border: 7px solid #263650;
      border-radius: 22px;
      background: linear-gradient(145deg, #52647f 0%, #1f2d46 18%, #111b2d 54%, #2b3b58 100%);
      box-shadow: inset 5px 5px 0 rgba(151, 176, 207, 0.22), inset -8px -8px 0 rgba(0, 0, 0, 0.4), 0 0 30px rgba(56, 170, 221, 0.3), 0 0 75px rgba(45, 171, 242, 0.25), 0 17px 0 #101a2b;
      transform: rotateX(12deg) rotateY(-18deg) translateZ(20px);
      transform-style: preserve-3d;
      animation: portalCoreFloat 5.5s ease-in-out infinite;
      transition: filter 0.4s ease;
    }

    .split-panel.panel-abis:hover .abis-core {
      filter: brightness(1.12);
    }

    .abis-core::before {
      position: absolute;
      content: '';
      top: 5%;
      left: 7%;
      width: 86%;
      height: 8px;
      border-radius: 999px;
      background: linear-gradient(90deg, #667997, #1a263b 25%, #111a2a 70%, #7486a1);
      box-shadow: 0 65px 0 rgba(15, 24, 39, 0.9), 0 66px 0 rgba(99, 121, 151, 0.3);
      transform: translateZ(12px);
    }

    .abis-core::after {
      position: absolute;
      right: -5%;
      top: 18%;
      width: 10px;
      height: 58%;
      content: '';
      border: 1px solid rgba(143, 169, 199, 0.48);
      border-radius: 6px;
      background: repeating-linear-gradient(180deg, #0e1728 0 8px, #74849d 9px 11px, #1d2a42 12px 18px);
      box-shadow: 3px 0 0 rgba(0,0,0,0.32);
      transform: translateZ(15px);
    }

    .abis-core .tablet-screen {
      position: relative;
      z-index: 2;
      display: grid;
      width: 90%;
      height: 82%;
      place-items: center;
      overflow: hidden;
      border: 3px solid #0b1321;
      border-radius: 7px;
      background: radial-gradient(circle at 62% 25%, rgba(93, 190, 236, 0.42), transparent 35%), linear-gradient(145deg, rgba(18, 73, 116, 0.92), rgba(3, 20, 43, 0.98));
      box-shadow: inset 0 0 0 1px rgba(120, 214, 255, 0.34), inset 0 0 24px rgba(0, 0, 0, 0.58), 0 0 18px rgba(53, 184, 239, 0.28);
      transform: translateZ(22px);
    }

    .abis-core .tablet-screen::before {
      position: absolute;
      inset: 9%;
      content: '';
      border: 1px solid rgba(163, 231, 255, 0.17);
      border-radius: 3px;
      background: repeating-linear-gradient(0deg, transparent 0 7px, rgba(139, 218, 255, 0.07) 8px, transparent 9px);
      animation: portalTabletScreenGrid 8s linear infinite;
    }

    .abis-core .tablet-screen::after {
      position: absolute;
      inset: 0;
      z-index: 1;
      content: '';
      pointer-events: none;
      background: linear-gradient(135deg, rgba(48, 255, 151, 0.62), rgba(5, 103, 67, 0.88));
      mix-blend-mode: screen;
      opacity: 0;
      animation: portalTabletScreenCycle 8s steps(1, end) infinite;
    }

    .abis-core .tablet-scan-line {
      position: absolute;
      top: -12%;
      left: 5%;
      z-index: 2;
      width: 90%;
      height: 3px;
      border-radius: 999px;
      background: linear-gradient(90deg, transparent, #8cf5ff 18%, #6dffb6 50%, #8cf5ff 82%, transparent);
      box-shadow: 0 0 8px #8cf5ff, 0 0 22px rgba(109, 255, 182, 0.8);
      opacity: 0;
      animation: portalTabletFullScan 8s linear infinite;
    }

    .abis-core .tablet-brand {
      position: relative;
      z-index: 2;
      display: inline-block;
      color: #fff;
      font-size: 21px;
      font-weight: 800;
      letter-spacing: 0.1em;
      line-height: 1;
      text-shadow: 0 3px 15px rgba(0,0,0,0.38), 0 0 18px rgba(130, 220, 255, 0.35);
      text-transform: uppercase;
      transform: translateZ(25px);
      animation: portalTabletBrandCycle 8s steps(1, end) infinite;
    }

    .abis-core .tablet-brand-text {
      display: inline-block;
      background: linear-gradient(90deg, #fff 0%, #fff 38%, #82f1ff 50%, #fff 62%, #fff 100%);
      background-size: 240% 100%;
      background-position: 220% 0;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: portalTabletWordScan 8s linear infinite;
    }

    .abis-core .tablet-brand::before {
      position: absolute;
      top: -55%;
      bottom: -55%;
      left: -12%;
      width: 2px;
      content: '';
      background: #8cf5ff;
      box-shadow: 0 0 7px #8cf5ff, 0 0 18px rgba(77, 223, 255, 0.82);
      opacity: 0;
      pointer-events: none;
      animation: portalTabletScanBeam 8s linear infinite;
    }

    .abis-core .tablet-brand::after {
      position: absolute;
      inset: 0;
      content: attr(data-text);
      color: #6dffb6;
      opacity: 0;
      pointer-events: none;
      text-shadow: 2px 0 #6dffb6, -2px 0 #30e7ff;
      animation: portalTabletBrandGlitch 8s steps(1, end) infinite;
    }

    .abis-core .tablet-enrolled {
      position: absolute;
      z-index: 3;
      inset: 0;
      display: grid;
      place-items: center;
      max-width: 100%;
      padding: 10%;
      color: #6dffb6;
      font-size: 17px;
      font-weight: 900;
      letter-spacing: 0.08em;
      line-height: 1.1;
      opacity: 0;
      text-shadow: 0 0 8px rgba(75, 255, 169, 0.72), 0 0 22px rgba(75, 255, 169, 0.42);
      text-transform: uppercase;
      transform: translateZ(30px);
      animation: portalTabletEnrolledCycle 8s steps(1, end) infinite, portalEnrolledGlitch 3.2s steps(1, end) infinite;
    }

    @keyframes portalCoreFloat {
      0%, 100% { transform: rotateX(12deg) rotateY(-18deg) translate3d(0, 8px, 20px); }
      50% { transform: rotateX(-10deg) rotateY(16deg) translate3d(0, -10px, 34px); }
    }

    @keyframes portalTabletBrandCycle { 0%, 42% { opacity: 1; } 45%, 49% { opacity: 0.2; } 53%, 100% { opacity: 0; } }
    @keyframes portalTabletWordScan { 0% { background-position: 220% 0; } 38% { background-position: -20% 0; } 53%, 100% { background-position: -20% 0; } }
    @keyframes portalTabletScanBeam { 0%, 4% { left: -12%; opacity: 0; } 8% { opacity: 1; } 42% { left: 112%; opacity: 1; } 48%, 100% { left: 112%; opacity: 0; } }
    @keyframes portalTabletFullScan { 0%, 5% { top: -12%; opacity: 0; } 9% { opacity: 0.95; } 42% { top: 112%; opacity: 0.95; } 49%, 100% { top: 112%; opacity: 0; } }
    @keyframes portalTabletScreenGrid { 0%, 4% { opacity: 0.18; background-position: 0 0; } 10% { opacity: 0.42; } 42% { opacity: 0.68; background-position: 0 26px; } 49%, 100% { opacity: 0.18; background-position: 0 26px; } }
    @keyframes portalTabletBrandGlitch { 0%, 42% { opacity: 0; clip-path: inset(0 0 0 0); transform: translate(0); } 44% { opacity: 0.95; clip-path: inset(12% 0 62% 0); transform: translate(-3px, 1px); } 46% { opacity: 0.85; clip-path: inset(56% 0 18% 0); transform: translate(3px, -1px); } 48% { opacity: 0.7; clip-path: inset(28% 0 42% 0); transform: translate(-1px, 0); } 51%, 100% { opacity: 0; clip-path: inset(0 0 0 0); transform: translate(0); } }
    @keyframes portalTabletEnrolledCycle { 0%, 50% { opacity: 0; } 54%, 100% { opacity: 1; } }
    @keyframes portalEnrolledGlitch { 0%, 84%, 100% { transform: translateZ(30px); clip-path: inset(0 0 0 0); } 86% { transform: translate3d(-2px, 1px, 30px); clip-path: inset(12% 0 62% 0); } 88% { transform: translate3d(2px, -1px, 30px); clip-path: inset(56% 0 18% 0); } 90% { transform: translate3d(-1px, 0, 30px); clip-path: inset(28% 0 42% 0); } 92% { transform: translateZ(30px); clip-path: inset(0 0 0 0); }
    }

    /* Píldora de Categoría */
    /* =========================================================
       TÍTULOS MONUMENTALES CON REFLEJO METÁLICO
       ========================================================= */
    .system-title-hero {
      width: fit-content;
      margin-right: auto;
      margin-bottom: 12px;
      margin-left: auto;
      padding: 6px 18px;
      border-radius: 16px;
      background: rgba(1, 8, 20, 0.68);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.38);
      font-size: 76px;
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.03em;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      text-shadow: 0 6px 30px rgba(0, 0, 0, 0.85);
    }

    .panel-abis .system-title-hero {
      border: 1px solid rgba(255, 209, 0, 0.42);
    }

    .panel-siad .system-title-hero {
      border: 1px solid rgba(0, 119, 254, 0.46);
    }

    /* Texto Metálico Dorado Pulido para ABIS */
    .title-metal-abis {
      background: linear-gradient(135deg, #FFFFFF 0%, #FFE566 40%, #FFD100 70%, #D49B00 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 25px rgba(255, 209, 0, 0.45));
    }

    /* Texto Metálico Azul Cian para SIAD */
    .title-metal-siad {
      background: linear-gradient(135deg, #FFFFFF 0%, #BAE6FD 40%, #38BDF8 70%, #0077FE 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 25px rgba(0, 119, 254, 0.5));
    }

    .system-subtitle-hero {
      font-size: 22px;
      font-weight: 900;
      color: #FFFFFF;
      margin-bottom: 16px;
      line-height: 1.35;
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
    }

    .system-desc-hero {
      font-size: 16px;
      color: #CBD5E1;
      line-height: 1.6;
      font-weight: 400;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
      margin-bottom: 36px;
      max-width: 440px;
    }

    /* =========================================================
       BOTONES GIGANTES DE ENTRADA CON PULSO Y SHIMMER
       ========================================================= */
    .btn-action-hero {
      position: relative;
      overflow: hidden;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      width: 100%;
      max-width: 480px;
      min-height: 76px;
      padding: 20px 42px;
      border-radius: 24px;
      text-decoration: none;
      font-size: 20px;
      font-weight: 900;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
    }

    /* Ráfaga de Brillo Shimmer */
    .btn-action-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: -120%;
      width: 80%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
      transform: skewX(-20deg);
      pointer-events: none;
    }

    .split-panel:hover .btn-action-hero::before {
      left: 140%;
      transition: all 0.75s ease-in-out;
    }

    /* Botón ABIS */
    .btn-abis {
      background: linear-gradient(135deg, #FFD100 0%, #E5B800 100%);
      color: #001733;
      border: 2px solid #FFE566;
    }

    .split-panel.panel-abis:hover .btn-abis {
      background: linear-gradient(135deg, #FFE566 0%, #FFD100 100%);
      box-shadow: 0 16px 45px rgba(255, 209, 0, 0.65), 0 0 25px rgba(255, 209, 0, 0.4);
      transform: translateY(-4px) scale(1.03);
      color: #000E20;
    }

    /* Botón SIAD */
    .btn-siad {
      background: linear-gradient(135deg, #0077FE 0%, #0056B8 100%);
      color: #FFFFFF;
      border: 2px solid #66B2FF;
    }

    .split-panel.panel-siad:hover .btn-siad {
      background: linear-gradient(135deg, #248BFF 0%, #006BE8 100%);
      box-shadow: 0 16px 45px rgba(0, 119, 254, 0.65), 0 0 25px rgba(0, 119, 254, 0.4);
      transform: translateY(-4px) scale(1.03);
      color: #FFFFFF;
    }

    .btn-arrow-icon {
      font-size: 25px;
      transition: transform 0.25s ease;
    }

    .split-panel:hover .btn-arrow-icon {
      transform: translateX(10px);
    }

    .session-badge-active {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: #86EFAC;
      background: rgba(16, 185, 129, 0.18);
      border: 1px solid rgba(16, 185, 129, 0.45);
      padding: 6px 16px;
      border-radius: 999px;
      margin-bottom: 16px;
      backdrop-filter: blur(10px);
    }

    /* =========================================================
       DIVISOR CENTRAL INSTITUCIONAL CON ESCUDO OFICIAL PDI (INERTE / NO CLICABLE)
       ========================================================= */
    .center-divider {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 40;
      pointer-events: auto;
      cursor: default;
      user-select: none;
      -webkit-user-select: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      transition: transform 0.6s cubic-bezier(0.2, 1, 0.3, 1),
                  box-shadow 0.4s ease;
    }

    .center-shield-circle {
      position: relative;
      z-index: 1;
      width: 92px;
      height: 92px;
      background: linear-gradient(145deg, rgba(21, 48, 82, 0.98), rgba(1, 12, 28, 0.98));
      border: 3px solid var(--pdi-gold);
      border-radius: 50%;
      padding: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 35px rgba(0, 0, 0, 0.95), 0 0 28px rgba(255, 209, 0, 0.62), inset 0 0 18px rgba(255, 209, 0, 0.12);
      backdrop-filter: blur(14px);
      pointer-events: auto;
      cursor: default;
      transition: all 0.4s ease;
    }

    .center-shield-circle img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      filter: brightness(0) saturate(100%) invert(81%) sepia(99%) saturate(1471%) hue-rotate(359deg) brightness(104%) contrast(104%) drop-shadow(0 0 7px rgba(255, 209, 0, 0.72));
      pointer-events: none;
      user-select: none;
    }

    /* Inclinación interactiva de la insignia central */
    .split-layout:hover .center-divider {
      transform: translate(-50%, -50%) scale(1.08);
    }

    .split-layout:has(.panel-abis:hover) .center-divider {
      transform: translate(calc(-50% + 14vw), -50%) scale(1.08);
    }

    .split-layout:has(.panel-siad:hover) .center-divider {
      transform: translate(calc(-50% - 14vw), -50%) scale(1.08);
    }

    /* =========================================================
       PIE INSTITUCIONAL INFERIOR
       ========================================================= */
    /* =========================================================
       RESPONSIVE DESIGN (PANTALLAS MÓVILES / VERTICALES)
       ========================================================= */
    @media (max-width: 960px) {
      html, body {
        overflow-y: auto;
        height: auto;
      }
      .portal-wrapper {
        height: auto;
        min-height: 100vh;
      }
      .split-layout {
        flex-direction: column;
      }
      .split-panel {
        padding: 90px 24px 60px;
        min-height: 540px;
      }
      .panel-abis {
        border-right: none;
        border-bottom: 1px solid rgba(255, 209, 0, 0.28);
      }
      .panel-siad {
        border-left: none;
      }
      .split-layout:hover .split-panel {
        flex: 1;
        filter: brightness(1);
      }
      .center-divider {
        display: none;
      }
      .access-prompt {
        position: static;
        transform: none;
        margin-right: auto;
        font-size: 14px;
        white-space: normal;
      }
      .header-bar {
        position: relative;
        background: rgba(1, 8, 20, 0.98);
        padding: 14px 20px;
      }
      .system-title-hero {
        font-size: 48px;
      }
    }
  </style>
  <link rel="stylesheet" href="/css/document-scanner-scene.css?v=1">
  <link rel="stylesheet" href="/css/device-scenes.css?v=1">
</head>
<body>

  <div class="portal-wrapper">

    <!-- Barra Superior Institucional -->
    <header class="header-bar">
      <div class="access-prompt">
        <i class="fa-solid fa-arrow-pointer"></i>
        <span>¿A qué sistema desea ingresar?</span>
      </div>
      <div class="header-meta">
        <div class="header-clock" title="Hora Oficial de Santiago de Chile">
          <span id="liveClockSantiago">--:--:--</span>
          <span class="clock-tz-tag">SCL</span>
        </div>
      </div>
    </header>

    <!-- Split-Screen 50/50 Dinámico: ABIS vs SIAD -->
    <main class="split-layout">

      <!-- =========================================================
           PANEL IZQUIERDO: SISTEMA ABIS (DORADO / BIOMETRÍA)
           ========================================================= -->
      <a href="<%= (typeof user !== 'undefined' && user) ? '/abis' : '/login' %>" class="split-panel panel-abis" id="link-panel-abis">
        <!-- Foto de fondo y auras -->
        <div class="panel-photo-bg"></div>
        <div class="panel-glow-aura aura-abis"></div>
        <div class="particle-dust" style="top: 25%; left: 30%; background: #FFD100; animation-delay: 0s;"></div>
        <div class="particle-dust" style="top: 70%; left: 20%; background: #FFE033; animation-delay: 2.5s;"></div>
        <div class="particle-dust" style="top: 45%; left: 75%; background: #FFFFFF; animation-delay: 1.2s;"></div>

        <div class="panel-content">
          <div class="portal-device portal-device--abis">
            <%- include("partials/biometric-tablet") %>
          </div>

          <div class="system-title-hero">
            <span class="title-metal-abis">ABIS</span>
          </div>

          <h2 class="system-subtitle-hero">Sistema Automatizado de Identificación Biométrica</h2>

          <p class="system-desc-hero">
            Registra y consulta información biométrica, revisa estadísticas y envía reportes directamente a Telegram.
          </p>

          <% if (typeof user !== 'undefined' && user) { %>
            <div class="session-badge-active">
              <i class="fa-solid fa-circle-check"></i>
              <span>Sesión activa: <strong><%= user.username %></strong></span>
            </div>
            <div class="btn-action-hero btn-abis">
              <span>Ingresar al Panel ABIS</span>
              <i class="fa-solid fa-arrow-right btn-arrow-icon"></i>
            </div>
          <% } else { %>
            <div class="btn-action-hero btn-abis">
              <span>Ingresar a Sistema ABIS</span>
              <i class="fa-solid fa-arrow-right btn-arrow-icon"></i>
            </div>
          <% } %>
        </div>
      </a>

      <!-- Insignia Central con Escudo Oficial PDI (Completamente inerte, no interactivo) -->
      <div class="center-divider" id="center-shield-divider" onclick="event.preventDefault(); event.stopPropagation(); return false;" title="Policía de Investigaciones de Chile">
        <div class="center-shield-circle" onclick="event.preventDefault(); event.stopPropagation(); return false;">
          <img src="/assets/logo-pdi.png" alt="PDI" draggable="false" style="pointer-events: none; user-select: none;">
        </div>
      </div>

      <!-- =========================================================
           PANEL DERECHO: SISTEMA SIAD (AZUL / ANÁLISIS DOCUMENTAL)
           ========================================================= -->
      <a href="<%= (typeof user !== 'undefined' && user) ? '/analisis/' : '/analisis/login' %>" class="split-panel panel-siad" id="link-panel-siad">
        <!-- Foto de fondo y auras -->
        <div class="panel-photo-bg"></div>
        <div class="panel-glow-aura aura-siad"></div>
        <div class="particle-dust" style="top: 30%; right: 25%; background: #60A5FA; animation-delay: 0.8s;"></div>
        <div class="particle-dust" style="top: 65%; right: 35%; background: #0077FE; animation-delay: 3.1s;"></div>
        <div class="particle-dust" style="top: 40%; right: 70%; background: #FFFFFF; animation-delay: 1.8s;"></div>

        <div class="panel-content">
          <div class="portal-device portal-device--siad" aria-hidden="true">
            <%- include("partials/document-scanner") %>
          </div>

          <div class="system-title-hero">
            <span class="title-metal-siad">SIAD</span>
          </div>

          <h2 class="system-subtitle-hero">Sistema Inteligente de Análisis Documental</h2>

          <p class="system-desc-hero">
            Analiza y resume los reportes enviados por las brigadas para facilitar su revisión y seguimiento.
          </p>

          <% if (typeof user !== 'undefined' && user) { %>
            <div class="session-badge-active">
              <i class="fa-solid fa-circle-check"></i>
              <span>Sesión activa: <strong><%= user.username %></strong></span>
            </div>
            <div class="btn-action-hero btn-siad">
              <span>Ingresar al Panel SIAD</span>
              <i class="fa-solid fa-arrow-right btn-arrow-icon"></i>
            </div>
          <% } else { %>
            <div class="btn-action-hero btn-siad">
              <span>Ingresar a Sistema SIAD</span>
              <i class="fa-solid fa-arrow-right btn-arrow-icon"></i>
            </div>
          <% } %>
        </div>
      </a>

    </main>

  </div>

  <script>
    // Reloj Santiago de Chile en Vivo
    function updateSantiagoClock() {
      const now = new Date();
      const options = { 
        timeZone: 'America/Santiago', 
        hour: '2-digit', 
        minute: '2-digit', 
        second: '2-digit', 
        hour12: false 
      };
      const timeStr = new Intl.DateTimeFormat('es-CL', options).format(now);
      const clockEl = document.getElementById('liveClockSantiago');
      if (clockEl) clockEl.textContent = timeStr;
    }
    setInterval(updateSantiagoClock, 1000);
    updateSantiagoClock();

    // Inmunizar el Escudo Central PDI para que no dispare enlaces ni navegación
    const centerShield = document.getElementById('center-shield-divider');
    if (centerShield) {
      ['click', 'mousedown', 'mouseup', 'pointerdown', 'pointerup', 'touchstart'].forEach(evt => {
        centerShield.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          return false;
        }, { passive: false });
      });
    }
  </script>
</body>
</html>
