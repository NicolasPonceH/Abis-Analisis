<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#001226">
  <title>Portal de Acceso a Plataformas Operativas | PDI Chile</title>
  <link rel="icon" type="image/png" href="/assets/logo-pdi.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

  <style>
    :root {
      --pdi-gold: #FFD100;
      --pdi-gold-light: #FFE033;
      --pdi-gold-dark: #C69214;
      --pdi-blue: #0077FE;
      --pdi-blue-light: #4DA8FF;
      --pdi-blue-dark: #004FA8;
      --navy-950: #010A14;
      --navy-900: #021224;
      --navy-850: #041B33;
      --navy-800: #082647;
      --white: #FFFFFF;
      --text-muted: #94A3B8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      height: 100%;
      width: 100%;
      overflow: hidden;
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--navy-950);
      color: var(--white);
      -webkit-font-smoothing: antialiased;
    }

    /* Contenedor Principal en Pantalla Completa */
    .portal-wrapper {
      position: relative;
      width: 100%;
      height: 100vh;
      display: flex;
      flex-direction: column;
      isolation: isolate;
    }

    /* =========================================================
       CABECERA INSTITUCIONAL MINIMALISTA Y ELEGANTE
       ========================================================= */
    .header-bar {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
      padding: 18px 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: linear-gradient(180deg, rgba(1, 10, 20, 0.92) 0%, rgba(1, 10, 20, 0.4) 70%, transparent 100%);
      pointer-events: none;
    }

    .header-bar > * {
      pointer-events: auto;
    }

    .header-brand {
      display: flex;
      align-items: center;
      gap: 16px;
      text-decoration: none;
    }

    .header-crest {
      width: 50px;
      height: 50px;
      background: rgba(255, 255, 255, 0.08);
      border: 1.5px solid rgba(255, 209, 0, 0.45);
      border-radius: 14px;
      padding: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(10px);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
      transition: all 0.3s ease;
    }

    .header-brand:hover .header-crest {
      border-color: var(--pdi-gold);
      box-shadow: 0 0 20px rgba(255, 209, 0, 0.4);
      transform: scale(1.05);
    }

    .header-crest img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .header-titles h1 {
      font-size: 15px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #FFFFFF;
      line-height: 1.2;
    }

    .header-titles p {
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--pdi-gold);
    }

    .header-meta {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .header-badge-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.14);
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #E2E8F0;
      backdrop-filter: blur(10px);
    }

    .header-clock {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 6px 14px;
      border-radius: 999px;
      font-family: ui-monospace, Menlo, Monaco, Consolas, monospace;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: #FFFFFF;
    }

    .clock-live-indicator {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10B981;
      box-shadow: 0 0 10px #10B981;
      animation: pulseLive 2s infinite;
    }

    @keyframes pulseLive {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    /* =========================================================
       SPLIT-SCREEN 50/50: CONTENEDOR DE DOS MITADES
       ========================================================= */
    .split-layout {
      flex: 1;
      display: flex;
      width: 100%;
      height: 100%;
      position: relative;
    }

    /* =========================================================
       SECCIÓN IZQUIERDA: SISTEMA ABIS (DORADO / BIOMETRÍA)
       ========================================================= */
    .split-panel {
      flex: 1;
      height: 100%;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 100px 60px 80px;
      text-decoration: none;
      color: inherit;
      overflow: hidden;
      cursor: pointer;
      transition: flex 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                  filter 0.4s ease;
    }

    /* Panel ABIS */
    .panel-abis {
      background: radial-gradient(circle at 30% 50%, rgba(255, 209, 0, 0.14) 0%, rgba(4, 25, 48, 0.95) 50%, #010B16 100%);
      border-right: 1px solid rgba(255, 209, 0, 0.25);
    }

    .panel-abis::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(rgba(255, 209, 0, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 209, 0, 0.035) 1px, transparent 1px);
      background-size: 48px 48px;
      pointer-events: none;
      z-index: 1;
    }

    /* Panel SIAD */
    .panel-siad {
      background: radial-gradient(circle at 70% 50%, rgba(0, 119, 254, 0.16) 0%, rgba(2, 20, 42, 0.95) 50%, #010B16 100%);
      border-left: 1px solid rgba(0, 119, 254, 0.25);
    }

    .panel-siad::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(rgba(0, 119, 254, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 119, 254, 0.035) 1px, transparent 1px);
      background-size: 48px 48px;
      pointer-events: none;
      z-index: 1;
    }

    /* Efecto de Expansión Interactiva 50/50 */
    .split-layout:hover .split-panel {
      flex: 0.88;
      filter: brightness(0.75);
    }

    .split-layout .split-panel:hover {
      flex: 1.12;
      filter: brightness(1.05);
    }

    /* Resplandores de Fondo Animados */
    .panel-glow-orbit {
      position: absolute;
      width: 520px;
      height: 520px;
      border-radius: 50%;
      pointer-events: none;
      z-index: 1;
      opacity: 0.6;
      transition: all 0.6s ease;
    }

    .glow-abis {
      background: radial-gradient(circle, rgba(255, 209, 0, 0.25) 0%, transparent 65%);
      filter: blur(60px);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .glow-siad {
      background: radial-gradient(circle, rgba(0, 119, 254, 0.28) 0%, transparent 65%);
      filter: blur(60px);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .split-panel:hover .panel-glow-orbit {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.18);
    }

    /* =========================================================
       CONTENIDO INTERNO DE CADA PANEL (IMPACTANTE Y LEGIBLE)
       ========================================================= */
    .panel-content {
      position: relative;
      z-index: 10;
      max-width: 500px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .split-panel:hover .panel-content {
      transform: translateY(-6px);
    }

    /* Ícono / Emblema Animado con Escáner Láser */
    .visual-scanner-container {
      position: relative;
      width: 120px;
      height: 120px;
      margin-bottom: 28px;
      border-radius: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
      transition: all 0.4s ease;
      overflow: hidden;
    }

    .scanner-box-abis {
      background: linear-gradient(135deg, rgba(255, 209, 0, 0.18) 0%, rgba(255, 209, 0, 0.05) 100%);
      border: 2px solid rgba(255, 209, 0, 0.5);
      color: var(--pdi-gold);
    }

    .scanner-box-siad {
      background: linear-gradient(135deg, rgba(0, 119, 254, 0.2) 0%, rgba(0, 119, 254, 0.05) 100%);
      border: 2px solid rgba(0, 119, 254, 0.5);
      color: #60A5FA;
    }

    .split-panel:hover .visual-scanner-container {
      transform: scale(1.1) rotate(2deg);
    }

    .panel-abis:hover .visual-scanner-container {
      box-shadow: 0 0 35px rgba(255, 209, 0, 0.45);
      border-color: var(--pdi-gold);
    }

    .panel-siad:hover .visual-scanner-container {
      box-shadow: 0 0 35px rgba(0, 119, 254, 0.45);
      border-color: #60A5FA;
    }

    .visual-scanner-container .material-symbols-outlined {
      font-size: 64px;
      position: relative;
      z-index: 2;
    }

    /* Línea de Escaneo Láser Animada */
    .laser-beam {
      position: absolute;
      left: 0;
      right: 0;
      height: 3px;
      pointer-events: none;
      z-index: 3;
      opacity: 0.85;
      animation: scanLaser 2.4s ease-in-out infinite;
    }

    .laser-abis {
      background: linear-gradient(90deg, transparent, #FFD100, #FFFFFF, #FFD100, transparent);
      box-shadow: 0 0 14px #FFD100;
    }

    .laser-siad {
      background: linear-gradient(90deg, transparent, #0077FE, #FFFFFF, #0077FE, transparent);
      box-shadow: 0 0 14px #0077FE;
    }

    @keyframes scanLaser {
      0% { top: 8%; opacity: 0; }
      15% { opacity: 1; }
      85% { opacity: 1; }
      100% { top: 90%; opacity: 0; }
    }

    /* Píldora / Categoría Superior */
    .system-category-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 18px;
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 16px;
      backdrop-filter: blur(8px);
    }

    .pill-abis {
      background: rgba(255, 209, 0, 0.12);
      border: 1px solid rgba(255, 209, 0, 0.4);
      color: var(--pdi-gold);
    }

    .pill-siad {
      background: rgba(0, 119, 254, 0.12);
      border: 1px solid rgba(0, 119, 254, 0.4);
      color: #93C5FD;
    }

    /* Título Monumental del Sistema */
    .system-title-hero {
      font-size: 58px;
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.03em;
      margin-bottom: 10px;
      color: #FFFFFF;
      text-shadow: 0 4px 25px rgba(0, 0, 0, 0.8);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .title-accent-abis {
      color: var(--pdi-gold);
      text-shadow: 0 0 30px rgba(255, 209, 0, 0.5);
    }

    .title-accent-siad {
      color: #60A5FA;
      text-shadow: 0 0 30px rgba(0, 119, 254, 0.5);
    }

    .system-tag {
      font-size: 13px;
      font-weight: 700;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #E2E8F0;
      padding: 4px 10px;
      border-radius: 8px;
      letter-spacing: 0.05em;
    }

    /* Subtítulo Principal de Alta Claridad */
    .system-subtitle-hero {
      font-size: 21px;
      font-weight: 700;
      color: #FFFFFF;
      margin-bottom: 18px;
      line-height: 1.35;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
    }

    /* Breve Descripción Operativa (Sin viñetas de catálogo) */
    .system-desc-hero {
      font-size: 16px;
      color: #CBD5E1;
      line-height: 1.6;
      font-weight: 400;
      margin-bottom: 34px;
      max-width: 440px;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
    }

    /* =========================================================
       BOTONES GIGANTES DE ENTRADA DIRECTA (64PX)
       ========================================================= */
    .btn-action-hero {
      position: relative;
      overflow: hidden;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      width: 100%;
      max-width: 400px;
      min-height: 64px;
      padding: 18px 32px;
      border-radius: 18px;
      text-decoration: none;
      font-size: 18px;
      font-weight: 900;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
    }

    /* Destello Shimmer en Hover */
    .btn-action-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: -120%;
      width: 80%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
      transform: skewX(-20deg);
      pointer-events: none;
    }

    .split-panel:hover .btn-action-hero::before {
      left: 140%;
      transition: all 0.75s ease-in-out;
    }

    /* Botón ABIS */
    .btn-abis {
      background: linear-gradient(135deg, #FFD100 0%, #E5B800 100%);
      color: #001733;
      border: 2px solid #FFE566;
    }

    .split-panel.panel-abis:hover .btn-abis {
      background: linear-gradient(135deg, #FFE033 0%, #FFD100 100%);
      box-shadow: 0 14px 35px rgba(255, 209, 0, 0.5);
      transform: translateY(-3px) scale(1.02);
      color: #000E20;
    }

    /* Botón SIAD */
    .btn-siad {
      background: linear-gradient(135deg, #0077FE 0%, #0056B8 100%);
      color: #FFFFFF;
      border: 2px solid #66B2FF;
    }

    .split-panel.panel-siad:hover .btn-siad {
      background: linear-gradient(135deg, #248BFF 0%, #006BE8 100%);
      box-shadow: 0 14px 35px rgba(0, 119, 254, 0.5);
      transform: translateY(-3px) scale(1.02);
      color: #FFFFFF;
    }

    .btn-arrow-icon {
      font-size: 22px;
      transition: transform 0.25s ease;
    }

    .split-panel:hover .btn-arrow-icon {
      transform: translateX(6px);
    }

    /* Indicador de Sesión Activa */
    .session-badge-active {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: #86EFAC;
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.35);
      padding: 6px 14px;
      border-radius: 999px;
      margin-bottom: 16px;
      backdrop-filter: blur(8px);
    }

    /* =========================================================
       DIVISOR CENTRAL INSTITUCIONAL (CON INSIGNIA PDI)
       ========================================================= */
    .center-divider {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 30;
      pointer-events: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    .center-badge {
      width: 72px;
      height: 72px;
      background: rgba(2, 18, 38, 0.95);
      border: 2px solid var(--pdi-gold);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 35px rgba(0, 0, 0, 0.9), 0 0 15px rgba(255, 209, 0, 0.3);
      backdrop-filter: blur(12px);
      transition: all 0.4s ease;
      animation: pulseCenter 4s ease-in-out infinite;
    }

    @keyframes pulseCenter {
      0%, 100% { box-shadow: 0 0 25px rgba(0,0,0,0.9), 0 0 15px rgba(255, 209, 0, 0.2); }
      50% { box-shadow: 0 0 40px rgba(0,0,0,0.9), 0 0 25px rgba(255, 209, 0, 0.45); }
    }

    .center-badge span {
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 0.1em;
      color: var(--pdi-gold);
      text-transform: uppercase;
    }

    /* =========================================================
       PIE INSTITUCIONAL INFERIOR
       ========================================================= */
    .footer-bar {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 50;
      padding: 14px 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: linear-gradient(0deg, rgba(1, 10, 20, 0.92) 0%, rgba(1, 10, 20, 0.4) 70%, transparent 100%);
      pointer-events: none;
      font-size: 12.5px;
      color: var(--text-muted);
    }

    .footer-bar > * {
      pointer-events: auto;
    }

    .footer-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .footer-left i {
      color: var(--pdi-gold);
    }

    .footer-right {
      color: #64748B;
    }

    /* =========================================================
       RESPONSIVE DESIGN (PANTALLAS MÓVILES / VERTICALES)
       ========================================================= */
    @media (max-width: 960px) {
      html, body {
        overflow-y: auto;
        height: auto;
      }
      .portal-wrapper {
        height: auto;
        min-height: 100vh;
      }
      .split-layout {
        flex-direction: column;
      }
      .split-panel {
        padding: 90px 24px 60px;
        min-height: 520px;
      }
      .panel-abis {
        border-right: none;
        border-bottom: 1px solid rgba(255, 209, 0, 0.25);
      }
      .panel-siad {
        border-left: none;
      }
      .split-layout:hover .split-panel {
        flex: 1;
        filter: brightness(1);
      }
      .center-divider {
        display: none;
      }
      .header-bar {
        position: relative;
        background: rgba(1, 10, 20, 0.95);
        padding: 14px 20px;
      }
      .footer-bar {
        position: relative;
        background: rgba(1, 10, 20, 0.95);
        flex-direction: column;
        gap: 8px;
        text-align: center;
        padding: 16px;
      }
      .system-title-hero {
        font-size: 44px;
      }
    }
  </style>
</head>
<body>

  <div class="portal-wrapper">

    <!-- Barra Superior Institucional -->
    <header class="header-bar">
      <a href="/" class="header-brand">
        <div class="header-crest">
          <img src="/assets/logo-pdi.png" alt="Escudo PDI">
        </div>
        <div class="header-titles">
          <h1>Policía de Investigaciones de Chile</h1>
          <p>Jefatura Nacional de Inteligencia Policial · JENAPOL</p>
        </div>
      </a>

      <div class="header-meta">
        <div class="header-badge-tag">
          <i class="fa-solid fa-shield-halved" style="color: var(--pdi-gold);"></i>
          <span>Portal de Acceso Operativo</span>
        </div>
        <div class="header-clock">
          <span class="clock-live-indicator"></span>
          <span id="liveClockSantiago">--:--:--</span>
          <span style="color: #64748B; font-size: 11px;">SCL</span>
        </div>
      </div>
    </header>

    <!-- Split-Screen 50/50: ABIS vs SIAD -->
    <main class="split-layout">

      <!-- =========================================================
           PANEL IZQUIERDO: SISTEMA ABIS (DORADO / BIOMETRÍA)
           ========================================================= -->
      <a href="<%= (typeof user !== 'undefined' && user) ? '/abis' : '/login' %>" class="split-panel panel-abis" id="link-panel-abis">
        <div class="panel-glow-orbit glow-abis"></div>

        <div class="panel-content">
          <div class="visual-scanner-container scanner-box-abis">
            <div class="laser-beam laser-abis"></div>
            <span class="material-symbols-outlined">fingerprint</span>
          </div>

          <div class="system-category-pill pill-abis">
            <i class="fa-solid fa-fingerprint"></i>
            <span>Biometría y Enrolamiento</span>
          </div>

          <div class="system-title-hero">
            <span class="title-accent-abis">ABIS</span>
            <span class="system-tag">v0.1.0</span>
          </div>

          <h2 class="system-subtitle-hero">Sistema Automatizado de Identificación Biométrica</h2>

          <p class="system-desc-hero">
            Auditoría de enrolamientos biométricos, reportería ejecutiva de ciudadanos extranjeros y estadísticas históricas periciales.
          </p>

          <% if (typeof user !== 'undefined' && user) { %>
            <div class="session-badge-active">
              <i class="fa-solid fa-circle-check"></i>
              <span>Sesión activa: <strong><%= user.username %></strong></span>
            </div>
            <div class="btn-action-hero btn-abis">
              <span>Ingresar al Panel ABIS</span>
              <i class="fa-solid fa-arrow-right btn-arrow-icon"></i>
            </div>
          <% } else { %>
            <div class="btn-action-hero btn-abis">
              <span>Ingresar a Sistema ABIS</span>
              <i class="fa-solid fa-arrow-right btn-arrow-icon"></i>
            </div>
          <% } %>
        </div>
      </a>

      <!-- Insignia Central "VS / O" -->
      <div class="center-divider">
        <div class="center-badge">
          <span>PDI</span>
        </div>
      </div>

      <!-- =========================================================
           PANEL DERECHO: SISTEMA SIAD (AZUL / ANÁLISIS DOCUMENTAL)
           ========================================================= -->
      <a href="/analisis/login" class="split-panel panel-siad" id="link-panel-siad">
        <div class="panel-glow-orbit glow-siad"></div>

        <div class="panel-content">
          <div class="visual-scanner-container scanner-box-siad">
            <div class="laser-beam laser-siad"></div>
            <span class="material-symbols-outlined">document_scanner</span>
