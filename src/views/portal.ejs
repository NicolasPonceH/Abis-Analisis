  <!-- =========================================================
       SCRIPTS DE ACCESIBILIDAD Y RELOJ
       ========================================================= -->
  <script>
    // Reloj Oficial Santiago de Chile
    function updateChileClock() {
      const now = new Date();
      const options = { 
        timeZone: 'America/Santiago', 
        hour: '2-digit', 
        minute: '2-digit', 
        second: '2-digit', 
        hour12: false 
      };
      const timeStr = new Intl.DateTimeFormat('es-CL', options).format(now);
      const clockEl = document.getElementById('relojChile');
      if (clockEl) clockEl.textContent = timeStr;
    }
    setInterval(updateChileClock, 1000);
    updateChileClock();

    // Control de Tamaño de Texto para Personal Mayor / Jefaturas
    function setFontScale(scale) {
      document.documentElement.style.setProperty('--font-scale', scale);
      localStorage.setItem('pdi_portal_font_scale', scale);
      
      document.querySelectorAll('.btn-font-size').forEach(b => b.classList.remove('active'));
      if (scale < 1.05) document.getElementById('btn-scale-sm')?.classList.add('active');
      else if (scale < 1.2) document.getElementById('btn-scale-md')?.classList.add('active');
      else document.getElementById('btn-scale-lg')?.classList.add('active');
    }

    // Alternar Alto Contraste
    function toggleHighContrast() {
      document.body.classList.toggle('high-contrast');
      const isHc = document.body.classList.contains('high-contrast');
      localStorage.setItem('pdi_portal_high_contrast', isHc ? '1' : '0');
    }

    // Cargar preferencias guardadas
    (function initAccessibility() {
      const savedScale = localStorage.getItem('pdi_portal_font_scale');
      if (savedScale) {
        setFontScale(parseFloat(savedScale));
      } else {
        // Por defecto usar tamaño mediano-grande (1.1) para excelente legibilidad de adultos
        setFontScale(1.1);
      }
      if (localStorage.getItem('pdi_portal_high_contrast') === '1') {
        document.body.classList.add('high-contrast');
      }
    })();
  </script>
