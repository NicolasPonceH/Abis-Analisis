  <script>
    // Reloj Santiago de Chile en Vivo
    function updateSantiagoClock() {
      const now = new Date();
      const options = { 
        timeZone: 'America/Santiago', 
        hour: '2-digit', 
        minute: '2-digit', 
        second: '2-digit', 
        hour12: false 
      };
      const timeStr = new Intl.DateTimeFormat('es-CL', options).format(now);
      const clockEl = document.getElementById('liveClockSantiago');
      if (clockEl) clockEl.textContent = timeStr;
    }
    setInterval(updateSantiagoClock, 1000);
    updateSantiagoClock();
  </script>
