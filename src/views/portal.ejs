<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#000F20">
  <title>Portal de Acceso a Plataformas Operativas | PDI Chile</title>
  <link rel="icon" type="image/png" href="/assets/logo-pdi.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

  <style>
    :root {
      --pdi-gold: #FFD100;
      --pdi-gold-light: #FFE566;
      --pdi-gold-dark: #C69214;
      --pdi-blue: #0077FE;
      --pdi-blue-light: #60A5FA;
      --pdi-blue-dark: #004FA8;
      --navy-950: #010814;
      --navy-900: #021024;
      --navy-850: #041833;
      --white: #FFFFFF;
      --text-muted: #94A3B8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      height: 100%;
      width: 100%;
      overflow: hidden;
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--navy-950);
      color: var(--white);
      -webkit-font-smoothing: antialiased;
    }

    /* Contenedor Principal */
    .portal-wrapper {
      position: relative;
      width: 100%;
      height: 100vh;
      display: flex;
      flex-direction: column;
      isolation: isolate;
      overflow: hidden;
    }

    /* =========================================================
       CABECERA INSTITUCIONAL MINIMALISTA Y ELEGANTE
       ========================================================= */
    .header-bar {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      z-index: 50;
      padding: 18px 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: linear-gradient(180deg, rgba(1, 8, 20, 0.95) 0%, rgba(1, 8, 20, 0.5) 75%, transparent 100%);
      pointer-events: none;
    }

    .header-bar > * {
      pointer-events: auto;
    }

    .header-brand {
      display: flex;
      align-items: center;
      gap: 16px;
      text-decoration: none;
    }

    .header-crest {
      width: 48px;
      height: 48px;
      background: rgba(255, 255, 255, 0.08);
      border: 1.5px solid rgba(255, 209, 0, 0.45);
      border-radius: 12px;
      padding: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(12px);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
      transition: all 0.3s ease;
    }

    .header-brand:hover .header-crest {
      border-color: var(--pdi-gold);
      box-shadow: 0 0 20px rgba(255, 209, 0, 0.45);
      transform: scale(1.05);
    }

    .header-crest img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .header-titles h1 {
      font-size: 15px;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #FFFFFF;
      line-height: 1.2;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
    }

    .header-titles p {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--pdi-gold);
      text-shadow: 0 0 10px rgba(255, 209, 0, 0.3);
    }

    .header-meta {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .header-badge-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.16);
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #E2E8F0;
      backdrop-filter: blur(10px);
    }

    .header-clock {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(0, 0, 0, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.14);
      padding: 6px 14px;
      border-radius: 999px;
      font-family: ui-monospace, Menlo, Monaco, Consolas, monospace;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.05em;
      color: #FFFFFF;
    }

    .clock-live-indicator {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10B981;
      box-shadow: 0 0 10px #10B981;
      animation: pulseLive 2s infinite;
    }

    @keyframes pulseLive {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    /* =========================================================
       SPLIT-SCREEN 50/50 CON EXPANSIÓN DINÁMICA MEJORADA
       ========================================================= */
    .split-layout {
      flex: 1;
      display: flex;
      width: 100%;
      height: 100%;
      position: relative;
    }

    .split-panel {
      flex: 1;
      height: 100%;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 100px 60px 80px;
      text-decoration: none;
      color: inherit;
      overflow: hidden;
      cursor: pointer;
      /* Transición de expansión elástica y fluida */
      transition: flex 0.65s cubic-bezier(0.25, 1, 0.35, 1),
                  filter 0.45s ease;
    }

    /* Expansión dinámica al pasar el cursor: el panel activo crece de 50% a ~64% */
    .split-layout:hover .split-panel {
      flex: 0.72;
      filter: brightness(0.65) saturate(0.75);
    }

    .split-layout .split-panel:hover {
      flex: 1.28;
      filter: brightness(1.08) saturate(1.15);
    }

    /* =========================================================
       FONDOS FOTOGRÁFICOS Y ATMÓSFERA PROFUNDA
       ========================================================= */
    .panel-photo-bg {
      position: absolute;
      inset: -20px;
      background-size: cover;
      background-position: center;
      opacity: 0.22;
      z-index: 0;
      pointer-events: none;
      transition: transform 0.8s cubic-bezier(0.2, 1, 0.3, 1),
                  opacity 0.6s ease;
    }

    .split-panel:hover .panel-photo-bg {
      transform: scale(1.08);
      opacity: 0.34;
    }

    /* Panel ABIS: Textura pericial dorada */
    .panel-abis {
      background: radial-gradient(circle at 35% 50%, rgba(255, 209, 0, 0.16) 0%, rgba(3, 20, 42, 0.94) 55%, #010812 100%);
      border-right: 1px solid rgba(255, 209, 0, 0.28);
    }

    .panel-abis .panel-photo-bg {
      background-image: url('https://res.cloudinary.com/dirgawanf/image/upload/v1791467374/fondo_login_abis_uagfhe.png');
      filter: sepia(0.5) hue-rotate(5deg) contrast(1.1);
    }

    .panel-abis::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(rgba(255, 209, 0, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 209, 0, 0.04) 1px, transparent 1px);
      background-size: 50px 50px;
      pointer-events: none;
      z-index: 1;
    }

    /* Panel SIAD: Textura de monitores periciales */
    .panel-siad {
      background: radial-gradient(circle at 65% 50%, rgba(0, 119, 254, 0.18) 0%, rgba(1, 16, 38, 0.94) 55%, #010812 100%);
      border-left: 1px solid rgba(0, 119, 254, 0.28);
    }

    .panel-siad .panel-photo-bg {
      background-image: url('https://res.cloudinary.com/dirgawanf/image/upload/v1791467374/fondo_login_abis_uagfhe.png');
      filter: hue-rotate(185deg) saturate(1.4) contrast(1.1);
    }

    .panel-siad::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(rgba(0, 119, 254, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 119, 254, 0.04) 1px, transparent 1px);
      background-size: 50px 50px;
      pointer-events: none;
      z-index: 1;
    }

    /* Resplandores Aurales en el Centro de cada Panel */
    .panel-glow-aura {
      position: absolute;
      width: 580px;
      height: 580px;
      border-radius: 50%;
      pointer-events: none;
      z-index: 1;
      opacity: 0.65;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .aura-abis {
      background: radial-gradient(circle, rgba(255, 209, 0, 0.28) 0%, transparent 65%);
      filter: blur(70px);
    }

    .aura-siad {
      background: radial-gradient(circle, rgba(0, 119, 254, 0.32) 0%, transparent 65%);
      filter: blur(70px);
    }

    .split-panel:hover .panel-glow-aura {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.25);
    }

    /* Partículas Flotantes Decorativas */
    .particle-dust {
      position: absolute;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      pointer-events: none;
      z-index: 2;
      opacity: 0.5;
      animation: floatDust 6s ease-in-out infinite;
    }

    @keyframes floatDust {
      0%, 100% { transform: translateY(0) scale(1); opacity: 0.3; }
      50% { transform: translateY(-40px) scale(1.4); opacity: 0.8; }
    }

    /* =========================================================
       CONTENIDO INTERNO DE CADA PANEL
       ========================================================= */
    .panel-content {
      position: relative;
      z-index: 10;
      max-width: 520px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .split-panel:hover .panel-content {
      transform: translateY(-8px);
    }

    /* =========================================================
       EMBLEMA HOLOGRÁFICO CON ANILLO CYBERNETICO Y ESCÁNER LÁSER
       ========================================================= */
    .hologram-hud-wrapper {
      position: relative;
      width: 140px;
      height: 140px;
      margin-bottom: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .split-panel:hover .hologram-hud-wrapper {
      transform: scale(1.12);
    }

    /* Anillo exterior rotatorio cyber */
    .hud-rotating-ring {
      position: absolute;
      inset: -6px;
      border-radius: 50%;
      pointer-events: none;
      transition: all 0.5s ease;
      animation: ringSpin 20s linear infinite;
    }

    .ring-abis {
      border: 2px dashed rgba(255, 209, 0, 0.45);
      box-shadow: 0 0 20px rgba(255, 209, 0, 0.2);
    }

    .ring-siad {
      border: 2px dashed rgba(0, 119, 254, 0.45);
      box-shadow: 0 0 20px rgba(0, 119, 254, 0.2);
    }

    .split-panel.panel-abis:hover .ring-abis {
      border-color: var(--pdi-gold);
      box-shadow: 0 0 35px rgba(255, 209, 0, 0.5);
      animation-duration: 8s;
    }

    .split-panel.panel-siad:hover .ring-siad {
      border-color: #60A5FA;
      box-shadow: 0 0 35px rgba(0, 119, 254, 0.5);
      animation-duration: 8s;
    }

    @keyframes ringSpin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    /* Caja de cristal interna con escáner */
    .hud-scanner-core {
      position: relative;
      width: 110px;
      height: 110px;
      border-radius: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      backdrop-filter: blur(12px);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
      transition: all 0.35s ease;
    }

    .core-abis {
      background: linear-gradient(135deg, rgba(255, 209, 0, 0.22) 0%, rgba(255, 209, 0, 0.05) 100%);
      border: 2px solid rgba(255, 209, 0, 0.6);
      color: var(--pdi-gold);
    }

    .core-siad {
      background: linear-gradient(135deg, rgba(0, 119, 254, 0.24) 0%, rgba(0, 119, 254, 0.05) 100%);
      border: 2px solid rgba(0, 119, 254, 0.6);
      color: #60A5FA;
    }

    .split-panel.panel-abis:hover .core-abis {
      box-shadow: 0 0 40px rgba(255, 209, 0, 0.55);
      border-color: #FFE566;
    }

    .split-panel.panel-siad:hover .core-siad {
      box-shadow: 0 0 40px rgba(0, 119, 254, 0.55);
      border-color: #93C5FD;
    }

    .hud-scanner-core .material-symbols-outlined {
      font-size: 60px;
      position: relative;
      z-index: 2;
      filter: drop-shadow(0 4px 10px rgba(0,0,0,0.5));
    }

    /* Haz de escaneo láser en tiempo real */
    .hud-laser-line {
      position: absolute;
      left: 0;
      right: 0;
      height: 3px;
      pointer-events: none;
      z-index: 3;
      opacity: 0.9;
      animation: scanSweep 2.2s ease-in-out infinite;
    }

    .laser-gold {
      background: linear-gradient(90deg, transparent, #FFD100, #FFFFFF, #FFD100, transparent);
      box-shadow: 0 0 16px #FFD100, 0 0 6px #FFFFFF;
    }

    .laser-blue {
      background: linear-gradient(90deg, transparent, #0077FE, #FFFFFF, #0077FE, transparent);
      box-shadow: 0 0 16px #0077FE, 0 0 6px #FFFFFF;
    }

    @keyframes scanSweep {
      0% { top: 6%; opacity: 0; }
      15% { opacity: 1; }
      85% { opacity: 1; }
      100% { top: 92%; opacity: 0; }
    }

    /* Píldora de Categoría */
    .system-category-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 20px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 16px;
      backdrop-filter: blur(10px);
      transition: all 0.3s ease;
    }

    .pill-abis {
      background: rgba(255, 209, 0, 0.14);
      border: 1px solid rgba(255, 209, 0, 0.45);
      color: var(--pdi-gold);
    }

    .pill-siad {
      background: rgba(0, 119, 254, 0.14);
      border: 1px solid rgba(0, 119, 254, 0.45);
      color: #93C5FD;
    }

    .split-panel:hover .system-category-pill {
      transform: scale(1.05);
    }

    /* =========================================================
       TÍTULOS MONUMENTALES CON REFLEJO METÁLICO
       ========================================================= */
    .system-title-hero {
      font-size: 64px;
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.03em;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 14px;
      text-shadow: 0 6px 30px rgba(0, 0, 0, 0.85);
    }

    /* Texto Metálico Dorado Pulido para ABIS */
    .title-metal-abis {
      background: linear-gradient(135deg, #FFFFFF 0%, #FFE566 40%, #FFD100 70%, #D49B00 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 25px rgba(255, 209, 0, 0.45));
    }

    /* Texto Metálico Azul Cian para SIAD */
    .title-metal-siad {
      background: linear-gradient(135deg, #FFFFFF 0%, #BAE6FD 40%, #38BDF8 70%, #0077FE 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 25px rgba(0, 119, 254, 0.5));
    }

    .system-tag {
      font-size: 13px;
      font-weight: 800;
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: #F8FAFC;
      padding: 4px 10px;
      border-radius: 8px;
      letter-spacing: 0.05em;
    }

    .system-subtitle-hero {
      font-size: 22px;
      font-weight: 800;
      color: #FFFFFF;
      margin-bottom: 16px;
      line-height: 1.35;
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
    }

    .system-desc-hero {
      font-size: 16px;
      color: #CBD5E1;
      line-height: 1.6;
      font-weight: 400;
      margin-bottom: 36px;
      max-width: 440px;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
    }

    /* =========================================================
       BOTONES GIGANTES DE ENTRADA CON PULSO Y SHIMMER
       ========================================================= */
    .btn-action-hero {
      position: relative;
      overflow: hidden;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      width: 100%;
      max-width: 410px;
      min-height: 66px;
      padding: 18px 34px;
      border-radius: 20px;
      text-decoration: none;
      font-size: 18px;
      font-weight: 900;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      box-shadow: 0 14px 35px rgba(0, 0, 0, 0.5);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
    }

    /* Ráfaga de Brillo Shimmer */
    .btn-action-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: -120%;
      width: 80%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
      transform: skewX(-20deg);
      pointer-events: none;
    }

    .split-panel:hover .btn-action-hero::before {
      left: 140%;
      transition: all 0.75s ease-in-out;
    }

    /* Botón ABIS */
    .btn-abis {
      background: linear-gradient(135deg, #FFD100 0%, #E5B800 100%);
      color: #001733;
      border: 2px solid #FFE566;
    }

    .split-panel.panel-abis:hover .btn-abis {
      background: linear-gradient(135deg, #FFE566 0%, #FFD100 100%);
      box-shadow: 0 16px 45px rgba(255, 209, 0, 0.65), 0 0 25px rgba(255, 209, 0, 0.4);
      transform: translateY(-4px) scale(1.03);
      color: #000E20;
    }

    /* Botón SIAD */
    .btn-siad {
      background: linear-gradient(135deg, #0077FE 0%, #0056B8 100%);
      color: #FFFFFF;
      border: 2px solid #66B2FF;
    }

    .split-panel.panel-siad:hover .btn-siad {
      background: linear-gradient(135deg, #248BFF 0%, #006BE8 100%);
      box-shadow: 0 16px 45px rgba(0, 119, 254, 0.65), 0 0 25px rgba(0, 119, 254, 0.4);
      transform: translateY(-4px) scale(1.03);
      color: #FFFFFF;
    }

    .btn-arrow-icon {
      font-size: 22px;
      transition: transform 0.25s ease;
    }

    .split-panel:hover .btn-arrow-icon {
      transform: translateX(8px);
    }

    .session-badge-active {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: #86EFAC;
      background: rgba(16, 185, 129, 0.18);
      border: 1px solid rgba(16, 185, 129, 0.45);
      padding: 6px 16px;
      border-radius: 999px;
      margin-bottom: 16px;
      backdrop-filter: blur(10px);
    }

    /* =========================================================
       DIVISOR CENTRAL INSTITUCIONAL CON ESCUDO OFICIAL PDI (INERTE / NO CLICABLE)
       ========================================================= */
    .center-divider {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 40;
      pointer-events: auto;
      cursor: default;
      user-select: none;
      -webkit-user-select: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      transition: transform 0.6s cubic-bezier(0.2, 1, 0.3, 1),
                  box-shadow 0.4s ease;
    }

    .center-shield-circle {
      width: 76px;
      height: 76px;
      background: rgba(2, 16, 36, 0.96);
      border: 2px solid var(--pdi-gold);
      border-radius: 50%;
      padding: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 35px rgba(0, 0, 0, 0.95), 0 0 20px rgba(255, 209, 0, 0.35);
      backdrop-filter: blur(14px);
      pointer-events: auto;
      cursor: default;
      transition: all 0.4s ease;
      animation: centerBreathing 4s ease-in-out infinite;
    }

    .center-shield-circle img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      pointer-events: none;
      user-select: none;
    }

    @keyframes centerBreathing {
      0%, 100% {
        box-shadow: 0 0 30px rgba(0,0,0,0.95), 0 0 15px rgba(255, 209, 0, 0.25);
        transform: scale(1);
      }
      50% {
        box-shadow: 0 0 45px rgba(0,0,0,0.95), 0 0 30px rgba(255, 209, 0, 0.5);
        transform: scale(1.05);
      }
    }

    /* Inclinación interactiva de la insignia central */
    .split-layout:hover .center-divider {
      transform: translate(-50%, -50%) scale(1.08);
    }

    /* =========================================================
       PIE INSTITUCIONAL INFERIOR
       ========================================================= */
    .footer-bar {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 50;
      padding: 14px 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: linear-gradient(0deg, rgba(1, 8, 20, 0.95) 0%, rgba(1, 8, 20, 0.5) 75%, transparent 100%);
      pointer-events: none;
      font-size: 12.5px;
      color: var(--text-muted);
    }

    .footer-bar > * {
      pointer-events: auto;
    }

    .footer-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .footer-left i {
      color: var(--pdi-gold);
    }

    .footer-right {
      color: #64748B;
    }

    /* =========================================================
       RESPONSIVE DESIGN (PANTALLAS MÓVILES / VERTICALES)
       ========================================================= */
    @media (max-width: 960px) {
      html, body {
        overflow-y: auto;
        height: auto;
      }
      .portal-wrapper {
        height: auto;
        min-height: 100vh;
      }
      .split-layout {
        flex-direction: column;
      }
      .split-panel {
        padding: 90px 24px 60px;
        min-height: 540px;
      }
      .panel-abis {
        border-right: none;
        border-bottom: 1px solid rgba(255, 209, 0, 0.28);
      }
      .panel-siad {
        border-left: none;
      }
      .split-layout:hover .split-panel {
        flex: 1;
        filter: brightness(1);
      }
      .center-divider {
        display: none;
      }
      .header-bar {
        position: relative;
        background: rgba(1, 8, 20, 0.98);
        padding: 14px 20px;
      }
      .footer-bar {
        position: relative;
        background: rgba(1, 8, 20, 0.98);
        flex-direction: column;
        gap: 8px;
        text-align: center;
        padding: 16px;
      }
      .system-title-hero {
        font-size: 48px;
      }
    }
  </style>
</head>
<body>

  <div class="portal-wrapper">

    <!-- Barra Superior Institucional -->
    <header class="header-bar">
      <a href="/" class="header-brand">
        <div class="header-crest">
          <img src="/assets/logo-pdi.png" alt="Escudo PDI">
        </div>
        <div class="header-titles">
          <h1>Policía de Investigaciones de Chile</h1>
          <p>Jefatura Nacional de Inteligencia Policial · JENAPOL</p>
        </div>
      </a>

      <div class="header-meta">
        <div class="header-badge-tag">
          <i class="fa-solid fa-shield-halved" style="color: var(--pdi-gold);"></i>
          <span>Portal de Acceso Operativo</span>
        </div>
        <div class="header-clock">
          <span class="clock-live-indicator"></span>
          <span id="liveClockSantiago">--:--:--</span>
          <span style="color: #64748B; font-size: 11px;">SCL</span>
        </div>
      </div>
    </header>

    <!-- Split-Screen 50/50 Dinámico: ABIS vs SIAD -->
    <main class="split-layout">

      <!-- =========================================================
           PANEL IZQUIERDO: SISTEMA ABIS (DORADO / BIOMETRÍA)
           ========================================================= -->
      <a href="<%= (typeof user !== 'undefined' && user) ? '/abis' : '/login' %>" class="split-panel panel-abis" id="link-panel-abis">
        <!-- Foto de fondo y auras -->
        <div class="panel-photo-bg"></div>
        <div class="panel-glow-aura aura-abis"></div>
        <div class="particle-dust" style="top: 25%; left: 30%; background: #FFD100; animation-delay: 0s;"></div>
        <div class="particle-dust" style="top: 70%; left: 20%; background: #FFE033; animation-delay: 2.5s;"></div>
        <div class="particle-dust" style="top: 45%; left: 75%; background: #FFFFFF; animation-delay: 1.2s;"></div>

        <div class="panel-content">
          <!-- Emblema HUD Holográfico con Anillo Cyber y Láser -->
          <div class="hologram-hud-wrapper">
            <div class="hud-rotating-ring ring-abis"></div>
            <div class="hud-scanner-core core-abis">
              <div class="hud-laser-line laser-gold"></div>
              <span class="material-symbols-outlined">fingerprint</span>
            </div>
          </div>

          <div class="system-category-pill pill-abis">
            <i class="fa-solid fa-fingerprint"></i>
            <span>Biometría y Enrolamiento</span>
          </div>

          <div class="system-title-hero">
            <span class="title-metal-abis">ABIS</span>
            <span class="system-tag">v0.1.0</span>
          </div>

          <h2 class="system-subtitle-hero">Sistema Automatizado de Identificación Biométrica</h2>

          <p class="system-desc-hero">
            Auditoría de enrolamientos biométricos, reportería ejecutiva de ciudadanos extranjeros y estadísticas históricas periciales.
          </p>

          <% if (typeof user !== 'undefined' && user) { %>
            <div class="session-badge-active">
              <i class="fa-solid fa-circle-check"></i>
              <span>Sesión activa: <strong><%= user.username %></strong></span>
            </div>
            <div class="btn-action-hero btn-abis">
              <span>Ingresar al Panel ABIS</span>
              <i class="fa-solid fa-arrow-right btn-arrow-icon"></i>
            </div>
          <% } else { %>
            <div class="btn-action-hero btn-abis">
              <span>Ingresar a Sistema ABIS</span>
              <i class="fa-solid fa-arrow-right btn-arrow-icon"></i>
            </div>
          <% } %>
        </div>
      </a>

      <!-- Insignia Central con Escudo Oficial PDI (Completamente inerte, no interactivo) -->
      <div class="center-divider" id="center-shield-divider" onclick="event.preventDefault(); event.stopPropagation(); return false;" title="Policía de Investigaciones de Chile">
        <div class="center-shield-circle" onclick="event.preventDefault(); event.stopPropagation(); return false;">
          <img src="/assets/logo-pdi.png" alt="PDI" draggable="false" style="pointer-events: none; user-select: none;">
        </div>
      </div>

      <!-- =========================================================
           PANEL DERECHO: SISTEMA SIAD (AZUL / ANÁLISIS DOCUMENTAL)
           ========================================================= -->
      <a href="/analisis/login" class="split-panel panel-siad" id="link-panel-siad">
        <!-- Foto de fondo y auras -->
        <div class="panel-photo-bg"></div>
        <div class="panel-glow-aura aura-siad"></div>
        <div class="particle-dust" style="top: 30%; right: 25%; background: #60A5FA; animation-delay: 0.8s;"></div>
        <div class="particle-dust" style="top: 65%; right: 35%; background: #0077FE; animation-delay: 3.1s;"></div>
        <div class="particle-dust" style="top: 40%; right: 70%; background: #FFFFFF; animation-delay: 1.8s;"></div>

        <div class="panel-content">
          <!-- Emblema HUD Holográfico con Anillo Cyber y Láser -->
          <div class="hologram-hud-wrapper">
            <div class="hud-rotating-ring ring-siad"></div>
            <div class="hud-scanner-core core-siad">
              <div class="hud-laser-line laser-blue"></div>
              <span class="material-symbols-outlined">document_scanner</span>
            </div>
          </div>

          <div class="system-category-pill pill-siad">
            <i class="fa-solid fa-file-shield"></i>
            <span>Análisis Documental y Forense</span>
          </div>

          <div class="system-title-hero">
            <span class="title-metal-siad">SIAD</span>
            <span class="system-tag">v2.4.0</span>
          </div>

          <h2 class="system-subtitle-hero">Sistema Inteligente de Análisis Documental</h2>

          <p class="system-desc-hero">
            Procesamiento inteligente mediante OCR pericial para partes policiales, detección de evidencias y tableros estadísticos con datos protegidos.
          </p>

          <div class="btn-action-hero btn-siad">
            <span>Ingresar a Sistema SIAD</span>
            <i class="fa-solid fa-arrow-right btn-arrow-icon"></i>
          </div>
        </div>
      </a>

    </main>

    <!-- Barra Inferior Institucional -->
    <footer class="footer-bar">
      <div class="footer-left">
        <i class="fa-solid fa-lock"></i>
        <span>Acceso exclusivo para personal autorizado de la Policía de Investigaciones de Chile · Ley N° 19.628 / Ley N° 20.084</span>
      </div>
      <div class="footer-right">
        <span>Departamento de Tecnologías de la Información &copy; 2026 JENAPOL</span>
      </div>
    </footer>

  </div>

  <script>
    // Reloj Santiago de Chile en Vivo
    function updateSantiagoClock() {
      const now = new Date();
      const options = { 
        timeZone: 'America/Santiago', 
        hour: '2-digit', 
        minute: '2-digit', 
        second: '2-digit', 
        hour12: false 
      };
      const timeStr = new Intl.DateTimeFormat('es-CL', options).format(now);
      const clockEl = document.getElementById('liveClockSantiago');
      if (clockEl) clockEl.textContent = timeStr;
    }
    setInterval(updateSantiagoClock, 1000);
    updateSantiagoClock();

    // Inmunizar el Escudo Central PDI para que no dispare enlaces ni navegación
    const centerShield = document.getElementById('center-shield-divider');
    if (centerShield) {
      ['click', 'mousedown', 'mouseup', 'pointerdown', 'pointerup', 'touchstart'].forEach(evt => {
        centerShield.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          return false;
        }, { passive: false });
      });
    }
  </script>
</body>
</html>
