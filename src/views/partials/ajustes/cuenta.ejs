<h1 class="ajustes-page-title">Mi Cuenta</h1>
<p class="ajustes-page-subtitle">Gestiona tu perfil y preferencias personales.</p>

<div class="ajustes-card" style="display: flex; align-items: center; gap: 24px;">
  <div style="width: 80px; height: 80px; background: #001F44; border-radius: 50%; color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 800; border: 4px solid #E6EDF7;">
    <%= typeof user !== 'undefined' ? user.username.charAt(0).toUpperCase() : 'U' %>
  </div>
  <div style="flex: 1;">
    <h2 style="margin: 0 0 4px 0; font-size: 24px; color: #001F44; text-transform: capitalize;">
      <%= typeof user !== 'undefined' ? user.username : 'Usuario' %>
    </h2>
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
      <span style="background: #e2e8f0; color: #475569; padding: 4px 12px; border-radius: 20px; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
        <%= typeof user !== 'undefined' ? (user.rol === 'admin' ? 'Administrador' : 'Operador') : 'Operador' %>
      </span>
      <span style="display: flex; align-items: center; gap: 6px; color: #10B981; font-weight: 600; font-size: 13px;">
        <span style="width: 8px; height: 8px; background: #10B981; border-radius: 50%; display: inline-block;"></span> Activo
      </span>
    </div>
    <div style="color: #64748b; font-size: 14px;">
      <i class="fa-solid fa-id-badge" style="margin-right: 4px;"></i> Sistema ABIS
    </div>
  </div>
</div>

<div class="ajustes-card">
  <div class="ajustes-card-header"><i class="fa-solid fa-key"></i> Seguridad de la cuenta</div>
  <p style="color: #475569; font-size: 14px; margin-bottom: 24px;">Mantén tu cuenta segura actualizando tu contraseña periódicamente. El sistema te guiará para crear una contraseña fuerte.</p>
  
  <button onclick="solicitarCambioContrasena()" style="display: inline-flex; align-items: center; gap: 8px; background: #001F44; color: white; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; font-size: 14px; cursor: pointer; transition: background 0.2s;">
    <i class="fa-solid fa-lock"></i> Cambiar Contraseña
  </button>
</div>

<div class="ajustes-card">
  <div class="ajustes-card-header"><i class="fa-solid fa-right-from-bracket"></i> Sesión</div>
  <p style="color: #475569; font-size: 14px; margin-bottom: 24px;">Si iniciaste sesión en un dispositivo público, asegúrate de cerrar sesión al terminar.</p>
  
  <a href="/logout" style="display: inline-flex; align-items: center; gap: 8px; background: #DC2626; color: white; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 14px; transition: background 0.2s;">
    <i class="fa-solid fa-power-off"></i> Cerrar sesión
  </a>
</div>

<script>
  async function solicitarCambioContrasena() {
    const newPass = prompt("Ingresa tu nueva contraseña:");
    if (!newPass) return;
    if (newPass.length < 6) {
      alert("La contraseña debe tener al menos 6 caracteres.");
      return;
    }

    try {
      const res = await fetch('/api/user/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: newPass })
      });
      const data = await res.json();
      if (data.ok) {
        alert("Contraseña actualizada con éxito.");
      } else {
        alert("Error: " + data.error);
      }
    } catch (e) {
      console.error(e);
      alert("Error al intentar cambiar la contraseña.");
    }
  }
</script>
