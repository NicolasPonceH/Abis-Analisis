<div style="max-width: 1200px; margin: 0 auto; padding-bottom: 40px;">
  <div style="margin-bottom: 32px;">
    <h1 style="font-size: 2rem; font-weight: 800; color: var(--text-primary); margin: 0 0 8px 0; letter-spacing: -0.02em;">Mi Cuenta</h1>
    <p style="color: var(--text-muted); font-size: 1.07rem; margin: 0;">Administra tus datos personales y el acceso seguro a tu perfil institucional.</p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); gap: 24px;">
    
    <!-- Perfil Actual -->
    <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
      <div style="background: linear-gradient(135deg, rgba(0, 48, 105, 0.95) 0%, rgba(0, 80, 160, 0.85) 100%); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); padding: 16px 24px; border-bottom: 3.5px solid rgba(255, 209, 0, 0.95); color: #ffffff; box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 1.07rem;">
        <i class="fa-solid fa-id-card" style="color: var(--pdi-gold);"></i> Perfil Actual
      </div>
      <div style="padding: 32px 24px; box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; gap: 24px;">
        <div style="width: 88px; height: 88px; flex-shrink: 0; background: linear-gradient(135deg, var(--text-primary) 0%, #003366 100%); border-radius: 50%; border-bottom: 3.5px solid rgba(255, 209, 0, 0.95); color: #ffffff; box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; justify-content: center; font-size: 36px; font-weight: 800; box-shadow: 0 0 0 4px #eff6ff, 0 4px 10px rgba(0,31,68,0.2);">
          <%= typeof user !== 'undefined' ? user.username.charAt(0).toUpperCase() : 'U' %>
        </div>
        <div style="display: flex; flex-direction: column; gap: 6px;">
          <h2 style="margin: 0; font-size: 24px; font-weight: 800; color: var(--text-primary); text-transform: capitalize; letter-spacing: -0.01em;">
            <%= typeof user !== 'undefined' ? user.username : 'Usuario' %>
          </h2>
          <div style="box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; gap: 12px; margin-top: 4px;">
            <span style="background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">
              <%= typeof user !== 'undefined' ? (user.rol === 'admin' ? 'Administrador' : 'Operador') : 'Operador' %>
            </span>
            <span style="box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; gap: 6px; color: #059669; font-weight: 700; font-size: 0.92rem; background: #ecfdf5; padding: 4px 10px; border-radius: 20px; border: 1px solid #a7f3d0;">
              <span style="width: 6px; height: 6px; background: #10B981; border-radius: 50%; display: inline-block; box-shadow: 0 0 4px #10B981;"></span> Activo
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Cambiar Contraseña -->
    <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); display: flex; flex-direction: column;">
      <div style="background: linear-gradient(135deg, rgba(0, 48, 105, 0.95) 0%, rgba(0, 80, 160, 0.85) 100%); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); padding: 16px 24px; border-bottom: 3.5px solid rgba(255, 209, 0, 0.95); color: #ffffff; box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 1.07rem;">
        <i class="fa-solid fa-shield-halved" style="color: var(--pdi-gold);"></i> Seguridad de Acceso
      </div>
      <div style="padding: 32px 24px; flex: 1; display: flex; flex-direction: column; justify-content: center;" id="mi-contrasena-inicial">
        <div style="background: var(--bg-surface-subtle); border: 1px solid var(--border-subtle); padding: 16px; border-radius: 8px; margin-bottom: 24px;">
          <p style="color: #475569; font-size: 1rem; line-height: 1.6; margin: 0;">
            Mantén tu cuenta protegida actualizando tu contraseña periódicamente. Se recomienda usar al menos 6 caracteres.
          </p>
        </div>
        <button type="button" id="btn-mostrar-mi-contrasena" style="background: var(--text-primary); color: white; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; font-size: 1rem; cursor: pointer; box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; justify-content: center; gap: 10px; text-transform: uppercase; letter-spacing: 0.05em; transition: all 0.2s; box-shadow: 0 4px 6px rgba(0, 31, 68, 0.15); width: 100%;">
          <i class="fa-solid fa-key"></i> Modificar Contraseña
        </button>
      </div>

      <form id="form-mi-contrasena" style="padding: 24px;" hidden novalidate>
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <div>
            <label for="mi-nueva-contrasena" style="display: block; color: #1e293b; font-weight: 700; font-size: 0.92rem; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.05em;">Nueva contraseña</label>
            <input type="password" id="mi-nueva-contrasena" minlength="6" autocomplete="new-password" required style="width: 100%; border: 2px solid var(--border-subtle); padding: 12px; border-radius: 8px; font-size: 1rem; color: var(--text-primary); outline: none; transition: border-color 0.2s; box-sizing: border-box;" onfocus="this.style.borderColor='var(--text-primary)'" onblur="this.style.borderColor='var(--border-subtle)'">
          </div>
          <div>
            <label for="mi-confirmar-contrasena" style="display: block; color: #1e293b; font-weight: 700; font-size: 0.92rem; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.05em;">Confirmar contraseña</label>
            <input type="password" id="mi-confirmar-contrasena" minlength="6" autocomplete="new-password" required style="width: 100%; border: 2px solid var(--border-subtle); padding: 12px; border-radius: 8px; font-size: 1rem; color: var(--text-primary); outline: none; transition: border-color 0.2s; box-sizing: border-box;" onfocus="this.style.borderColor='var(--text-primary)'" onblur="this.style.borderColor='var(--border-subtle)'">
          </div>
        </div>
        <p id="mi-contrasena-feedback" aria-live="polite" style="margin: 12px 0 0 0; font-size: 0.92rem; font-weight: 600;"></p>
        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px;">
          <button type="button" id="btn-cancelar-mi-contrasena" style="background: var(--bg-surface-hover); color: #475569; border: none; padding: 10px 20px; border-radius: 6px; font-weight: 700; font-size: 0.92rem; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em; transition: background 0.2s;" onmouseover="this.style.background='var(--border-subtle)'" onmouseout="this.style.background='var(--bg-surface-hover)'">Cancelar</button>
          <button type="submit" style="background: var(--text-primary); color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: 700; font-size: 0.92rem; cursor: pointer; box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; gap: 8px; text-transform: uppercase; letter-spacing: 0.05em; transition: all 0.2s; box-shadow: 0 4px 6px rgba(0, 31, 68, 0.15);" onmouseover="this.style.transform='translateY(-1px)'; this.style.boxShadow='0 6px 12px rgba(0,31,68,0.2)'" onmouseout="this.style.transform='none'; this.style.boxShadow='0 4px 6px rgba(0,31,68,0.15)'">
            <i class="fa-solid fa-floppy-disk"></i> Guardar
          </button>
        </div>
      </form>
    </div>

    <!-- Sesión (Grid Full Width) -->
    <div style="grid-column: 1 / -1; background: var(--bg-surface); border: 1px solid #fecaca; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(220, 38, 38, 0.05);">
      <div style="background: #fef2f2; border-bottom: 1px solid #fecaca; padding: 16px 24px; color: #991b1b; box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.07rem; text-transform: uppercase; letter-spacing: 0.05em;">
        <i class="fa-solid fa-power-off"></i> Control de Sesión
      </div>
      <div style="padding: 24px; box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;">
        <div>
          <h3 style="margin: 0 0 8px 0; color: var(--text-primary); font-size: 18px; font-weight: 700;">Cerrar sesión activa</h3>
          <p style="color: var(--text-muted); font-size: 1rem; margin: 0; line-height: 1.5;">Si estás utilizando un dispositivo compartido o público, asegúrate de cerrar sesión al terminar para evitar accesos no autorizados.</p>
        </div>
        <a href="/logout" style="background: #DC2626; color: white; padding: 12px 28px; border-radius: 8px; text-decoration: none; font-weight: 800; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; display: inline-flex; align-items: center; justify-content: center; gap: 10px; transition: all 0.2s; box-shadow: 0 4px 6px rgba(220, 38, 38, 0.2); flex-shrink: 0;" onmouseover="this.style.background='#b91c1c'; this.style.transform='translateY(-1px)'; this.style.boxShadow='0 6px 12px rgba(220, 38, 38, 0.3)'" onmouseout="this.style.background='#DC2626'; this.style.transform='none'; this.style.boxShadow='0 4px 6px rgba(220, 38, 38, 0.2)'">
          <i class="fa-solid fa-right-from-bracket"></i> Cerrar Sesión
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const form = document.getElementById('form-mi-contrasena');
    if (!form) return;

    const initialState = document.getElementById('mi-contrasena-inicial');
    const showButton = document.getElementById('btn-mostrar-mi-contrasena');
    const cancelButton = document.getElementById('btn-cancelar-mi-contrasena');
    const feedback = document.getElementById('mi-contrasena-feedback');
    
    const setFeedback = (message, type) => {
      feedback.textContent = message;
      if (type === 'error') {
        feedback.style.color = '#dc2626';
        feedback.style.background = '#fef2f2';
        feedback.style.padding = '8px 12px';
        feedback.style.borderRadius = '6px';
        feedback.style.border = '1px solid #fecaca';
      } else if (type === 'success') {
        feedback.style.color = '#059669';
        feedback.style.background = '#ecfdf5';
        feedback.style.padding = '8px 12px';
        feedback.style.borderRadius = '6px';
        feedback.style.border = '1px solid #a7f3d0';
      } else {
        feedback.style.padding = '0';
        feedback.style.border = 'none';
        feedback.style.background = 'transparent';
      }
    };

    showButton?.addEventListener('click', () => {
      initialState.hidden = true;
      form.hidden = false;
      document.getElementById('mi-nueva-contrasena')?.focus();
    });

    cancelButton?.addEventListener('click', () => {
      form.reset();
      form.hidden = true;
      initialState.hidden = false;
      setFeedback('', '');
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const password = document.getElementById('mi-nueva-contrasena').value;
      const confirmation = document.getElementById('mi-confirmar-contrasena').value;
      const submit = form.querySelector('button[type="submit"]');

      if (password.length < 6) return setFeedback('La contraseña debe tener al menos 6 caracteres.', 'error');
      if (password !== confirmation) return setFeedback('Las contraseñas no coinciden.', 'error');

      submit.disabled = true;
      submit.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Guardando...';
      setFeedback('', '');
      
      try {
        const response = await fetch('/api/user/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password })
        });
        const data = await response.json();
        if (!response.ok || !data.ok) throw new Error(data.error || 'No se pudo actualizar la contraseña.');
        form.reset();
        setFeedback('Contraseña actualizada correctamente.', 'success');
        setTimeout(() => {
          form.hidden = true;
          initialState.hidden = false;
          setFeedback('', '');
        }, 3000);
      } catch (error) {
        setFeedback(error.message || 'No se pudo actualizar la contraseña.', 'error');
      } finally {
        submit.disabled = false;
        submit.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Guardar';
      }
    });
  })();
</script>



