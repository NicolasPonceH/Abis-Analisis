          <div style="box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; gap: 8px;">
            <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" style="stroke: var(--pdi-gold); flex-shrink: 0;">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="16" x2="12" y2="12" />
              <line x1="12" y1="8" x2="12.01" y2="8" />
            </svg>
            <span>
              <strong>Regla de Conexión Telegram:</strong> Todo oficial debe pulsar <strong>/start</strong> en el bot
              una sola vez antes de poder recibir mensajes.
            </span>
          </div>
          <a id="link-directo-bot" href="#" target="_blank" rel="noopener" class="badge badge-info"
            style="font-size: 0.8rem; text-decoration: none; padding: 6px 12px; display: inline-flex; align-items: center; gap: 6px;">
            <span id="label-link-bot">Abrir Bot en Telegram</span> &rarr;
          </a>
        </div>

        <!-- Formulario para Registrar / Asignar Nuevo Destinatario -->
        <div style="padding: 16px 20px; background: #fafbfc; border-bottom: 1px solid var(--border-color);">
          <form id="form-nuevo-destinatario"
            style="display: grid; grid-template-columns: 2fr 1.5fr 1.5fr auto; gap: 12px; align-items: end;">
            <div class="form-group" style="margin: 0;">
              <label for="dest-nombre" class="filter-label" style="margin-bottom: 4px;">Nombre / Oficial /
                Unidad:</label>
              <input type="text" id="dest-nombre" class="form-control" placeholder="Ej: Comisario Morales / Chacalluta"
                required>
            </div>
            <div class="form-group" style="margin: 0;">
              <label for="dest-chat-id" class="filter-label" style="margin-bottom: 4px;">Chat ID de Telegram:</label>
              <input type="text" id="dest-chat-id" class="form-control" placeholder="Ej: 7961617813 ó -1004420809456"
                required>
            </div>
            <div class="form-group" style="margin: 0;">
              <label for="dest-rol" class="filter-label" style="margin-bottom: 4px;">Rol / Unidad Destino:</label>
              <input type="text" id="dest-rol" class="form-control" placeholder="Ej: Operaciones / Enrolamiento"
                value="Operativo">
            </div>
            <button type="submit" id="btn-agregar-destinatario" class="btn btn-primary"
              style="height: 38px; white-space: nowrap;">
              <svg class="svg-icon svg-icon-xs" viewBox="0 0 24 24">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
              </svg>
              <span>+ Asignar ID</span>
            </button>
          </form>
          <div id="dest-feedback" class="crypto-feedback-box" style="display: none; margin-top: 10px;"></div>
