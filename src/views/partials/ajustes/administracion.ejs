<h1 class="ajustes-page-title">Panel de Administración</h1>
<p class="ajustes-page-subtitle">Gestión centralizada de usuarios, roles y accesos del Sistema ABIS.</p>

<% if (typeof user !== 'undefined' && user.rol === 'admin') { %>
  <div class="ajustes-card" style="border-top: 4px solid #D4AF37;">
    <div class="ajustes-card-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: none; margin-bottom: 0;">
      <div><i class="fa-solid fa-users" style="color: #001F44;"></i> Gestión de Usuarios</div>
      <button onclick="createNewUser()" style="background: #001F44; color: white; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 600; font-size: 13px; cursor: pointer;">
        <i class="fa-solid fa-plus"></i> Nuevo Usuario
      </button>
    </div>
    
    <div style="overflow-x: auto; margin-top: 16px;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
        <thead>
          <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #475569;">
            <th style="padding: 12px 16px; font-weight: 600;">Usuario</th>
            <th style="padding: 12px 16px; font-weight: 600;">Rol</th>
            <th style="padding: 12px 16px; font-weight: 600;">Estado</th>
            <th style="padding: 12px 16px; font-weight: 600;">Último Acceso</th>
            <th style="padding: 12px 16px; font-weight: 600; text-align: right;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof dbUsers !== 'undefined' && dbUsers.length > 0) { %>
            <% dbUsers.forEach(u => { %>
              <tr style="border-bottom: 1px solid #e2e8f0;">
                <td style="padding: 14px 16px; font-weight: 600; color: #0f172a;">
                  <i class="fa-solid <%= u.rol === 'admin' ? 'fa-user-shield' : 'fa-user' %>" style="color: <%= u.rol === 'admin' ? '#0B5ED7' : '#64748b' %>; margin-right: 8px;"></i>
                  <%= u.username %>
                </td>
                <td style="padding: 14px 16px;" id="td-rol-<%= u.id %>">
                  <span class="role-badge" style="background: <%= u.rol === 'admin' ? '#eff6ff' : '#f1f5f9' %>; color: <%= u.rol === 'admin' ? '#0B5ED7' : '#475569' %>; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 700; text-transform: capitalize;">
                    <%= u.rol === 'operador' ? 'Operador' : 'Administrador' %>
                  </span>
                </td>
                <td style="padding: 14px 16px;"><span style="color: #10B981; font-weight: 600;"><i class="fa-solid fa-circle" style="font-size: 8px; vertical-align: middle;"></i> Activo</span></td>
                <td style="padding: 14px 16px; color: #64748b;">
                  <%= u.ultimo_ingreso ? new Date(u.ultimo_ingreso).toLocaleString('es-CL') : 'Nunca' %>
                </td>
                <td style="padding: 14px 16px; text-align: right;">
                  <button onclick="changeUserRole(<%= u.id %>, '<%= u.rol %>')" style="background: none; border: none; color: #64748b; cursor: pointer; padding: 4px;" title="Editar Roles"><i class="fa-solid fa-pen"></i></button>
                  <button onclick="resetUserPassword(<%= u.id %>, '<%= u.username %>')" style="background: none; border: none; color: #DC2626; cursor: pointer; padding: 4px;" title="Restablecer Contraseña"><i class="fa-solid fa-key"></i></button>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" style="text-align: center; padding: 24px; color: #64748b;">No se encontraron usuarios</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    async function changeUserRole(userId, currentRole) {
      const newRole = currentRole === 'admin' ? 'operador' : 'admin';
      const conf = confirm(`¿Estás seguro de cambiar el rol a ${newRole}?`);
      if (!conf) return;

      try {
        const res = await fetch('/api/admin/update-role', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: userId, rol: newRole })
        });
        const data = await res.json();
        if (data.ok) {
          alert('Rol actualizado con éxito.');
          window.location.reload();
        } else {
          alert('Error: ' + data.error);
        }
      } catch (e) {
        console.error(e);
        alert('Ocurrió un error al intentar actualizar el rol.');
      }
    }

    async function resetUserPassword(userId, username) {
      const newPass = prompt(`Ingresa la nueva contraseña para el usuario ${username}:`);
      if (!newPass) return;
      if (newPass.length < 6) {
        alert("La contraseña debe tener al menos 6 caracteres.");
        return;
      }
      try {
        const res = await fetch('/api/admin/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: userId, password: newPass })
        });
        const data = await res.json();
        if (data.ok) {
          alert(`Contraseña de ${username} actualizada con éxito.`);
        } else {
          alert("Error: " + data.error);
        }
      } catch (e) {
        console.error(e);
        alert("Error al intentar cambiar la contraseña.");
      }
    }

    async function createNewUser() {
      const username = prompt("Ingresa el nombre del nuevo usuario:");
      if (!username) return;
      const password = prompt("Ingresa la contraseña para el nuevo usuario:");
      if (!password || password.length < 6) {
        alert("La contraseña es requerida y debe tener al menos 6 caracteres.");
        return;
      }
      const conf = confirm(`Se creará el usuario '${username}'. ¿Continuar?`);
      if (!conf) return;

      try {
        const res = await fetch('/api/admin/create-user', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password, rol: 'operador' })
        });
        const data = await res.json();
        if (data.ok) {
          alert("Usuario creado exitosamente.");
          window.location.reload();
        } else {
          alert("Error: " + data.error);
        }
      } catch (e) {
        console.error(e);
        alert("Error al intentar crear el usuario.");
      }
    }
  </script>
<% } else { %>
  <div class="ajustes-card" style="border-left: 4px solid #DC2626;">
    <div style="display: flex; align-items: flex-start; gap: 16px;">
      <i class="fa-solid fa-triangle-exclamation" style="color: #DC2626; font-size: 24px; margin-top: 4px;"></i>
      <div>
        <h3 style="margin: 0 0 8px 0; color: #0f172a; font-size: 16px;">Acceso Denegado</h3>
        <p style="margin: 0; color: #475569; font-size: 14px; line-height: 1.5;">Esta sección está restringida únicamente para usuarios con rol de <strong>Administrador</strong>. Si crees que esto es un error, por favor contacta a soporte técnico.</p>
      </div>
    </div>
  </div>
<% } %>
