<div style="max-width: 1200px; margin: 0 auto; padding-bottom: 40px;">
  <div style="margin-bottom: 32px;">
    <h1 style="font-size: 28px; font-weight: 800; color: #001F44; margin: 0 0 8px 0; letter-spacing: -0.02em;">Panel de Administración</h1>
    <p style="color: #64748b; font-size: 15px; margin: 0;">Gestiona usuarios, roles y credenciales del Sistema ABIS de forma segura.</p>
  </div>

  <% if (typeof user !== 'undefined' && user.rol === 'admin') { %>
    
    <!-- Nuevo Usuario (Colapsable) -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); margin-bottom: 24px;">
      <div style="background: #001F44; padding: 16px 24px; color: #ffffff; display: flex; align-items: center; justify-content: space-between; font-weight: 600; font-size: 15px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <i class="fa-solid fa-user-plus" style="color: #60a5fa;"></i> Alta de Usuarios
        </div>
        <button type="button" id="btn-toggle-nuevo-usuario" style="background: rgba(255,255,255,0.15); color: white; border: 1px solid rgba(255,255,255,0.3); padding: 6px 14px; border-radius: 6px; font-weight: 700; font-size: 12px; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.25)'" onmouseout="this.style.background='rgba(255,255,255,0.15)'">
          <i class="fa-solid fa-plus"></i> Desplegar
        </button>
      </div>

      <form id="form-nuevo-usuario" style="padding: 24px;" hidden novalidate>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; margin-bottom: 16px;">
          <div>
            <label for="nuevo-usuario" style="display: block; color: #1e293b; font-weight: 700; font-size: 13px; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.05em;">Nombre de usuario</label>
            <input type="text" id="nuevo-usuario" minlength="3" maxlength="80" autocomplete="off" required style="width: 100%; border: 2px solid #e2e8f0; padding: 12px; border-radius: 8px; font-size: 14px; color: #0f172a; outline: none; box-sizing: border-box; transition: border-color 0.2s;" onfocus="this.style.borderColor='#001F44'" onblur="this.style.borderColor='#e2e8f0'">
          </div>
          <div>
            <label for="nuevo-rol" style="display: block; color: #1e293b; font-weight: 700; font-size: 13px; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.05em;">Nivel de Acceso</label>
            <select id="nuevo-rol" required style="width: 100%; border: 2px solid #e2e8f0; padding: 12px; border-radius: 8px; font-size: 14px; color: #0f172a; outline: none; cursor: pointer; box-sizing: border-box; transition: border-color 0.2s;" onfocus="this.style.borderColor='#001F44'" onblur="this.style.borderColor='#e2e8f0'">
              <option value="operador">Operador (Estándar)</option>
              <option value="admin">Administrador (Total)</option>
            </select>
          </div>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px;">
          <div>
            <label for="nuevo-password" style="display: block; color: #1e293b; font-weight: 700; font-size: 13px; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.05em;">Contraseña Inicial</label>
            <input type="password" id="nuevo-password" minlength="6" autocomplete="new-password" required style="width: 100%; border: 2px solid #e2e8f0; padding: 12px; border-radius: 8px; font-size: 14px; color: #0f172a; outline: none; box-sizing: border-box; transition: border-color 0.2s;" onfocus="this.style.borderColor='#001F44'" onblur="this.style.borderColor='#e2e8f0'">
          </div>
          <div>
            <label for="nuevo-password-confirm" style="display: block; color: #1e293b; font-weight: 700; font-size: 13px; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.05em;">Confirmar Contraseña</label>
            <input type="password" id="nuevo-password-confirm" minlength="6" autocomplete="new-password" required style="width: 100%; border: 2px solid #e2e8f0; padding: 12px; border-radius: 8px; font-size: 14px; color: #0f172a; outline: none; box-sizing: border-box; transition: border-color 0.2s;" onfocus="this.style.borderColor='#001F44'" onblur="this.style.borderColor='#e2e8f0'">
          </div>
        </div>
        <p id="nuevo-usuario-feedback" aria-live="polite" style="margin: 12px 0 0 0; font-size: 13px; font-weight: 600;"></p>
        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid #e2e8f0;">
          <button type="button" id="btn-cancelar-nuevo-usuario" style="background: #f1f5f9; color: #475569; border: none; padding: 10px 20px; border-radius: 6px; font-weight: 700; font-size: 13px; cursor: pointer; text-transform: uppercase; letter-spacing: 0.05em; transition: background 0.2s;" onmouseover="this.style.background='#e2e8f0'" onmouseout="this.style.background='#f1f5f9'">Cancelar</button>
          <button type="submit" style="background: #001F44; color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: 700; font-size: 13px; cursor: pointer; display: flex; align-items: center; gap: 8px; text-transform: uppercase; letter-spacing: 0.05em; transition: all 0.2s; box-shadow: 0 4px 6px rgba(0, 31, 68, 0.15);" onmouseover="this.style.transform='translateY(-1px)'; this.style.boxShadow='0 6px 12px rgba(0,31,68,0.2)'" onmouseout="this.style.transform='none'; this.style.boxShadow='0 4px 6px rgba(0,31,68,0.15)'">
            <i class="fa-solid fa-user-check"></i> Registrar
          </button>
        </div>
      </form>
    </div>

    <!-- Lista de Usuarios -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
      <div style="background: #001F44; padding: 16px 24px; color: #ffffff; display: flex; align-items: center; justify-content: space-between; font-weight: 600; font-size: 15px;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <i class="fa-solid fa-users" style="color: #60a5fa;"></i> Registro Activo
        </div>
        <span style="background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 700;">
          <%= typeof dbUsers !== 'undefined' ? dbUsers.length : 0 %> Registros
        </span>
      </div>

      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; min-width: 760px;">
          <thead>
            <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
              <th style="padding: 16px 24px; font-weight: 700; color: #475569; text-transform: uppercase; font-size: 12px; letter-spacing: 0.05em;">Usuario</th>
              <th style="padding: 16px 24px; font-weight: 700; color: #475569; text-transform: uppercase; font-size: 12px; letter-spacing: 0.05em;">Rol</th>
              <th style="padding: 16px 24px; font-weight: 700; color: #475569; text-transform: uppercase; font-size: 12px; letter-spacing: 0.05em;">Estado</th>
              <th style="padding: 16px 24px; font-weight: 700; color: #475569; text-transform: uppercase; font-size: 12px; letter-spacing: 0.05em;">Último acceso</th>
              <th style="padding: 16px 24px; font-weight: 700; color: #475569; text-transform: uppercase; font-size: 12px; letter-spacing: 0.05em; text-align: right;">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof dbUsers !== 'undefined' && dbUsers.length > 0) { %>
              <% dbUsers.forEach(u => { %>
                <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.1s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
                  <td style="padding: 16px 24px; font-weight: 700; color: #0f172a;">
                    <i class="fa-solid <%= u.rol === 'admin' ? 'fa-user-shield' : 'fa-user' %>" style="color: <%= u.rol === 'admin' ? '#0284c7' : '#94a3b8' %>; margin-right: 12px;"></i>
                    <%= u.username %>
                  </td>
                  <td style="padding: 16px 24px;" id="td-rol-<%= u.id %>">
                    <span style="background: <%= u.rol === 'admin' ? '#eff6ff' : '#f1f5f9' %>; color: <%= u.rol === 'admin' ? '#1e40af' : '#475569' %>; border: 1px solid <%= u.rol === 'admin' ? '#bfdbfe' : '#e2e8f0' %>; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">
                      <%= u.rol === 'operador' ? 'Operador' : 'Admin' %>
                    </span>
                  </td>
                  <td style="padding: 16px 24px;">
                    <span style="display: inline-flex; align-items: center; gap: 6px; color: #059669; font-weight: 700; font-size: 13px; background: #ecfdf5; padding: 4px 10px; border-radius: 20px; border: 1px solid #a7f3d0;">
                      <span style="width: 6px; height: 6px; background: #10B981; border-radius: 50%; box-shadow: 0 0 4px #10B981;"></span> Activo
                    </span>
                  </td>
                  <td style="padding: 16px 24px; color: #64748b; font-size: 13px;">
                    <%= u.ultimo_ingreso ? new Date(u.ultimo_ingreso).toLocaleString('es-CL') : 'Nunca' %>
                  </td>
                  <td style="padding: 16px 24px; text-align: right;">
                    <div style="display: flex; justify-content: flex-end; gap: 8px;">
                      <button type="button" onclick="openRoleModal(<%= u.id %>, '<%= u.rol %>')" style="background: #f1f5f9; color: #0f172a; border: 1px solid #e2e8f0; padding: 8px 12px; border-radius: 6px; font-weight: 700; font-size: 12px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s;" onmouseover="this.style.background='#e2e8f0'" onmouseout="this.style.background='#f1f5f9'">
                        <i class="fa-solid fa-pen" style="color: #64748b;"></i> Rol
                      </button>
                      <button type="button" data-username="<%= u.username %>" onclick="openPasswordModal(<%= u.id %>, this)" style="background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; padding: 8px 12px; border-radius: 6px; font-weight: 700; font-size: 12px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s;" onmouseover="this.style.background='#fee2e2'" onmouseout="this.style.background='#fef2f2'">
                        <i class="fa-solid fa-key" style="color: #ef4444;"></i> Clave
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5" style="text-align: center; padding: 40px; color: #94a3b8; font-weight: 600;"><i class="fa-solid fa-folder-open" style="font-size: 24px; display: block; margin-bottom: 12px; color: #cbd5e1;"></i> No hay usuarios registrados</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modals de Acción (Ocultos por defecto) -->
    <div id="admin-action-modal" style="position: fixed; inset: 0; background: rgba(15,23,42,0.6); backdrop-filter: blur(4px); z-index: 100; display: none; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.2s;">
      <div style="background: #ffffff; width: 100%; max-width: 480px; border-radius: 16px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04); overflow: hidden; transform: scale(0.95); transition: transform 0.2s;">
        <div style="padding: 24px 32px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <h2 id="admin-modal-title" style="margin: 0 0 4px 0; font-size: 20px; font-weight: 800; color: #0f172a;">Administrar</h2>
            <p id="admin-modal-subtitle" style="margin: 0; color: #64748b; font-size: 13px;"></p>
          </div>
          <button type="button" onclick="closeAdminModal()" style="background: transparent; border: none; color: #94a3b8; font-size: 24px; cursor: pointer; padding: 4px; border-radius: 50%; transition: all 0.2s; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;" onmouseover="this.style.background='#f1f5f9'; this.style.color='#0f172a'" onmouseout="this.style.background='transparent'; this.style.color='#94a3b8'">&times;</button>
        </div>

        <div style="padding: 32px;">
          <!-- Form Role -->
          <form id="form-editar-rol" hidden>
            <div style="margin-bottom: 24px;">
              <label for="editar-rol" style="display: block; color: #1e293b; font-weight: 700; font-size: 13px; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">Asignar Privilegios</label>
              <select id="editar-rol" style="width: 100%; border: 2px solid #e2e8f0; padding: 12px; border-radius: 8px; font-size: 14px; color: #0f172a; outline: none; cursor: pointer; transition: border-color 0.2s;" onfocus="this.style.borderColor='#001F44'" onblur="this.style.borderColor='#e2e8f0'">
                <option value="operador">Operador</option>
                <option value="admin">Administrador</option>
              </select>
            </div>
            <p id="editar-rol-feedback" style="margin: 0 0 16px 0; font-size: 13px; font-weight: 600;"></p>
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
              <button type="button" onclick="closeAdminModal()" style="background: #f1f5f9; color: #475569; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; font-size: 13px; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='#e2e8f0'" onmouseout="this.style.background='#f1f5f9'">Cancelar</button>
              <button type="submit" style="background: #001F44; color: white; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; font-size: 13px; cursor: pointer; box-shadow: 0 4px 6px rgba(0,31,68,0.15); transition: all 0.2s;" onmouseover="this.style.transform='translateY(-1px)'; this.style.boxShadow='0 6px 12px rgba(0,31,68,0.2)'" onmouseout="this.style.transform='none'; this.style.boxShadow='0 4px 6px rgba(0,31,68,0.15)'">Actualizar Rol</button>
            </div>
          </form>

          <!-- Form Password -->
          <form id="form-cambiar-password-admin" hidden novalidate>
            <div style="margin-bottom: 16px;">
              <label for="admin-nueva-password" style="display: block; color: #1e293b; font-weight: 700; font-size: 13px; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">Nueva Contraseña Fuerte</label>
              <input type="password" id="admin-nueva-password" minlength="6" autocomplete="new-password" required style="width: 100%; border: 2px solid #e2e8f0; padding: 12px; border-radius: 8px; font-size: 14px; color: #0f172a; outline: none; box-sizing: border-box; transition: border-color 0.2s;" onfocus="this.style.borderColor='#DC2626'" onblur="this.style.borderColor='#e2e8f0'">
            </div>
            <div style="margin-bottom: 24px;">
              <label for="admin-confirmar-password" style="display: block; color: #1e293b; font-weight: 700; font-size: 13px; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">Repetir Contraseña</label>
              <input type="password" id="admin-confirmar-password" minlength="6" autocomplete="new-password" required style="width: 100%; border: 2px solid #e2e8f0; padding: 12px; border-radius: 8px; font-size: 14px; color: #0f172a; outline: none; box-sizing: border-box; transition: border-color 0.2s;" onfocus="this.style.borderColor='#DC2626'" onblur="this.style.borderColor='#e2e8f0'">
            </div>
            <p id="admin-password-feedback" style="margin: 0 0 16px 0; font-size: 13px; font-weight: 600;"></p>
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
              <button type="button" onclick="closeAdminModal()" style="background: #f1f5f9; color: #475569; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; font-size: 13px; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='#e2e8f0'" onmouseout="this.style.background='#f1f5f9'">Cancelar</button>
              <button type="submit" style="background: #DC2626; color: white; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; font-size: 13px; cursor: pointer; box-shadow: 0 4px 6px rgba(220,38,38,0.15); transition: all 0.2s;" onmouseover="this.style.transform='translateY(-1px)'; this.style.boxShadow='0 6px 12px rgba(220,38,38,0.25)'" onmouseout="this.style.transform='none'; this.style.boxShadow='0 4px 6px rgba(220,38,38,0.15)'">Forzar Cambio</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script>
      let currentAdminTargetId = null;

      const modalEl = document.getElementById('admin-action-modal');
      const formRole = document.getElementById('form-editar-rol');
      const formPwd = document.getElementById('form-cambiar-password-admin');
      const modalTitle = document.getElementById('admin-modal-title');
      const modalSubtitle = document.getElementById('admin-modal-subtitle');

      function setFeedback(elementId, message, type) {
        const el = document.getElementById(elementId);
        if (!el) return;
        el.textContent = message;
        if (type === 'error') {
          el.style.color = '#dc2626';
          el.style.background = '#fef2f2';
          el.style.padding = '8px 12px';
          el.style.borderRadius = '6px';
          el.style.border = '1px solid #fecaca';
        } else if (type === 'success') {
          el.style.color = '#059669';
          el.style.background = '#ecfdf5';
          el.style.padding = '8px 12px';
          el.style.borderRadius = '6px';
          el.style.border = '1px solid #a7f3d0';
        } else {
          el.style.padding = '0';
          el.style.border = 'none';
          el.style.background = 'transparent';
        }
      }

      function openModal() {
        modalEl.style.display = 'flex';
        // force reflow
        void modalEl.offsetWidth;
        modalEl.style.opacity = '1';
        modalEl.querySelector('div').style.transform = 'scale(1)';
      }

      window.closeAdminModal = function() {
        modalEl.style.opacity = '0';
        modalEl.querySelector('div').style.transform = 'scale(0.95)';
        setTimeout(() => {
          modalEl.style.display = 'none';
          formRole.hidden = true;
          formPwd.hidden = true;
          formRole.reset();
          formPwd.reset();
          setFeedback('editar-rol-feedback', '', '');
          setFeedback('admin-password-feedback', '', '');
        }, 200);
      };

      window.openRoleModal = function(id, currentRole) {
        currentAdminTargetId = id;
        document.getElementById('editar-rol').value = currentRole;
        modalTitle.textContent = 'Editar Nivel de Acceso';
        modalSubtitle.textContent = 'Asigna privilegios de sistema a este usuario.';
        formRole.hidden = false;
        openModal();
      };

      window.openPasswordModal = function(id, btn) {
        currentAdminTargetId = id;
        const username = btn.getAttribute('data-username');
        modalTitle.textContent = 'Restablecer Credenciales';
        modalSubtitle.textContent = `Cambio forzado para: ${username}`;
        formPwd.hidden = false;
        openModal();
      };

      // Toggle new user
      const toggleBtn = document.getElementById('btn-toggle-nuevo-usuario');
      const formNuevo = document.getElementById('form-nuevo-usuario');
      const cancelNuevoBtn = document.getElementById('btn-cancelar-nuevo-usuario');

      toggleBtn?.addEventListener('click', () => {
        formNuevo.hidden = !formNuevo.hidden;
        toggleBtn.innerHTML = formNuevo.hidden ? '<i class="fa-solid fa-plus"></i> Desplegar' : '<i class="fa-solid fa-minus"></i> Ocultar';
      });

      cancelNuevoBtn?.addEventListener('click', () => {
        formNuevo.hidden = true;
        formNuevo.reset();
        setFeedback('nuevo-usuario-feedback', '', '');
        toggleBtn.innerHTML = '<i class="fa-solid fa-plus"></i> Desplegar';
      });

      // Handlers
      formNuevo?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const username = document.getElementById('nuevo-usuario').value;
        const rol = document.getElementById('nuevo-rol').value;
        const pass = document.getElementById('nuevo-password').value;
        const conf = document.getElementById('nuevo-password-confirm').value;
        const btn = formNuevo.querySelector('button[type="submit"]');

        if (pass.length < 6) return setFeedback('nuevo-usuario-feedback', 'La contraseña debe tener 6 caracteres mínimo.', 'error');
        if (pass !== conf) return setFeedback('nuevo-usuario-feedback', 'Las contraseñas no coinciden.', 'error');

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Registrando...';
        setFeedback('nuevo-usuario-feedback', '', '');

        try {
          const res = await fetch('/api/admin/create-user', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password: pass, rol })
          });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || 'Error al crear usuario.');
          
          setFeedback('nuevo-usuario-feedback', 'Usuario creado exitosamente. Recargando...', 'success');
          setTimeout(() => window.location.reload(), 1500);
        } catch (err) {
          setFeedback('nuevo-usuario-feedback', err.message, 'error');
          btn.disabled = false;
          btn.innerHTML = '<i class="fa-solid fa-user-check"></i> Registrar';
        }
      });

      formRole?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const rol = document.getElementById('editar-rol').value;
        const btn = formRole.querySelector('button[type="submit"]');

        btn.disabled = true;
        setFeedback('editar-rol-feedback', 'Guardando...', '');

        try {
          const res = await fetch('/api/admin/update-role', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: currentAdminTargetId, rol })
          });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || 'Error al actualizar.');
          
          setFeedback('editar-rol-feedback', 'Actualizado. Recargando...', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } catch (err) {
          setFeedback('editar-rol-feedback', err.message, 'error');
          btn.disabled = false;
        }
      });

      formPwd?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const pass = document.getElementById('admin-nueva-password').value;
        const conf = document.getElementById('admin-confirmar-password').value;
        const btn = formPwd.querySelector('button[type="submit"]');

        if (pass.length < 6) return setFeedback('admin-password-feedback', 'La contraseña debe tener 6 caracteres mínimo.', 'error');
        if (pass !== conf) return setFeedback('admin-password-feedback', 'Las contraseñas no coinciden.', 'error');

        btn.disabled = true;
        btn.innerHTML = 'Procesando...';
        setFeedback('admin-password-feedback', '', '');

        try {
          const res = await fetch('/api/admin/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: currentAdminTargetId, password: pass })
          });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || 'Error al restablecer.');
          
          setFeedback('admin-password-feedback', 'Clave restablecida correctamente.', 'success');
          setTimeout(() => closeAdminModal(), 2000);
        } catch (err) {
          setFeedback('admin-password-feedback', err.message, 'error');
        } finally {
          btn.disabled = false;
          btn.innerHTML = 'Forzar Cambio';
        }
      });
    </script>
  <% } else { %>
    <div style="background: #fff1f2; border: 1px solid #fecaca; border-left: 4px solid #e11d48; padding: 24px; border-radius: 12px; margin-top: 24px;">
      <h2 style="color: #be123c; margin: 0 0 8px 0; font-size: 18px; display: flex; align-items: center; gap: 8px;">
        <i class="fa-solid fa-lock"></i> Acceso Restringido
      </h2>
      <p style="color: #9f1239; margin: 0; font-size: 15px; line-height: 1.5;">
        Esta área es exclusiva para cuentas con nivel de <strong>Administrador</strong>. Por favor, comunícate con el soporte técnico si consideras que necesitas acceso a este módulo.
      </p>
    </div>
  <% } %>
</div>
