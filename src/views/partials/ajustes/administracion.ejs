<div style="width: 100%; padding-bottom: 40px;">
  <div style="margin-bottom: 32px;">
    <h1 style="font-size: 2rem; font-weight: 800; color: var(--text-primary); margin: 0 0 8px 0; letter-spacing: -0.02em;">Panel de Administración</h1>
    <p style="color: var(--text-muted); font-size: 1.07rem; margin: 0;">Gestiona usuarios y permisos de ABIS. Los permisos de SIAD se administran dentro de SIAD.</p>
  </div>

  <% if (typeof user !== 'undefined' && user.rol === 'admin') { %>
    
    <!-- Nuevo Usuario (Colapsable) -->
    <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); margin-bottom: 24px;">
      <div style="background: linear-gradient(135deg, rgba(0, 48, 105, 0.95) 0%, rgba(0, 80, 160, 0.85) 100%); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); padding: 16px 24px; border-bottom: 3.5px solid rgba(255, 209, 0, 0.95); color: #ffffff; box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; justify-content: space-between; font-weight: 600; font-size: 1.07rem;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <i class="fa-solid fa-user-plus" style="color: var(--pdi-gold);"></i> Añadir usuarios
        </div>
        <button type="button" id="open-new-user-modal" class="admin-add-button">
          <i class="fa-solid fa-plus"></i> Añadir
        </button>
      </div>

      <form id="form-nuevo-usuario" style="padding: 24px;" novalidate>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; margin-bottom: 16px;">
          <div>
            <label for="nuevo-usuario" style="display: block; color: #1e293b; font-weight: 700; font-size: 0.92rem; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.05em;">Nombre de usuario</label>
            <input type="text" id="nuevo-usuario" minlength="3" maxlength="80" autocomplete="off" required style="width: 100%; border: 2px solid var(--border-subtle); padding: 12px; border-radius: 8px; font-size: 1rem; color: var(--text-primary); outline: none; box-sizing: border-box; transition: border-color 0.2s;" onfocus="this.style.borderColor='var(--text-primary)'" onblur="this.style.borderColor='var(--border-subtle)'">
          </div>
          <div>
            <label style="display: block; color: #1e293b; font-weight: 700; font-size: 0.92rem; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.05em;">Rol de ABIS</label>
            <input type="hidden" id="nuevo-rol" value="operador">
            <div class="admin-role-choices" role="radiogroup" aria-label="Rol inicial de ABIS">
              <label class="admin-role-choice" data-role="operador">
                <input type="radio" name="nuevo-rol-opcion" value="operador" checked>
                <span class="admin-role-choice-icon"><i class="fa-solid fa-user-gear" aria-hidden="true"></i></span>
                <span class="admin-role-choice-copy"><strong>Operador</strong><span>Acceso a las herramientas de trabajo de ABIS.</span></span>
                <span class="admin-role-choice-check"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
              </label>
              <label class="admin-role-choice" data-role="admin">
                <input type="radio" name="nuevo-rol-opcion" value="admin">
                <span class="admin-role-choice-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
                <span class="admin-role-choice-copy"><strong>Administrador</strong><span>Gestiona usuarios y configuración de ABIS.</span></span>
                <span class="admin-role-choice-check"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
              </label>
              <label class="admin-role-choice" data-role="ninguno">
                <input type="radio" name="nuevo-rol-opcion" value="ninguno">
                <span class="admin-role-choice-icon"><i class="fa-solid fa-user-lock" aria-hidden="true"></i></span>
                <span class="admin-role-choice-copy"><strong>Sin acceso</strong><span>La cuenta se crea sin permiso para entrar a ABIS.</span></span>
                <span class="admin-role-choice-check"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
              </label>
            </div>
          </div>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px;">
          <div>
            <label for="nuevo-password" style="display: block; color: #1e293b; font-weight: 700; font-size: 0.92rem; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.05em;">Contraseña Inicial</label>
            <div class="password-wrapper" style="position:relative; width:100%;">
  <input type="password" id="nuevo-password" minlength="6" autocomplete="new-password" required style="width: 100%; border: 2px solid var(--border-subtle); padding: 12px; border-radius: 8px; font-size: 1rem; color: var(--text-primary); outline: none; box-sizing: border-box; transition: border-color 0.2s; padding-right: 48px !important;" onfocus="this.style.borderColor='var(--text-primary)'" onblur="this.style.borderColor='var(--border-subtle)'">
  <button type="button" class="btn-toggle-eye" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:#94A3B8; cursor:pointer; width:24px; height:24px; padding:0; display:flex; align-items:center; justify-content:center; z-index:10;" onclick="togglePasswordVisibility('nuevo-password', this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:100%;height:100%;"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
  </button>
</div>
          </div>
          <div>
            <label for="nuevo-password-confirm" style="display: block; color: #1e293b; font-weight: 700; font-size: 0.92rem; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.05em;">Confirmar Contraseña</label>
            <div class="password-wrapper" style="position:relative; width:100%;">
  <input type="password" id="nuevo-password-confirm" minlength="6" autocomplete="new-password" required style="width: 100%; border: 2px solid var(--border-subtle); padding: 12px; border-radius: 8px; font-size: 1rem; color: var(--text-primary); outline: none; box-sizing: border-box; transition: border-color 0.2s; padding-right: 48px !important;" onfocus="this.style.borderColor='var(--text-primary)'" onblur="this.style.borderColor='var(--border-subtle)'">
  <button type="button" class="btn-toggle-eye" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:#94A3B8; cursor:pointer; width:24px; height:24px; padding:0; display:flex; align-items:center; justify-content:center; z-index:10;" onclick="togglePasswordVisibility('nuevo-password-confirm', this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:100%;height:100%;"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
  </button>
</div>
          </div>
        </div>
        <p id="nuevo-usuario-feedback" aria-live="polite" style="margin: 12px 0 0 0; font-size: 0.92rem; font-weight: 600;"></p>
        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-subtle);">
          <button type="submit" style="background: var(--pdi-gold, #ffd100); color: #001733; border: 1px solid #e5b900; padding: 11px 22px; border-radius: 8px; font-weight: 800; font-size: 0.95rem; cursor: pointer; box-shadow: 0 4px 14px rgba(255, 209, 0, 0.35); display: flex; align-items: center; gap: 8px; text-transform: uppercase; letter-spacing: 0.05em; transition: all 0.2s;" onmouseover="this.style.background='#ffe04d'; this.style.transform='translateY(-1px)'; this.style.boxShadow='0 6px 16px rgba(255,209,0,0.45)'" onmouseout="this.style.background='var(--pdi-gold, #ffd100)'; this.style.transform='none'; this.style.boxShadow='0 4px 14px rgba(255,209,0,0.35)'">
            <i class="fa-solid fa-user-plus"></i> Añadir
          </button>
        </div>
      </form>
    </div>

    <!-- Lista de Usuarios -->
    <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
      <div style="background: linear-gradient(135deg, rgba(0, 48, 105, 0.95) 0%, rgba(0, 80, 160, 0.85) 100%); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); padding: 16px 24px; border-bottom: 3.5px solid rgba(255, 209, 0, 0.95); color: #ffffff; box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; justify-content: space-between; font-weight: 600; font-size: 1.07rem;">
        <div style="box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; gap: 10px;">
          <i class="fa-solid fa-users" style="color: var(--pdi-gold);"></i> Registro Activo
        </div>
        <span style="background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); padding: 4px 10px; border-radius: 20px; font-size: 0.85rem; font-weight: 700;">
          <%= typeof dbUsers !== 'undefined' ? dbUsers.length : 0 %> Registros
        </span>
      </div>

      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 1rem; min-width: 760px;">
          <thead>
            <tr style="background: var(--bg-surface-subtle); border-bottom: 2px solid var(--border-subtle);">
              <th style="padding: 16px 24px; font-weight: 700; color: #475569; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.05em;">Usuario</th>
              <th style="padding: 16px 24px; font-weight: 700; color: #475569; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.05em;">Rol ABIS</th>
              <th style="padding: 16px 24px; font-weight: 700; color: #475569; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.05em;">Estado</th>
              <th style="padding: 16px 24px; font-weight: 700; color: #475569; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.05em;">Último acceso</th>
              <th style="padding: 16px 24px; font-weight: 700; color: #475569; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.05em; text-align: right;">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof dbUsers !== 'undefined' && dbUsers.length > 0) { %>
              <% dbUsers.forEach(u => { %>
                <tr style="border-bottom: 1px solid var(--bg-surface-hover); transition: background 0.1s;" onmouseover="this.style.background='var(--bg-surface-subtle)'" onmouseout="this.style.background='transparent'">
                  <td style="padding: 16px 24px; font-weight: 700; color: var(--text-primary);">
                    <i class="fa-solid <%= u.rol === 'admin' ? 'fa-user-shield admin-user-icon-admin' : 'fa-user admin-user-icon-operador' %>" style="margin-right: 12px;"></i>
                    <%= u.username %>
                  </td>
                  <td style="padding: 16px 24px;" id="td-rol-<%= u.id %>">
                    <span class="<%= u.rol === 'admin' ? 'admin-role-badge-admin' : 'admin-role-badge-operador' %>" style="padding: 4px 10px; border-radius: 20px; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">
                      <%= u.rol === 'operador' ? 'Operador' : (u.rol === 'admin' ? 'Admin' : 'Sin acceso') %>
                    </span>
                  </td>
                  <td style="padding: 16px 24px;">
                    <span style="display: inline-flex; align-items: center; gap: 6px; color: #059669; font-weight: 700; font-size: 0.92rem; background: #ecfdf5; padding: 4px 10px; border-radius: 20px; border: 1px solid #a7f3d0;">
                      <span style="width: 6px; height: 6px; background: #10B981; border-radius: 50%; box-shadow: 0 0 4px #10B981;"></span> Activo
                    </span>
                  </td>
                  <td style="padding: 16px 24px; color: var(--text-muted); font-size: 0.92rem;">
                    <%= u.ultimo_ingreso ? new Date(u.ultimo_ingreso).toLocaleString('es-CL') : 'Nunca' %>
                  </td>
                  <td style="padding: 16px 24px; text-align: right;">
                    <div style="display: flex; justify-content: flex-end; gap: 8px;">
                      <button type="button" data-id="<%= u.id %>" data-role="<%= u.rol %>" onclick="openRoleModal(this.dataset.id, this.dataset.role)" style="background: var(--bg-surface-hover); color: var(--text-primary); border: 1px solid var(--border-subtle); padding: 8px 12px; border-radius: 6px; font-weight: 700; font-size: 0.85rem; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s;" onmouseover="this.style.background='var(--border-subtle)'" onmouseout="this.style.background='var(--bg-surface-hover)'">
                        <i class="fa-solid fa-pen" style="color: var(--text-muted);"></i> Rol
                      </button>
                      <button type="button" data-id="<%= u.id %>" data-username="<%= u.username %>" onclick="openPasswordModal(this.dataset.id, this)" style="background: #ecfdf5; color: #166534; border: 1px solid #bbf7d0; padding: 8px 12px; border-radius: 6px; font-weight: 700; font-size: 0.85rem; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s;" onmouseover="this.style.background='#dcfce7'" onmouseout="this.style.background='#ecfdf5'">
                        <i class="fa-solid fa-key" style="color: #16a34a;"></i> Clave
                      </button>
                      <button type="button" data-id="<%= u.id %>" data-username="<%= u.username %>" onclick="eliminarUsuarioAdmin(this.dataset.id, this)" style="background: #fff1f2; color: #be123c; border: 1px solid #fecdd3; padding: 8px 12px; border-radius: 6px; font-weight: 700; font-size: 0.85rem; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s;" onmouseover="this.style.background='#ffe4e6'" onmouseout="this.style.background='#fff1f2'" title="Eliminar usuario">
                        <i class="fa-solid fa-trash" style="color: #e11d48;"></i> Eliminar
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5" style="text-align: center; padding: 40px; color: #94a3b8; font-weight: 600;"><i class="fa-solid fa-folder-open" style="font-size: 24px; display: block; margin-bottom: 12px; color: var(--border-medium);"></i> No hay usuarios registrados</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modals de Acción (Ocultos por defecto) -->
    <style>
      .admin-user-icon-admin { color: #0284c7; }
      .admin-user-icon-operador { color: #94a3b8; }
      .admin-role-badge-admin {
        background: #eff6ff;
        color: #1e40af;
        border: 1px solid #bfdbfe;
      }
      .admin-role-badge-operador {
        background: var(--bg-surface-hover);
        color: #475569;
        border: 1px solid var(--border-subtle);
      }

      @keyframes adminModalBackdropIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes adminModalCardIn {
        from { opacity: 0; transform: translateY(24px) scale(0.92); }
        70% { transform: translateY(-3px) scale(1.01); }
        to { opacity: 1; transform: translateY(0) scale(1); }
      }

      @keyframes adminModalCardOut {
        from { opacity: 1; transform: translateY(0) scale(1); }
        to { opacity: 0; transform: translateY(16px) scale(0.94); }
      }

      #admin-action-modal.admin-modal-opening {
        animation: adminModalBackdropIn 260ms ease-out both !important;
      }

      #admin-action-modal.admin-modal-opening > div {
        animation: adminModalCardIn 360ms cubic-bezier(.2,.8,.2,1) both !important;
      }

      #admin-action-modal.admin-modal-closing {
        animation: adminModalBackdropIn 180ms ease-in reverse both !important;
      }

      #admin-action-modal.admin-modal-closing > div {
        animation: adminModalCardOut 180ms ease-in both !important;
      }

      #admin-action-modal { padding: 18px; background: radial-gradient(ellipse at 50% 25%, rgba(18,47,82,.72), rgba(2,10,23,.84)) !important; backdrop-filter: blur(14px) saturate(135%) !important; overflow-y: auto; }
      #admin-action-modal > .admin-modal-card { --modal-accent: #ffd100; position: relative; width: min(100%, 560px) !important; max-height: min(92vh, 760px); overflow: auto !important; border: 1px solid rgba(255,255,255,.18); border-radius: 26px !important; background: linear-gradient(145deg, #fff 0%, #f4f7fb 100%) !important; box-shadow: 0 34px 100px rgba(0,0,0,.48), 0 0 0 1px rgba(255,255,255,.2) inset; color: #0f172a; }
      .dark #admin-action-modal > .admin-modal-card { background: linear-gradient(145deg,#13233a,#091525) !important; border-color: rgba(148,163,184,.25); color: #e2e8f0; }
      #admin-action-modal[data-mode="role"] > .admin-modal-card { --modal-accent: #ffd100; }
      #admin-action-modal[data-mode="password"] > .admin-modal-card { --modal-accent: #f59e0b; }
      #admin-action-modal[data-mode="delete"] > .admin-modal-card { --modal-accent: #f43f5e; }
      #admin-action-modal > .admin-modal-card:before { content: ""; position: absolute; z-index: 0; inset: 0 0 auto; height: 170px; pointer-events: none; background: radial-gradient(ellipse at 12% 0%, color-mix(in srgb, var(--modal-accent) 24%, transparent), transparent 70%); }
      .admin-modal-header { position: relative; z-index: 1; padding: 24px 28px !important; border-bottom: 1px solid rgba(148,163,184,.22) !important; background: linear-gradient(120deg, rgba(255,255,255,.82), rgba(255,255,255,.28)); }
      .dark .admin-modal-header { background: linear-gradient(120deg,rgba(30,48,72,.88),rgba(12,25,43,.45)); }
      .admin-modal-heading { display: flex; align-items: center; gap: 16px; }
      .admin-modal-kicker { display: block; margin-bottom: 5px; color: #64748b; font-size: 9px; font-weight: 900; letter-spacing: .18em; }
      .dark .admin-modal-kicker { color: #94a3b8; }
      .admin-modal-emblem { display: grid; place-items: center; width: 54px; height: 54px; flex: 0 0 54px; border: 1px solid color-mix(in srgb, var(--modal-accent) 48%, white); border-radius: 18px; background: color-mix(in srgb, var(--modal-accent) 16%, white); color: #17345b; box-shadow: 0 10px 24px color-mix(in srgb, var(--modal-accent) 16%, transparent), inset 0 1px rgba(255,255,255,.7); }
      .admin-modal-emblem i { font-size: 21px; }
      #admin-modal-title { font-size: 21px !important; letter-spacing: -.035em; }
      #admin-modal-subtitle { margin-top: 4px !important; line-height: 1.5; }
      .admin-modal-close { background: rgba(255,255,255,.72) !important; border: 1px solid rgba(148,163,184,.2) !important; }
      .admin-modal-close:hover { transform: rotate(90deg); }
      .admin-modal-body { position: relative; z-index: 1; padding: 25px 28px !important; }
      .admin-modal-form { display: flex; flex-direction: column; gap: 17px; }
      .admin-modal-form[hidden] { display: none !important; }
      .admin-modal-form > div { margin-bottom: 0 !important; }
      .admin-modal-form label { color: #334155 !important; font-size: .75rem !important; letter-spacing: .09em !important; }
      .dark .admin-modal-form label { color: #cbd5e1 !important; }
      .admin-modal-form input, .admin-modal-form select { border: 1px solid #cbd5e1 !important; border-radius: 13px !important; background: rgba(255,255,255,.84) !important; box-shadow: 0 2px 7px rgba(15,23,42,.035); }
      .dark .admin-modal-form input, .dark .admin-modal-form select { border-color: #334155 !important; background: rgba(2,10,23,.58) !important; color: #f1f5f9 !important; }
      .admin-modal-form input:focus, .admin-modal-form select:focus { border-color: var(--modal-accent) !important; box-shadow: 0 0 0 4px color-mix(in srgb, var(--modal-accent) 20%, transparent) !important; }
      .admin-role-choices { display: grid; gap: 10px; }
      .admin-role-choice { position: relative; display: flex !important; align-items: center; gap: 14px; padding: 14px 16px; border: 1px solid #dbe3ed; border-radius: 15px; background: rgba(255,255,255,.72); cursor: pointer; transition: transform .16s ease, border-color .16s ease, background .16s ease, box-shadow .16s ease; }
      .dark .admin-role-choice { border-color: #334155; background: rgba(15,23,42,.55); }
      .admin-role-choice:hover { transform: translateY(-1px); border-color: #94a3b8; box-shadow: 0 8px 22px rgba(15,23,42,.07); }
      .admin-role-choice:has(input:checked) { border-color: #d29c00; background: linear-gradient(110deg,rgba(255,209,0,.17),rgba(255,255,255,.8)); box-shadow: 0 0 0 3px rgba(255,209,0,.14),0 9px 24px rgba(15,23,42,.06); }
      .dark .admin-role-choice:has(input:checked) { background: linear-gradient(110deg,rgba(255,209,0,.15),rgba(15,23,42,.8)); }
      .admin-role-choice:has(input:focus-visible) { outline: 3px solid rgba(14,116,199,.42); outline-offset: 3px; }
      .admin-role-choice input[type="radio"] { position: absolute; opacity: 0; width: 1px; height: 1px; }
      .admin-role-choice-icon { display: grid; place-items: center; width: 42px; height: 42px; flex: 0 0 42px; border-radius: 13px; background: #eaf2fb; color: #174b7d; font-size: 16px; }
      .admin-role-choice[data-role="ninguno"] .admin-role-choice-icon { background: #fff1f2; color: #be123c; }
      .dark .admin-role-choice-icon { background: #1e3a5f; color: #bfdbfe; }
      .dark .admin-role-choice[data-role="ninguno"] .admin-role-choice-icon { background: #4c1d2b; color: #fda4af; }
      .admin-role-choice-copy { flex: 1; min-width: 0; }
      .admin-role-choice-copy strong { display: block; color: #0f172a; font-size: 14px; font-weight: 850; letter-spacing: -.01em; }
      .admin-role-choice-copy span { display: block; margin-top: 3px; color: #64748b; font-size: 12px; font-weight: 550; line-height: 1.45; }
      .dark .admin-role-choice-copy strong { color: #f1f5f9; }
      .dark .admin-role-choice-copy span { color: #94a3b8; }
      .admin-role-choice-check { display: grid; place-items: center; width: 21px; height: 21px; flex: 0 0 21px; border: 1.5px solid #cbd5e1; border-radius: 50%; color: transparent; font-size: 10px; }
      .admin-role-choice:has(input:checked) .admin-role-choice-check { border-color: #b88600; background: #ffd100; color: #17263a; }
      .admin-modal-form .password-wrapper { margin-top: 8px; }
      .admin-modal-note { padding: 13px 15px !important; border-radius: 14px !important; border: 1px solid color-mix(in srgb, var(--modal-accent) 28%, white) !important; border-left: 3px solid var(--modal-accent) !important; background: color-mix(in srgb, var(--modal-accent) 9%, white) !important; color: #475569 !important; }
      .admin-modal-actions { display: flex; justify-content: flex-end; gap: 10px !important; margin-top: 3px; padding-top: 18px; border-top: 1px solid rgba(148,163,184,.2); }
      .admin-modal-actions button { min-height: 44px; padding: 0 17px !important; border-radius: 12px !important; transition: transform .18s ease, box-shadow .18s ease, filter .18s ease; }
      .admin-modal-actions button:hover { transform: translateY(-2px); filter: brightness(1.035); }
      .admin-modal-actions button:active { transform: scale(.98); }
      .admin-modal-cancel { border: 1px solid #dbe2ec !important; background: rgba(255,255,255,.75) !important; color: #475569 !important; }
      .admin-modal-primary { border: 1px solid #12345a !important; background: linear-gradient(135deg,#12345a,#07508a) !important; color: #fff !important; box-shadow: 0 8px 18px rgba(18,52,90,.2); }
      .admin-modal-primary--gold { border-color: #d29c00 !important; background: linear-gradient(135deg,#ffe36e,#ffd100) !important; color: #17263a !important; box-shadow: 0 8px 18px rgba(234,179,8,.22); }
      .admin-modal-primary--danger { border-color: #be123c !important; background: linear-gradient(135deg,#fb7185,#e11d48) !important; color: #fff !important; box-shadow: 0 8px 18px rgba(225,29,72,.2); }
      @media(max-width:560px) { #admin-action-modal { padding: 12px; align-items: flex-end !important; } #admin-action-modal > .admin-modal-card { max-height: 92vh; border-radius: 23px !important; } .admin-modal-header { padding: 20px !important; } .admin-modal-body { padding: 20px !important; } .admin-modal-emblem { width: 46px; height: 46px; flex-basis: 46px; border-radius: 15px; } #admin-modal-title { font-size: 18px !important; } .admin-modal-actions { flex-direction: column-reverse; } .admin-modal-actions button { width: 100%; justify-content: center; } }
      @media(prefers-reduced-motion: reduce) { #admin-action-modal.admin-modal-opening, #admin-action-modal.admin-modal-opening > div, #admin-action-modal.admin-modal-closing, #admin-action-modal.admin-modal-closing > div { animation: none !important; } }
    </style>
    <div id="admin-action-modal" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="admin-modal-title" style="position: fixed; inset: 0; z-index: 100; display: none; align-items: center; justify-content: center; opacity: 0;">
      <div class="admin-modal-card" style="width: 100%; max-width: 480px; overflow: hidden;">
        <div class="admin-modal-header" style="display: flex; justify-content: space-between; align-items: center;">
          <div class="admin-modal-heading">
            <div class="admin-modal-emblem"><i id="admin-modal-icon" class="fa-solid fa-shield-halved" aria-hidden="true"></i></div>
            <div>
              <span class="admin-modal-kicker">ABIS · CONTROL DE ACCESO</span>
            <h2 id="admin-modal-title" style="margin: 0 0 4px 0; font-size: 20px; font-weight: 800; color: var(--text-primary);">Administrar</h2>
            <p id="admin-modal-subtitle" style="margin: 0; color: var(--text-muted); font-size: 0.92rem;"></p>
            </div>
          </div>
          <button type="button" class="admin-modal-close" onclick="closeAdminModal()" aria-label="Cerrar" style="color: #64748b; font-size: 22px; cursor: pointer; padding: 4px; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">&times;</button>
        </div>

        <div class="admin-modal-body" style="padding: 32px;">
          <!-- Form Role -->
          <form id="form-editar-rol" class="admin-modal-form" hidden>
            <div style="margin-bottom: 24px;">
              <label style="display: block; color: #1e293b; font-weight: 700; font-size: 0.75rem; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.09em;">Elige el nivel de acceso de ABIS</label>
              <input type="hidden" id="editar-rol" value="operador">
              <div class="admin-role-choices" role="radiogroup" aria-label="Rol de acceso en ABIS">
                <label class="admin-role-choice" data-role="admin">
                  <input type="radio" name="editar-rol-opcion" value="admin">
                  <span class="admin-role-choice-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
                  <span class="admin-role-choice-copy"><strong>Administrador</strong><span>Gestiona usuarios, permisos y configuración de ABIS.</span></span>
                  <span class="admin-role-choice-check"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                </label>
                <label class="admin-role-choice" data-role="operador">
                  <input type="radio" name="editar-rol-opcion" value="operador">
                  <span class="admin-role-choice-icon"><i class="fa-solid fa-user-gear" aria-hidden="true"></i></span>
                  <span class="admin-role-choice-copy"><strong>Operador</strong><span>Usa las herramientas de trabajo de ABIS sin administrar cuentas.</span></span>
                  <span class="admin-role-choice-check"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                </label>
                <label class="admin-role-choice" data-role="ninguno">
                  <input type="radio" name="editar-rol-opcion" value="ninguno">
                  <span class="admin-role-choice-icon"><i class="fa-solid fa-user-lock" aria-hidden="true"></i></span>
                  <span class="admin-role-choice-copy"><strong>Sin acceso</strong><span>La cuenta se conserva, pero no puede entrar a ABIS.</span></span>
                  <span class="admin-role-choice-check"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                </label>
              </div>
            </div>
            <p id="editar-rol-feedback" style="margin: 0 0 16px 0; font-size: 0.92rem; font-weight: 600;"></p>
            <div class="admin-modal-actions" style="display: flex; justify-content: flex-end; gap: 12px;">
              <button type="button" class="admin-modal-cancel" onclick="closeAdminModal()" style="font-weight: 700; font-size: 0.92rem; cursor: pointer;">Cancelar</button>
              <button type="submit" class="admin-modal-primary" style="font-weight: 700; font-size: 0.92rem; cursor: pointer;"><i class="fa-solid fa-check"></i> Aceptar cambio</button>
            </div>
          </form>

          <!-- Form Password -->
          <form id="form-cambiar-password-admin" class="admin-modal-form" hidden novalidate>
            <div style="margin-bottom: 16px;">
              <label for="admin-nueva-password" style="display: block; color: #1e293b; font-weight: 700; font-size: 0.92rem; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">Nueva Contraseña Fuerte</label>
              <div class="password-wrapper" style="position:relative; width:100%;">
  <input type="password" id="admin-nueva-password" minlength="6" autocomplete="new-password" required style="width: 100%; border: 2px solid var(--border-subtle); padding: 12px; border-radius: 8px; font-size: 1rem; color: var(--text-primary); outline: none; box-sizing: border-box; transition: border-color 0.2s; padding-right: 48px !important;" onfocus="this.style.borderColor='#DC2626'" onblur="this.style.borderColor='var(--border-subtle)'">
  <button type="button" class="btn-toggle-eye" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:#94A3B8; cursor:pointer; width:24px; height:24px; padding:0; display:flex; align-items:center; justify-content:center; z-index:10;" onclick="togglePasswordVisibility('admin-nueva-password', this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:100%;height:100%;"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
  </button>
</div>
            </div>
            <div style="margin-bottom: 24px;">
              <label for="admin-confirmar-password" style="display: block; color: #1e293b; font-weight: 700; font-size: 0.92rem; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">Repetir Contraseña</label>
              <div class="password-wrapper" style="position:relative; width:100%;">
  <input type="password" id="admin-confirmar-password" minlength="6" autocomplete="new-password" required style="width: 100%; border: 2px solid var(--border-subtle); padding: 12px; border-radius: 8px; font-size: 1rem; color: var(--text-primary); outline: none; box-sizing: border-box; transition: border-color 0.2s; padding-right: 48px !important;" onfocus="this.style.borderColor='#DC2626'" onblur="this.style.borderColor='var(--border-subtle)'">
  <button type="button" class="btn-toggle-eye" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:#94A3B8; cursor:pointer; width:24px; height:24px; padding:0; display:flex; align-items:center; justify-content:center; z-index:10;" onclick="togglePasswordVisibility('admin-confirmar-password', this)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:100%;height:100%;"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
  </button>
</div>
            </div>
            <p id="admin-password-feedback" style="margin: 0 0 16px 0; font-size: 0.92rem; font-weight: 600;"></p>
            <div class="admin-modal-actions" style="display: flex; justify-content: flex-end; gap: 12px;">
              <button type="button" class="admin-modal-cancel" onclick="closeAdminModal()" style="font-weight: 700; font-size: 0.92rem; cursor: pointer;">Cancelar</button>
              <button type="submit" class="admin-modal-primary admin-modal-primary--gold" style="font-weight: 700; font-size: 0.92rem; cursor: pointer;"><i class="fa-solid fa-key"></i> Guardar nueva clave</button>
            </div>
          </form>

          <!-- Form de validación para eliminar usuario -->
          <form id="form-eliminar-usuario-admin" class="admin-modal-form" hidden novalidate>
            <div class="admin-modal-note" style="font-size: 0.92rem; line-height: 1.55;">
              <strong>Acción sensible.</strong> Vas a eliminar definitivamente a <strong id="admin-delete-username"></strong>. Introduce tu contraseña para validar esta acción.
            </div>
            <div style="margin-bottom: 24px;">
              <label for="admin-delete-password" style="display: block; color: #1e293b; font-weight: 700; font-size: 0.92rem; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">Tu contraseña</label>
              <div class="password-wrapper" style="position:relative; width:100%;">
                <input type="password" id="admin-delete-password" minlength="1" autocomplete="current-password" required style="width: 100%; border: 2px solid var(--border-subtle); padding: 12px; border-radius: 8px; font-size: 1rem; color: var(--text-primary); outline: none; box-sizing: border-box; transition: border-color 0.2s; padding-right: 48px !important;" onfocus="this.style.borderColor='#f97316'" onblur="this.style.borderColor='var(--border-subtle)'">
                <button type="button" class="btn-toggle-eye" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:#94A3B8; cursor:pointer; width:24px; height:24px; padding:0; display:flex; align-items:center; justify-content:center; z-index:10;" onclick="togglePasswordVisibility('admin-delete-password', this)">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:100%;height:100%;"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                </button>
              </div>
            </div>
            <p id="admin-delete-feedback" style="margin: 0 0 16px 0; font-size: 0.92rem; font-weight: 600;"></p>
            <div class="admin-modal-actions" style="display: flex; justify-content: flex-end; gap: 12px;">
              <button type="button" class="admin-modal-cancel" onclick="closeAdminModal()" style="font-weight: 700; font-size: 0.92rem; cursor: pointer;">Cancelar</button>
              <button type="submit" class="admin-modal-primary admin-modal-primary--danger" style="font-weight: 700; font-size: 0.92rem; cursor: pointer;"><i class="fa-solid fa-trash-can"></i> Confirmar eliminación</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script>
      let currentAdminTargetId = null;
      let currentAdminTargetUsername = '';

      const modalEl = document.getElementById('admin-action-modal');
      const formRole = document.getElementById('form-editar-rol');
      const formPwd = document.getElementById('form-cambiar-password-admin');
      const formDelete = document.getElementById('form-eliminar-usuario-admin');
      const modalTitle = document.getElementById('admin-modal-title');
      const modalSubtitle = document.getElementById('admin-modal-subtitle');
      const modalIcon = document.getElementById('admin-modal-icon');

      function setFeedback(elementId, message, type) {
        const el = document.getElementById(elementId);
        if (!el) return;
        el.textContent = message;
        if (type === 'error') {
          el.style.color = '#dc2626';
          el.style.background = '#fef2f2';
          el.style.padding = '8px 12px';
          el.style.borderRadius = '6px';
          el.style.border = '1px solid #fecaca';
        } else if (type === 'success') {
          el.style.color = '#059669';
          el.style.background = '#ecfdf5';
          el.style.padding = '8px 12px';
          el.style.borderRadius = '6px';
          el.style.border = '1px solid #a7f3d0';
        } else {
          el.style.padding = '0';
          el.style.border = 'none';
          el.style.background = 'transparent';
        }
      }

      function openModal() {
        modalEl.classList.remove('admin-modal-closing');
        modalEl.classList.add('admin-modal-opening');
        modalEl.setAttribute('aria-hidden', 'false');
        modalEl.style.display = 'flex';
        modalEl.style.opacity = '1';
        document.body.style.overflow = 'hidden';
        void modalEl.offsetWidth;
      }

      window.closeAdminModal = function() {
        modalEl.classList.remove('admin-modal-opening');
        modalEl.classList.add('admin-modal-closing');
        setTimeout(() => {
          modalEl.style.display = 'none';
          modalEl.style.opacity = '0';
          modalEl.classList.remove('admin-modal-closing');
          modalEl.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
          formRole.hidden = true;
          formPwd.hidden = true;
          formDelete.hidden = true;
          formRole.reset();
          formPwd.reset();
          formDelete.reset();
          setFeedback('editar-rol-feedback', '', '');
          setFeedback('admin-password-feedback', '', '');
          setFeedback('admin-delete-feedback', '', '');
        }, 200);
      };

      window.openRoleModal = function(id, currentRole) {
        currentAdminTargetId = id;
        modalEl.dataset.mode = 'role';
        modalIcon.className = 'fa-solid fa-shield-halved';
        const roleSelect = document.getElementById('editar-rol');
        const roleRadios = document.querySelectorAll('input[name="editar-rol-opcion"]');
        const normalizedRole = ["admin", "operador", "ninguno"].includes(currentRole) ? currentRole : "operador";
        roleSelect.value = normalizedRole;
        roleRadios.forEach((radio) => { radio.checked = radio.value === normalizedRole; });
        modalTitle.textContent = 'Editar Nivel de Acceso';
        modalSubtitle.textContent = 'Asigna privilegios de sistema a este usuario.';
        formRole.hidden = false;
        openModal();
      };

      document.querySelectorAll('input[name="editar-rol-opcion"]').forEach((radio) => {
        radio.addEventListener('change', () => {
          if (radio.checked) document.getElementById('editar-rol').value = radio.value;
        });
      });

      window.openPasswordModal = function(id, btn) {
        currentAdminTargetId = id;
        modalEl.dataset.mode = 'password';
        modalIcon.className = 'fa-solid fa-key';
        const username = btn.getAttribute('data-username');
        formPwd.reset();
        modalTitle.textContent = 'Restablecer Credenciales';
        modalSubtitle.textContent = `Cambio forzado para: ${username}`;
        formPwd.hidden = false;
        openModal();
      };

      window.openDeleteModal = function(id, btn) {
        currentAdminTargetId = id;
        modalEl.dataset.mode = 'delete';
        modalIcon.className = 'fa-solid fa-user-slash';
        currentAdminTargetUsername = btn.getAttribute('data-username') || '';
        document.getElementById('admin-delete-username').textContent = currentAdminTargetUsername;
        document.getElementById('admin-delete-password').value = '';
        modalTitle.textContent = 'Validar eliminación';
        modalSubtitle.textContent = 'Se requiere tu contraseña para confirmar esta acción.';
        formDelete.hidden = false;
        openModal();
        setTimeout(() => document.getElementById('admin-delete-password')?.focus(), 200);
      };

      modalEl.addEventListener('click', (event) => {
        if (event.target === modalEl) window.closeAdminModal();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && modalEl.style.display !== 'none') window.closeAdminModal();
      });

      // El formulario de alta se muestra únicamente dentro de un popup.
      const formNuevo = document.getElementById('form-nuevo-usuario');
      document.querySelectorAll('input[name="nuevo-rol-opcion"]').forEach((radio) => {
        radio.addEventListener('change', () => {
          if (radio.checked) document.getElementById('nuevo-rol').value = radio.value;
        });
      });
      const newUserModal = document.createElement('div');
      newUserModal.id = 'new-user-modal';
      newUserModal.className = 'settings-modal new-user-modal';
      newUserModal.hidden = true;
      newUserModal.setAttribute('aria-hidden', 'true');
      newUserModal.innerHTML = `
        <div class="settings-modal-card" role="dialog" aria-modal="true" aria-labelledby="new-user-title">
          <div class="settings-modal-header">
            <h2 id="new-user-title"><i class="fa-solid fa-user-plus" style="color: var(--pdi-gold);"></i> Añadir usuario</h2>
            <button type="button" class="settings-close-btn" id="close-new-user-modal" aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
          </div>
        </div>`;
      document.body.appendChild(newUserModal);
      const newUserCard = newUserModal.querySelector('.settings-modal-card');
      const newUserHeader = newUserModal.querySelector('.settings-modal-header');
      const newUserActions = formNuevo.querySelector('button[type="submit"]')?.parentElement;
      const cancelNewUser = document.createElement('button');
      cancelNewUser.type = 'button';
      cancelNewUser.className = 'new-user-cancel';
      cancelNewUser.textContent = 'Cancelar';
      newUserActions?.insertBefore(cancelNewUser, newUserActions.querySelector('button[type="submit"]'));
      formNuevo.style.padding = '32px';
      formNuevo.parentElement?.removeChild(formNuevo);
      newUserCard.appendChild(formNuevo);

      const closeNewUserModal = () => {
        formNuevo.reset();
        setFeedback('nuevo-usuario-feedback', '', '');
        newUserModal.hidden = true;
        newUserModal.setAttribute('aria-hidden', 'true');
      };
      const openNewUserModal = () => {
        formNuevo.reset();
        setFeedback('nuevo-usuario-feedback', '', '');
        newUserModal.hidden = false;
        newUserModal.setAttribute('aria-hidden', 'false');
        document.getElementById('nuevo-usuario')?.focus();
      };
      window.openNewUserModal = openNewUserModal;
      window.closeNewUserModal = closeNewUserModal;
      document.getElementById('open-new-user-modal')?.addEventListener('click', openNewUserModal);
      document.getElementById('close-new-user-modal')?.addEventListener('click', closeNewUserModal);
      cancelNewUser.addEventListener('click', closeNewUserModal);
      newUserModal.addEventListener('click', (event) => {
        if (event.target === newUserModal) closeNewUserModal();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !newUserModal.hidden) closeNewUserModal();
      });

      // Handlers
      formNuevo?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const username = document.getElementById('nuevo-usuario').value;
        const rol = document.getElementById('nuevo-rol').value;
        const pass = document.getElementById('nuevo-password').value;
        const conf = document.getElementById('nuevo-password-confirm').value;
        const btn = formNuevo.querySelector('button[type="submit"]');

        if (pass.length < 6) return setFeedback('nuevo-usuario-feedback', 'La contraseña debe tener 6 caracteres mínimo.', 'error');
        if (pass !== conf) return setFeedback('nuevo-usuario-feedback', 'Las contraseñas no coinciden.', 'error');

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Registrando...';
        setFeedback('nuevo-usuario-feedback', '', '');

        try {
          const res = await fetch('/api/admin/create-user', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password: pass, rol })
          });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || 'Error al crear usuario.');
          
          setFeedback('nuevo-usuario-feedback', 'Usuario creado exitosamente. Recargando...', 'success');
          setTimeout(() => window.location.reload(), 1500);
        } catch (err) {
          setFeedback('nuevo-usuario-feedback', err.message, 'error');
          btn.disabled = false;
          btn.innerHTML = '<i class="fa-solid fa-user-plus"></i> Añadir';
        }
      });

      formRole?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const rol = document.getElementById('editar-rol').value;
        const btn = formRole.querySelector('button[type="submit"]');

        btn.disabled = true;
        setFeedback('editar-rol-feedback', 'Guardando...', '');

        try {
          const res = await fetch('/api/admin/update-role', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: currentAdminTargetId, rol_abis: rol })
          });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || 'Error al actualizar.');
          
          setFeedback('editar-rol-feedback', 'Actualizado. Recargando...', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } catch (err) {
          setFeedback('editar-rol-feedback', err.message, 'error');
          btn.disabled = false;
        }
      });

      formPwd?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const pass = document.getElementById('admin-nueva-password').value;
        const conf = document.getElementById('admin-confirmar-password').value;
        const btn = formPwd.querySelector('button[type="submit"]');

        if (pass.length < 6) return setFeedback('admin-password-feedback', 'La contraseña debe tener 6 caracteres mínimo.', 'error');
        if (pass !== conf) return setFeedback('admin-password-feedback', 'Las contraseñas no coinciden.', 'error');

        btn.disabled = true;
        btn.innerHTML = 'Procesando...';
        setFeedback('admin-password-feedback', '', '');

        try {
          const res = await fetch('/api/admin/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: currentAdminTargetId, password: pass })
          });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || 'Error al restablecer.');
          
          setFeedback('admin-password-feedback', 'Clave restablecida correctamente.', 'success');
          setTimeout(() => closeAdminModal(), 2000);
        } catch (err) {
          setFeedback('admin-password-feedback', err.message, 'error');
        } finally {
          btn.disabled = false;
          btn.innerHTML = 'Forzar Cambio';
        }
      });

      window.eliminarUsuarioAdmin = function(id, button) {
        openDeleteModal(id, button);
      };

      formDelete?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const password = document.getElementById('admin-delete-password').value;
        const btn = formDelete.querySelector('button[type="submit"]');
        if (!password) return setFeedback('admin-delete-feedback', 'Introduce tu contraseña para continuar.', 'error');

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Validando...';
        setFeedback('admin-delete-feedback', 'Validando contraseña...', '');

        try {
          const res = await fetch(`/api/admin/users/${encodeURIComponent(currentAdminTargetId)}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ password })
          });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || 'No se pudo eliminar el usuario.');

          setFeedback('admin-delete-feedback', 'Usuario eliminado. Recargando...', 'success');
          setTimeout(() => window.location.reload(), 700);
        } catch (err) {
          setFeedback('admin-delete-feedback', err.message, 'error');
          btn.disabled = false;
          btn.innerHTML = '<i class="fa-solid fa-trash"></i> Validar y eliminar';
        }
      });
    </script>
  <% } else { %>
    <div style="background: #fff1f2; border: 1px solid #fecaca; border-left: 4px solid #e11d48; padding: 24px; border-radius: 12px; margin-top: 24px;">
      <h2 style="color: #be123c; margin: 0 0 8px 0; font-size: 18px; box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; gap: 8px;">
        <i class="fa-solid fa-lock"></i> Acceso Restringido
      </h2>
      <p style="color: #9f1239; margin: 0; font-size: 1.07rem; line-height: 1.5;">
        Esta área es exclusiva para cuentas con nivel de <strong>Administrador</strong>. Por favor, comunícate con el soporte técnico si consideras que necesitas acceso a este módulo.
      </p>
    </div>
  <% } %>
</div>



