<h1 class="ajustes-page-title">Ajustes Generales</h1>
<p class="ajustes-page-subtitle">Configura los parámetros visuales, accesibilidad y preferencias del sistema.</p>

<div class="ajustes-card">
  <div class="ajustes-card-header"><i class="fa-solid fa-universal-access"></i> Accesibilidad y Apariencia</div>
  <div class="info-row">
    <span class="info-label">Modo de visualización</span>
    <span class="info-value">
      <select id="pref-theme" style="padding: 6px 12px; border-radius: 6px; border: 1px solid #e2e8f0; color: #0f172a; font-weight: 600;">
        <option value="light">Modo Claro (Por defecto)</option>
        <option value="dark">Modo Oscuro</option>
        <option value="auto">Automático (Sistema)</option>
      </select>
    </span>
  </div>
  <div class="info-row">
    <span class="info-label">Alto Contraste</span>
    <span class="info-value">
      <label class="toggle-switch" title="Activar modo de alto contraste para mejorar legibilidad">
        <input type="checkbox" id="pref-contrast">
        <span class="toggle-slider"></span>
      </label>
    </span>
  </div>
  <div class="info-row">
    <span class="info-label">Tamaño de Fuente</span>
    <span class="info-value">
      <select id="pref-fontsize" style="padding: 6px 12px; border-radius: 6px; border: 1px solid #e2e8f0; color: #0f172a; font-weight: 600;">
        <option value="14px">Normal (14px)</option>
        <option value="16px">Grande (16px)</option>
        <option value="18px">Extra Grande (18px)</option>
      </select>
    </span>
  </div>
  <div class="info-row">
    <span class="info-label">Reducir animaciones</span>
    <span class="info-value">
      <label class="toggle-switch" title="Desactivar transiciones y animaciones">
        <input type="checkbox" id="pref-animations">
        <span class="toggle-slider"></span>
      </label>
    </span>
  </div>
</div>

<div class="ajustes-card">
  <div class="ajustes-card-header"><i class="fa-solid fa-server"></i> Información del sistema</div>
  <div class="info-row">
    <span class="info-label">Nombre del Sistema</span>
    <span class="info-value">Sistema ABIS (Analítico y de Control)</span>
  </div>
  <div class="info-row">
    <span class="info-label">Versión</span>
    <span class="info-value">v2.1.0</span>
  </div>
  <div class="info-row">
    <span class="info-label">Base de Datos</span>
    <span class="info-value">PostgreSQL (Activo)</span>
  </div>
  <div class="info-row">
    <span class="info-label">Entorno</span>
    <span class="info-value"><span style="background: #e2e8f0; padding: 2px 8px; border-radius: 4px; font-size: 12px;">Producción</span></span>
  </div>
</div>

<script>
  function loadPreferences() {
    const theme = localStorage.getItem('pref-theme') || 'light';
    const contrast = localStorage.getItem('pref-contrast') === 'true';
    const fontsize = localStorage.getItem('pref-fontsize') || '14px';
    const animations = localStorage.getItem('pref-animations') === 'true';

    document.getElementById('pref-theme').value = theme;
    document.getElementById('pref-contrast').checked = contrast;
    document.getElementById('pref-fontsize').value = fontsize;
    document.getElementById('pref-animations').checked = animations;
  }

  function savePreferences() {
    localStorage.setItem('pref-theme', document.getElementById('pref-theme').value);
    localStorage.setItem('pref-contrast', document.getElementById('pref-contrast').checked);
    localStorage.setItem('pref-fontsize', document.getElementById('pref-fontsize').value);
    localStorage.setItem('pref-animations', document.getElementById('pref-animations').checked);
    
    applyPreferences();
  }

  function applyPreferences() {
    const fontsize = localStorage.getItem('pref-fontsize') || '14px';
    document.documentElement.style.fontSize = fontsize;
    
    if (localStorage.getItem('pref-contrast') === 'true') {
      document.body.classList.add('high-contrast');
    } else {
      document.body.classList.remove('high-contrast');
    }

    if (localStorage.getItem('pref-theme') === 'dark') {
      document.body.classList.add('dark-theme');
    } else {
      document.body.classList.remove('dark-theme');
    }
  }

  document.getElementById('pref-theme').addEventListener('change', savePreferences);
  document.getElementById('pref-contrast').addEventListener('change', savePreferences);
  document.getElementById('pref-fontsize').addEventListener('change', savePreferences);
  document.getElementById('pref-animations').addEventListener('change', savePreferences);

  document.addEventListener('DOMContentLoaded', () => {
    loadPreferences();
    applyPreferences();
  });
  
  // En caso de que se navegue mediante AJAX o tabs
  loadPreferences();
  applyPreferences();
</script>
