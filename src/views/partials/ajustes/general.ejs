<div style="max-width: 1200px; margin: 0 auto; padding-bottom: 40px;">
  <div style="margin-bottom: 32px;">
    <h1 style="font-size: 28px; font-weight: 800; color: #001F44; margin: 0 0 8px 0; letter-spacing: -0.02em;">Ajustes Generales</h1>
    <p style="color: #64748b; font-size: 15px; margin: 0;">Configura los parámetros visuales, accesibilidad y preferencias del sistema.</p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); gap: 24px;">
    
    <!-- Accesibilidad y Apariencia -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); grid-column: 1 / -1;">
      <div style="background: var(--pdi-navy); border-bottom: 3.5px solid var(--pdi-gold); padding: 16px 24px; color: #ffffff; display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px;">
        <i class="fa-solid fa-universal-access" style="color: #60a5fa;"></i> Accesibilidad y Apariencia
      </div>
      
      <div style="padding: 0;">
        <div style="padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0;">
          <div>
            <div style="font-weight: 700; color: #0f172a; font-size: 14px; margin-bottom: 4px;">Modo de visualización</div>
            <div style="color: #64748b; font-size: 13px;">Ajusta el tema global de la interfaz</div>
          </div>
          <select id="pref-theme" style="padding: 8px 12px; border-radius: 6px; border: 2px solid #e2e8f0; color: #0f172a; font-weight: 600; font-size: 13px; outline: none; cursor: pointer; transition: border-color 0.2s;" onfocus="this.style.borderColor='#001F44'" onblur="this.style.borderColor='#e2e8f0'">
            <option value="light">Modo Claro (Por defecto)</option>
            <option value="dark">Modo Oscuro</option>
            <option value="auto">Automático (Sistema)</option>
          </select>
        </div>

        <div style="padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0;">
          <div>
            <div style="font-weight: 700; color: #0f172a; font-size: 14px; margin-bottom: 4px;">Alto Contraste</div>
            <div style="color: #64748b; font-size: 13px;">Activar modo de alto contraste para mejorar legibilidad</div>
          </div>
          <label class="toggle-switch" style="cursor: pointer;">
            <input type="checkbox" id="pref-contrast">
            <span class="toggle-slider"></span>
          </label>
        </div>

        <div style="padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0;">
          <div>
            <div style="font-weight: 700; color: #0f172a; font-size: 14px; margin-bottom: 4px;">Tamaño de Fuente</div>
            <div style="color: #64748b; font-size: 13px;">Ajusta la escala de lectura de textos</div>
          </div>
          <select id="pref-fontsize" style="padding: 8px 12px; border-radius: 6px; border: 2px solid #e2e8f0; color: #0f172a; font-weight: 600; font-size: 13px; outline: none; cursor: pointer; transition: border-color 0.2s;" onfocus="this.style.borderColor='#001F44'" onblur="this.style.borderColor='#e2e8f0'">
            <option value="14px">Normal (14px)</option>
            <option value="16px">Grande (16px)</option>
            <option value="18px">Extra Grande (18px)</option>
          </select>
        </div>

        <div style="padding: 20px 24px; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <div style="font-weight: 700; color: #0f172a; font-size: 14px; margin-bottom: 4px;">Reducir animaciones</div>
            <div style="color: #64748b; font-size: 13px;">Desactivar transiciones y animaciones decorativas</div>
          </div>
          <label class="toggle-switch" style="cursor: pointer;">
            <input type="checkbox" id="pref-animations">
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>
    </div>

    <!-- Información del Sistema -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); grid-column: 1 / -1;">
      <div style="background: var(--pdi-navy); border-bottom: 3.5px solid var(--pdi-gold); padding: 16px 24px; color: #ffffff; display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px;">
        <i class="fa-solid fa-server" style="color: #60a5fa;"></i> Información Técnica
      </div>
      
      <div style="padding: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px;">
        <div>
          <div style="color: #64748b; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">Nombre del Sistema</div>
          <div style="color: #0f172a; font-weight: 600; font-size: 15px;">Sistema ABIS (Analítico y de Control)</div>
        </div>
        <div>
          <div style="color: #64748b; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">Versión Instalada</div>
          <div style="color: #0f172a; font-weight: 600; font-size: 15px;"><i class="fa-solid fa-code-branch" style="color: #0ea5e9; margin-right: 4px;"></i> v2.1.0</div>
        </div>
        <div>
          <div style="color: #64748b; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">Base de Datos</div>
          <div style="color: #0f172a; font-weight: 600; font-size: 15px;"><i class="fa-solid fa-database" style="color: #10b981; margin-right: 4px;"></i> PostgreSQL (Activo)</div>
        </div>
        <div>
          <div style="color: #64748b; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">Entorno de Ejecución</div>
          <div style="margin-top: 4px;">
            <span style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">
              Producción
            </span>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  function loadPreferences() {
    const theme = localStorage.getItem('pref-theme') || 'light';
    const contrast = localStorage.getItem('pref-contrast') === 'true';
    const fontsize = localStorage.getItem('pref-fontsize') || '14px';
    const animations = localStorage.getItem('pref-animations') === 'true';

    document.getElementById('pref-theme').value = theme;
    document.getElementById('pref-contrast').checked = contrast;
    document.getElementById('pref-fontsize').value = fontsize;
    document.getElementById('pref-animations').checked = animations;
  }

  function savePreferences() {
    localStorage.setItem('pref-theme', document.getElementById('pref-theme').value);
    localStorage.setItem('pref-contrast', document.getElementById('pref-contrast').checked);
    localStorage.setItem('pref-fontsize', document.getElementById('pref-fontsize').value);
    localStorage.setItem('pref-animations', document.getElementById('pref-animations').checked);
    
    applyPreferences();
  }

  function applyPreferences() {
    const fontsize = localStorage.getItem('pref-fontsize') || '14px';
    document.documentElement.style.fontSize = fontsize;
    
    if (localStorage.getItem('pref-contrast') === 'true') {
      document.body.classList.add('high-contrast');
    } else {
      document.body.classList.remove('high-contrast');
    }

    if (localStorage.getItem('pref-theme') === 'dark') {
      document.body.classList.add('dark-theme');
    } else {
      document.body.classList.remove('dark-theme');
    }
  }

  document.getElementById('pref-theme')?.addEventListener('change', savePreferences);
  document.getElementById('pref-contrast')?.addEventListener('change', savePreferences);
  document.getElementById('pref-fontsize')?.addEventListener('change', savePreferences);
  document.getElementById('pref-animations')?.addEventListener('change', savePreferences);

  // En caso de que se navegue mediante AJAX o tabs
  loadPreferences();
  applyPreferences();
</script>
