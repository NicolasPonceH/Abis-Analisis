<div style="width: 100%; padding-bottom: 40px;">
  <div style="margin-bottom: 32px;">
    <h1 style="font-size: 28px; font-weight: 800; color: #001F44; margin: 0 0 8px 0; letter-spacing: -0.02em;">Ajustes Generales</h1>
    <p style="color: #64748b; font-size: 15px; margin: 0;">Configura los parámetros visuales, accesibilidad y preferencias del sistema.</p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); gap: 24px;">
    
    <!-- Accesibilidad y Apariencia -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); grid-column: 1 / -1;">
      <div style="background: linear-gradient(135deg, rgba(0, 48, 105, 0.95) 0%, rgba(0, 80, 160, 0.85) 100%); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); padding: 16px 24px; border-bottom: 3.5px solid rgba(255, 209, 0, 0.95); color: #ffffff; box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px;">
        <i class="fa-solid fa-universal-access" style="color: var(--pdi-gold);"></i> Accesibilidad y Apariencia
      </div>
      
      <div style="padding: 0;">
        <div style="padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0;">
          <div>
            <div style="font-weight: 700; color: #0f172a; font-size: 14px; margin-bottom: 4px;">Acento Institucional</div>
            <div style="color: #64748b; font-size: 13px;">Personaliza el color de acento primario del sistema</div>
          </div>
          <select id="pref-accent" style="padding: 8px 12px; border-radius: 6px; border: 2px solid #e2e8f0; color: #0f172a; font-weight: 600; font-size: 13px; outline: none; cursor: pointer; transition: border-color 0.2s;" onfocus="this.style.borderColor='#001F44'" onblur="this.style.borderColor='#e2e8f0'">
            <option value="#FFD100">Dorado PDI (Oficial)</option>
            <option value="#0ea5e9">Azul Táctico</option>
            <option value="#10b981">Verde Élite</option>
            <option value="#f43f5e">Rojo Alerta</option>
          </select>
        </div>

        <div style="padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0;">
          <div>
            <div style="font-weight: 700; color: #0f172a; font-size: 14px; margin-bottom: 4px;">Estética de Cristal (Glassmorphism)</div>
            <div style="color: #64748b; font-size: 13px;">Habilita transparencias y desenfoques premium en los paneles</div>
          </div>
          <label class="toggle-switch" style="cursor: pointer;">
            <input type="checkbox" id="pref-glass">
            <span class="toggle-slider"></span>
          </label>
        </div>

        <div style="padding: 20px 24px; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <div style="font-weight: 700; color: #0f172a; font-size: 14px; margin-bottom: 4px;">Transiciones Fluidas</div>
            <div style="color: #64748b; font-size: 13px;">Activa animaciones suaves al interactuar con los elementos</div>
          </div>
          <label class="toggle-switch" style="cursor: pointer;">
            <input type="checkbox" id="pref-transitions">
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>
    </div>

    <!-- Información del Sistema -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); grid-column: 1 / -1;">
      <div style="background: linear-gradient(135deg, rgba(0, 48, 105, 0.95) 0%, rgba(0, 80, 160, 0.85) 100%); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); padding: 16px 24px; border-bottom: 3.5px solid rgba(255, 209, 0, 0.95); color: #ffffff; box-shadow: 0 4px 12px rgba(0, 15, 33, 0.1); display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 15px;">
        <i class="fa-solid fa-server" style="color: var(--pdi-gold);"></i> Información Técnica
      </div>
      
      <div style="padding: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px;">
        <div>
          <div style="color: #64748b; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">Nombre del Sistema</div>
          <div style="color: #0f172a; font-weight: 600; font-size: 15px;">Sistema ABIS (Analítico y de Control)</div>
        </div>
        <div>
          <div style="color: #64748b; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">Versión Instalada</div>
          <div style="color: #0f172a; font-weight: 600; font-size: 15px;"><i class="fa-solid fa-code-branch" style="color: #0ea5e9; margin-right: 4px;"></i> v2.1.0</div>
        </div>
        <div>
          <div style="color: #64748b; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">Base de Datos</div>
          <div style="color: #0f172a; font-weight: 600; font-size: 15px;"><i class="fa-solid fa-database" style="color: #10b981; margin-right: 4px;"></i> PostgreSQL (Activo)</div>
        </div>
        <div>
          <div style="color: #64748b; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">Entorno de Ejecución</div>
          <div style="margin-top: 4px;">
            <span style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">
              Producción
            </span>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  function loadPreferences() {
    const accent = localStorage.getItem('pref-accent') || '#FFD100';
    const glass = localStorage.getItem('pref-glass') !== 'false'; // Default true
    const transitions = localStorage.getItem('pref-transitions') !== 'false'; // Default true

    const accentEl = document.getElementById('pref-accent');
    const glassEl = document.getElementById('pref-glass');
    const transEl = document.getElementById('pref-transitions');
    
    if(accentEl) accentEl.value = accent;
    if(glassEl) glassEl.checked = glass;
    if(transEl) transEl.checked = transitions;
  }

  function savePreferences() {
    localStorage.setItem('pref-accent', document.getElementById('pref-accent').value);
    localStorage.setItem('pref-glass', document.getElementById('pref-glass').checked);
    localStorage.setItem('pref-transitions', document.getElementById('pref-transitions').checked);
    
    applyPreferences();
  }

  function applyPreferences() {
    // 1. Acento Institucional
    const accent = localStorage.getItem('pref-accent') || '#FFD100';
    document.documentElement.style.setProperty('--pdi-gold', accent);

    // 2. Estética de Cristal
    const glass = localStorage.getItem('pref-glass') !== 'false';
    if (!glass) {
      if (!document.getElementById('style-no-glass')) {
        const style = document.createElement('style');
        style.id = 'style-no-glass';
        style.innerHTML = `
          * {
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
          }
          .settings-card-header, .header-institutional {
            background: var(--pdi-navy) !important;
          }
        `;
        document.head.appendChild(style);
      }
    } else {
      const style = document.getElementById('style-no-glass');
      if (style) style.remove();
    }

    // 3. Transiciones Fluidas
    const transitions = localStorage.getItem('pref-transitions') !== 'false';
    if (!transitions) {
      if (!document.getElementById('style-no-transitions')) {
        const style = document.createElement('style');
        style.id = 'style-no-transitions';
        style.innerHTML = `
          * {
            transition: none !important;
            animation: none !important;
          }
        `;
        document.head.appendChild(style);
      }
    } else {
      const style = document.getElementById('style-no-transitions');
      if (style) style.remove();
    }
  }

  document.getElementById('pref-accent')?.addEventListener('change', savePreferences);
  document.getElementById('pref-glass')?.addEventListener('change', savePreferences);
  document.getElementById('pref-transitions')?.addEventListener('change', savePreferences);

  // En caso de que se navegue mediante AJAX o tabs
  loadPreferences();
  applyPreferences();
</script>
