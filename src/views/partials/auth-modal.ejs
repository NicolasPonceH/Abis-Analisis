<!-- Modal de Autorización (Sudo Mode) -->
  <div class="modal-backdrop" id="modal-auth-ingesta" style="display: none;" aria-hidden="true">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title-text" aria-describedby="modal-warning-text" tabindex="-1">
      <div class="modal-header">
        <div class="modal-title">
          <div class="modal-icon-shield">
            <svg class="svg-icon svg-icon-md" viewBox="0 0 24 24" style="stroke: var(--pdi-gold);">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              <rect width="8" height="5" x="8" y="11" rx="1" />
              <path d="M10 11V9a2 2 0 1 1 4 0v2" />
            </svg>
          </div>
          <div>
            <span class="modal-eyebrow">CONTROL DE ACCESO</span>
            <h3 id="modal-title-text">Autorización de Seguridad</h3>
            <p id="modal-subtitle-text">Control de Acceso para Ingesta y Poblado de Base de Datos</p>
          </div>
        </div>
        <button type="button" class="modal-close" id="btn-modal-auth-close" title="Cerrar" aria-label="Cerrar">
          <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>

      <div class="modal-body">
        <div class="file-summary-card">
          <div class="file-summary-icon" id="modal-summary-icon">
            <svg class="svg-icon svg-icon-md" viewBox="0 0 24 24" style="stroke: var(--pdi-navy);">
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
              <polyline points="14 2 14 8 20 8" />
            </svg>
          </div>
          <div class="file-summary-info">
            <strong id="modal-file-name">archivo_enrolamiento.xlsx</strong>
            <span id="modal-file-details">0.0 MB &bull; Planilla Excel</span>
          </div>
          <span class="file-summary-badge">Pendiente</span>
        </div>

        <div class="auth-warning-box">
          <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" style="stroke: #b45309; flex-shrink: 0;">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
          <span id="modal-warning-text">Para realizar esta operación se requiere verificar su credencial policial de
            operador autorizado.</span>
        </div>

        <div class="auth-input-group">
          <label for="input-auth-clave" class="auth-label">Contraseña de inicio de sesión</label>
          <div class="auth-input-wrapper">
            <svg class="svg-icon svg-icon-sm auth-input-icon" viewBox="0 0 24 24">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
            <input type="password" id="input-auth-clave" class="form-control auth-control"
              placeholder="Ingrese tu contraseña de cuenta..." autocomplete="current-password">
            <button type="button" class="btn-toggle-eye" id="btn-toggle-password" title="Mostrar contraseña" aria-label="Mostrar contraseña" aria-pressed="false">
              <svg class="svg-icon svg-icon-xs" id="eye-icon" viewBox="0 0 24 24">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </button>
          </div>
          <div class="auth-error-msg" id="modal-auth-error" style="display: none;"></div>
        </div>
      </div>

      <div class="modal-footer">
        <span class="modal-footer-hint">
          <svg class="svg-icon svg-icon-xs" viewBox="0 0 24 24" aria-hidden="true">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
          Sesión protegida
        </span>
        <button type="button" class="btn btn-secondary" id="btn-modal-auth-cancel">
          Cancelar
        </button>
        <button type="button" class="btn btn-primary" id="btn-modal-auth-confirm">
          <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
          </svg>
          <span>Autorizar y Ejecutar</span>
        </button>
      </div>
    </div>
  </div>
