<section id="tab-tendencias" class="tab-content" style="display: none;">

      <!-- Comparador de Períodos (Benchmarking) -->
      <div class="trend-toolbar-card" style="margin-bottom: 20px;">
        <div class="trend-toolbar-left">
          <div class="trend-toolbar-group">
            <span class="trend-toolbar-label">Comparativa Operativa (Benchmarking):</span>
            <div class="filter-presets">
              <button class="preset-btn active" id="btn-comp-semana"><i class="fa-solid fa-chart-column" style="margin-right: 4px;"></i> Semana vs Anterior</button>
              <button class="preset-btn" id="btn-comp-mes"><i class="fa-solid fa-chart-column" style="margin-right: 4px;"></i> Mes vs Anterior</button>
            </div>
          </div>
        </div>
      </div>

      <div class="trend-kpi-grid" style="margin-bottom: 24px;" id="benchmarking-cards">
        <div class="trend-kpi-card default comparison-card">
          <span class="trend-kpi-label">Volumen Operativo</span>
          <div style="display: flex; align-items: baseline; gap: 8px;">
            <span class="trend-kpi-val" id="comp-kpi-total">0</span>
            <span class="delta-badge" id="comp-delta-total">0%</span>
          </div>
          <span class="trend-kpi-sub" id="comp-sub-total">Cargando...</span>
        </div>
        <div class="trend-kpi-card success comparison-card" style="display: none;">
          <span class="trend-kpi-label">Sincronización Exitosa</span>
          <div style="display: flex; align-items: baseline; gap: 8px;">
            <span class="trend-kpi-val" id="comp-kpi-sinc">0</span>
            <span class="delta-badge" id="comp-delta-sinc">0%</span>
          </div>
          <span class="trend-kpi-sub" id="comp-sub-sinc">Cargando...</span>
        </div>
        <div class="trend-kpi-card info comparison-card">
          <span class="trend-kpi-label">SLA Medio</span>
          <div style="display: flex; align-items: baseline; gap: 8px;">
            <span class="trend-kpi-val" id="comp-kpi-sla">0%</span>
            <span class="delta-badge" id="comp-delta-sla">0%</span>
          </div>
          <span class="trend-kpi-sub" id="comp-sub-sla">Cargando...</span>
        </div>
        <div class="trend-kpi-card peak comparison-card">
          <span class="trend-kpi-label">Inconsistencias (Errores)</span>
          <div style="display: flex; align-items: baseline; gap: 8px;">
            <span class="trend-kpi-val" id="comp-kpi-err">0</span>
            <span class="delta-badge" id="comp-delta-err">0%</span>
          </div>
          <span class="trend-kpi-sub" id="comp-sub-err">Cargando...</span>
        </div>
      </div>

      <!-- KPIs Resumen de Tendencias -->
      <div class="trend-kpi-grid">
        <div class="trend-kpi-card blue">
          <span class="trend-kpi-label">Volumen Acumulado</span>
          <span class="trend-kpi-val" id="trend-kpi-total">0</span>
          <span class="trend-kpi-sub">Total serie histórica analizada</span>
        </div>
        <div class="trend-kpi-card info" style="display: none;">
          <span class="trend-kpi-label">Jornadas Operativas</span>
          <span class="trend-kpi-val" id="trend-kpi-days">0</span>
          <span class="trend-kpi-sub">Días con registros activos</span>
        </div>
        <div class="trend-kpi-card default">
          <span class="trend-kpi-label">Promedio por Jornada</span>
          <span class="trend-kpi-val" id="trend-kpi-avg">0</span>
          <span class="trend-kpi-sub">Enrolamientos promedio diarios</span>
        </div>
        <div class="trend-kpi-card peak">
          <span class="trend-kpi-label">Jornada Récord (Pico)</span>
          <span class="trend-kpi-val" id="trend-kpi-peak">0</span>
          <span class="trend-kpi-sub" id="trend-kpi-peak-date">Cargando afluencia líder...</span>
        </div>
        <div class="trend-kpi-card success" style="display: none;">
          <span class="trend-kpi-label">SLA Global Histórico</span>
          <span class="trend-kpi-val" id="trend-kpi-sla">100%</span>
          <span class="trend-kpi-sub">Tasa media de sincronización PDI</span>
        </div>
      </div>

      <!-- Tarjeta del Gráfico de Evolución Temporal -->
      <div class="chart-card col-12" id="trend-chart-card" style="margin-bottom: 24px;">
        <div class="chart-header" style="flex-direction: column; align-items: stretch; gap: 16px;">
          <!-- Barra de Filtros y Expansión -->
          <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.15); padding-bottom: 16px; flex-wrap: wrap; gap: 12px;">
            <div class="trend-toolbar-left">
              <div class="trend-toolbar-group">
                <span class="trend-toolbar-label">Período:</span>
                <div class="filter-presets" id="trend-period-presets">
                  <button class="preset-btn" data-trend-range="15">15 Días</button>
                  <button class="preset-btn active" data-trend-range="30">30 Días</button>
                  <button class="preset-btn" data-trend-range="90">90 Días</button>
                  <button class="preset-btn" data-trend-range="365">1 Año</button>
                  <button class="preset-btn" data-trend-range="all">Todo el Histórico</button>
                </div>
              </div>

              <div class="trend-toolbar-group">
                <span class="trend-toolbar-label">Agrupación:</span>
                <div class="trend-granularity-toggle">
                  <button class="granularity-btn active" id="btn-granularity-day" data-granularity="day">Diario</button>
                  <button class="granularity-btn" id="btn-granularity-month" data-granularity="month">Mensual</button>
                </div>
              </div>
            </div>

            <div class="trend-toolbar-right">
              <button id="btn-toggle-expand-trend" class="btn btn-primary" title="Expandir gráfico para ver detalladamente">
                <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" style="stroke: #000000 !important;">
                  <polyline points="15 3 21 3 21 9" />
                  <polyline points="9 21 3 21 3 15" />
                  <line x1="21" x2="14" y1="3" y2="10" />
                  <line x1="3" x2="10" y1="21" y2="14" />
                </svg>
                <span id="trend-expand-text">Expandir Vista Detallada</span>
              </button>
              <button id="btn-fullscreen-trend" class="btn btn-secondary" title="Modo Pantalla Completa">
                <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24">
                  <rect width="18" height="18" x="3" y="3" rx="2" />
                  <path d="m3 9 6-6M9 21l-6-6M15 3l6 6M21 15l-6 6" />
                </svg>
                <span>Pantalla Completa</span>
              </button>
              <button id="btn-export-trend-csv" class="btn btn-csv" title="Descargar Serie Temporal en Formato CSV">
                <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24">
                  <path d="M3 3h18v18H3zM21 9H3M21 15H3M12 3v18" />
                </svg>
                <span>Exportar CSV</span>
              </button>
            </div>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
            <div class="chart-title">
              <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" style="stroke:var(--pdi-navy);">
                <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
                <polyline points="16 7 22 7 22 13" />
              </svg>
              <span>Curva de Evolución Temporal de Enrolamientos Biométricos</span>
            </div>
            <div style="display:flex; align-items:center; gap:10px;">
              <span class="chart-badge" id="badge-chart-tendencia">Cargando serie...</span>
            </div>
          </div>
        </div>
        <div class="chart-body" id="trend-chart-body" style="min-height: 420px; transition: min-height 0.3s ease;">
          <canvas id="chart-tendencia-historica"></canvas>
        </div>
      </div>

      <!-- Matriz Detallada Día a Día (Expandible) -->
      <div class="table-card" id="trend-detail-matrix">
        <div class="table-header-bar">
          <div class="chart-title">
            <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24">
              <rect width="18" height="18" x="3" y="4" rx="2" />
              <line x1="16" x2="16" y1="2" y2="6" />
              <line x1="8" x2="8" y1="2" y2="6" />
              <line x1="3" x2="21" y1="10" y2="10" />
            </svg>
            <span>Matriz Histórica Detallada Día por Día</span>
            <span class="badge badge-info" id="trend-matrix-count" style="margin-left: 8px;">0 jornadas</span>
          </div>
          <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <!-- Selector con Calendario Nativo -->
            <div class="trend-calendar-box" id="trend-calendar-box" title="Hacer clic para abrir calendario">
              <svg class="svg-icon svg-icon-xs" viewBox="0 0 24 24" style="stroke: var(--pdi-navy); flex-shrink: 0;">
                <rect width="18" height="18" x="3" y="4" rx="2" />
                <line x1="16" x2="16" y1="2" y2="6" />
                <line x1="8" x2="8" y1="2" y2="6" />
                <line x1="3" x2="21" y1="10" y2="10" />
              </svg>
              <input type="date" id="trend-calendar-picker" class="trend-calendar-input"
                title="Hacer clic para abrir calendario">
              <button type="button" id="btn-clear-trend-calendar" class="btn-clear-date" style="display: none;"
                title="Limpiar filtro de fecha">✕</button>
            </div>
            <input type="text" id="trend-search-input" class="form-control search-input"
              placeholder="Buscar fecha (ej: 2024-11, 2026)..." style="width: 230px;">
            <button id="btn-collapse-trend" class="btn btn-secondary btn-sm" title="Contraer o alternar matriz">
              <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24">
                <polyline points="4 14 10 14 10 20" />
                <polyline points="20 10 14 10 14 4" />
              </svg>
              <span>Alternar Tabla</span>
            </button>
          </div>
        </div>
        <div class="table-container" style="max-height: 480px; overflow-y: auto;">
          <table class="data-table">
            <thead>
              <tr>
                <th>Fecha Operativa</th>
                <th>Día</th>
                <th style="text-align:right;">Total Enrolados</th>
                <th style="text-align:right;">Sincronizados PDI</th>
                <th style="text-align:right;">Con Error</th>
                <th style="text-align:right;">Pendientes</th>
                <th>Cumplimiento SLA</th>
                <th style="text-align:center;">Acción Directa</th>
              </tr>
            </thead>
            <tbody id="trend-table-body">
              <tr>
                <td colspan="8" style="text-align:center; padding: 24px; color: var(--text-muted);">
                  Cargando serie detallada...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </section>

    <!-- Modal Pantalla Completa para Evolución y Tendencias -->
    <div class="modal-backdrop" id="modal-trend-fullscreen" style="display: none;">
      <div class="modal-dialog modal-fullscreen-dialog">
        <div class="modal-header">
          <div class="modal-title">
            <svg class="svg-icon svg-icon-md" viewBox="0 0 24 24" style="stroke: #ffd100;">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
              <polyline points="16 7 22 7 22 13" />
            </svg>
            <span>Centro de Mando: Evolución y Tendencias Históricas ABIS</span>
            <span class="badge badge-primary" id="modal-trend-badge">Alta Resolución</span>
          </div>
          <button type="button" class="modal-close" id="btn-close-trend-fullscreen" title="Cerrar pantalla completa"
            aria-label="Cerrar">
            <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>
        <div class="modal-body modal-fullscreen-body">
          <div class="modal-fullscreen-canvas-wrapper">
            <canvas id="chart-tendencia-modal"></canvas>
          </div>
        </div>
      </div>
    </div>
    