          <span id="audit-page-info" style="font-size: 0.9rem; color: var(--text-secondary); font-weight: 600;">Página 1</span>
          <div style="display: flex; gap: 8px;">
            <button class="btn btn-secondary btn-sm" id="btn-audit-prev" disabled>Anterior</button>
            <button class="btn btn-secondary btn-sm" id="btn-audit-next">Siguiente</button>
          </div>
