<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description"
    content="Sistema ABIS - Plataforma oficial de la Policía de Investigaciones de Chile (PDI) para análisis, auditoría y reportería ejecutiva de enrolamiento biométrico.">
  <title>Sistema ABIS - Panel Analítico de Enrolamiento Biométrico | PDI Chile</title>

  <!-- Favicon y Tipografía Oficial PDI Chile (Open Sans Unificada) -->
  <link rel="icon" type="image/png" href="assets/logo-pdi.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="css/styles.css?v=47">
  <!-- Chart.js CDN Oficial -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
  <script>
    if (typeof Chart === "undefined") {
      document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.2/chart.umd.min.js"><\/script>');
    }
  </script>
<script>
  (function() {
    try {
      // 1. Acento Institucional
      const accent = localStorage.getItem('pref-accent') || '#FFD100';
      document.documentElement.style.setProperty('--pdi-gold', accent);

      // 2. Estética de Cristal
      const glass = localStorage.getItem('pref-glass') !== 'false';
      if (!glass) {
        const style = document.createElement('style');
        style.id = 'style-no-glass';
        style.innerHTML = `
          * { backdrop-filter: none !important; -webkit-backdrop-filter: none !important; }
          .settings-card-header, .header-institutional { background: var(--pdi-navy) !important; }
        `;
        document.head.appendChild(style);
      }

      // 3. Transiciones Fluidas
      const transitions = localStorage.getItem('pref-transitions') !== 'false';
      if (!transitions) {
        const style = document.createElement('style');
        style.id = 'style-no-transitions';
        style.innerHTML = `
          * { transition: none !important; animation: none !important; }
        `;
        document.head.appendChild(style);
      }
    } catch(e) {}
  })();
</script>
</head>

<body>

  <!-- Header Institucional PDI (Estilo Oficial pdichile.cl) -->
  <header class="header-institutional">
    <div class="header-inner">
      <div class="brand-section">
        <img src="assets/logo-pdi.png" alt="Policía de Investigaciones de Chile" class="logo-pdi" id="pdi-logo-header"
          width="76" height="38">
        <div class="brand-titles">
          <div class="brand-title">
            <span>SISTEMA ABIS</span>
          </div>
          <div class="brand-subtitle">ENROLAMIENTO BIOMÉTRICO</div>
        </div>
      </div>

      <!-- Barra de Navegación de Paneles Centrada -->
      <nav class="tabs-nav navbar-top" id="main-navbar">
        <button class="tab-button active" data-tab="metricas">
          <svg class="nav-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
            stroke-linejoin="round">
            <rect width="7" height="9" x="3" y="3" rx="1" />
            <rect width="7" height="5" x="14" y="3" rx="1" />
            <rect width="7" height="9" x="14" y="12" rx="1" />
            <rect width="7" height="5" x="3" y="16" rx="1" />
          </svg>
          <span>Panel Ejecutivo</span>
        </button>
        <button class="tab-button" data-tab="ingesta">
          <svg class="nav-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="17 8 12 3 7 8" />
            <line x1="12" x2="12" y1="3" y2="15" />
          </svg>
          <span>Ingesta ABIS</span>
        </button>
        <button class="tab-button" data-tab="tendencias">
          <svg class="nav-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
            stroke-linejoin="round">
            <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
            <polyline points="16 7 22 7 22 13" />
          </svg>
          <span>Evolución & Tendencias</span>
        </button>
        <button class="tab-button" data-tab="auditoria">
          <svg class="nav-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span>Bitácora & Auditoría</span>
        </button>
        
      </nav>

      <!-- Contenedor alineado a la derecha para el botón -->
      <div class="header-actions" style="flex: 1; display: flex; justify-content: flex-end; align-items: center; gap: 16px;">
        <a href="/analisis/" target="_blank" class="btn-siad-link">
          <svg class="nav-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <path d="M9 15l2 2 4-4"></path>
          </svg>
          <span>Análisis Documental</span>
        </a>
        <!-- Contenedor del Usuario (Estilo Ghost / Cuadrado) -->
        <div style="display: flex; align-items: center; gap: 10px; margin-left: 16px; margin-right: 8px; user-select: none; padding: 4px 10px; border-radius: 8px; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.06)';" onmouseout="this.style.background='transparent';">
          <div style="display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; color: #ffffff; font-weight: 700; font-size: 14px; text-transform: uppercase;">
            <%= typeof user !== 'undefined' ? user.username.charAt(0) : 'U' %>
          </div>
          <div style="display: flex; flex-direction: column; line-height: 1.2;">
            <span style="color: rgba(255, 255, 255, 0.55); font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;"><%= typeof user !== 'undefined' ? ((user.rol === 'admin' || (user.username && user.username.toLowerCase() === 'admin')) ? 'Administrador' : 'Operador') : 'Operador' %></span>
            <span style="color: #ffffff; font-weight: 600; font-size: 14px; text-transform: capitalize; letter-spacing: 0.02em;">
              <%= typeof user !== 'undefined' ? user.username : 'Usuario' %>
            </span>
          </div>
        </div>

        <!-- Botón Ajustes (Tuerca) -->
        <a href="/ajustes" title="Ajustes" style="display: flex; align-items: center; justify-content: center; width: 38px; height: 38px; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); color: #ffffff; border-radius: 8px; text-decoration: none; transition: all 0.2s ease;" onmouseover="this.style.background='rgba(255,255,255,0.2)'; this.style.transform='rotate(45deg)';" onmouseout="this.style.background='rgba(255, 255, 255, 0.1)'; this.style.transform='rotate(0)';">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 18px; height: 18px;">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
        </a>
        <!-- Boton de cierre de sesion -->
        <a href="/logout" class="header-logout-button" title="Cerrar sesion" aria-label="Cerrar sesion">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </a>
      </div>
    </div>
  </header>

  <!-- Contenedor Principal -->
  <main class="app-container">

    <!-- ========================================== -->
    <!-- TAB 1: MÉTRICAS Y ANALÍTICA AVANZADA -->
    <!-- ========================================== -->
    <%- include('partials/tab-metricas') %>
<%- include('partials/tab-ingesta') %>
<%- include('partials/tab-tendencias') %>
<%- include('partials/tab-auditoria') %>


  </main>

  <!-- Modal de Autorización de Seguridad para Ingesta -->
    <%- include('partials/auth-modal') %>

  <!-- Footer Institucional -->
  <footer class="footer app-footer">
    <div class="footer-brand">
      <img src="assets/logo-pdi.png" alt="Logo PDI" />
      <div class="footer-brand-copy">
        <div><strong style="font-size: 0.95rem;">Sistema de Gestión ABIS</strong></div>
        <div style="font-size: 0.75rem; color: var(--border-subtle) !important; margin-top: 2px;">Policía de Investigaciones de Chile</div>
      </div>
    </div>
    <div class="footer-meta">
      <nav class="footer-quick-links" aria-label="Enlaces rápidos">
        <a href="/">Panel ABIS</a>
        <a href="/ajustes">Ajustes</a>
      </nav>
      &copy; 2026 Todos los derechos reservados.
    </div>
    <a href="/analisis/" target="_blank" rel="noopener noreferrer" class="footer-siad-button" aria-label="Abrir Sistema de Análisis Documental">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"></path>
        <path d="m13 6 6 6-6 6"></path>
      </svg>
      <span>Ir al Sistema de Análisis</span>
    </a>
  </footer>

  <!-- Script Principal -->
  <script type="module" src="js/components/custom-selects.js?v=3"></script>
  <script type="module" src="js/app.js?v=24"></script>
</body>

</html>


