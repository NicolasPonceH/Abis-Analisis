<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description"
    content="Sistema ABIS - Plataforma oficial de la Policía de Investigaciones de Chile (PDI) para análisis, auditoría y reportería ejecutiva de enrolamiento biométrico.">
  <title>Ajustes - Sistema ABIS | PDI Chile</title>

  <!-- Favicon y Tipografía Oficial PDI Chile (Open Sans Unificada) -->
  <link rel="icon" type="image/png" href="/assets/logo-pdi.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  
  <link rel="stylesheet" href="/css/styles.css?v=66">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/ajustes.css?v=67">
  
<script>
  (function() {
    try {
      const accent = localStorage.getItem('pref-accent') || '#FFD100';
      document.documentElement.style.setProperty('--pdi-gold', accent);
      const glass = localStorage.getItem('pref-glass') !== 'false';
      if (!glass) {
        const style = document.createElement('style');
        style.id = 'style-no-glass';
        style.innerHTML = `* { backdrop-filter: none !important; -webkit-backdrop-filter: none !important; } .settings-card-header, .header-institutional { background: var(--pdi-navy) !important; }`;
        document.head.appendChild(style);
      }
      const transitions = localStorage.getItem('pref-transitions') !== 'false';
      if (!transitions) {
        const style = document.createElement('style');
        style.id = 'style-no-transitions';
        style.innerHTML = `* { transition: none !important; animation: none !important; }`;
        document.head.appendChild(style);
      }
    } catch(e) {}
  })();
</script>
  
  
<script>
  (function() {
    try {
      const fs = localStorage.getItem('pref-fontsize') || '14px';
      document.documentElement.style.fontSize = fs;
      if (localStorage.getItem('pref-contrast') === 'true') document.documentElement.classList.add('high-contrast');
      const sharedTheme = localStorage.getItem('darkMode');
      const isDarkTheme = sharedTheme !== null
        ? sharedTheme === '1'
        : localStorage.getItem('pref-theme') === 'dark';
      if (isDarkTheme) document.documentElement.classList.add('dark-theme');
      if (localStorage.getItem('pref-animations') === 'true') document.documentElement.classList.add('reduce-animations');
    } catch(e) {}
  })();
</script>
</head>

<body>

  <!-- Header Institucional PDI (Reutilizado visualmente) -->
  <header class="header-institutional">
    <div class="header-inner">
      <div class="brand-section" style="flex: 1;">
        <a href="/abis" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit;" title="Volver al Panel ABIS">
          <img src="/assets/logo-pdi.png" alt="Policía de Investigaciones de Chile" class="logo-pdi" id="pdi-logo-header" width="76" height="38">
          <div class="brand-titles">
            <div class="brand-title"><span>SISTEMA ABIS</span></div>
            <div class="brand-subtitle">ENROLAMIENTO BIOMÉTRICO</div>
          </div>
        </a>
      </div>

      <!-- Título central -->
      <div style="flex: 1; display: flex; justify-content: center; align-items: center; text-align: center;">
        <h1 style="color: rgba(255, 255, 255, 0.95); font-size: 1.05rem; font-weight: 700; letter-spacing: 0.08em; margin: 0; text-transform: uppercase;">
          Ajustes del Sistema Analítico ABIS
        </h1>
      </div>

      <!-- Contenedor alineado a la derecha -->
      <div style="flex: 1; display: flex; justify-content: flex-end; align-items: center; gap: 16px;">
        <!-- Contenedor del Usuario (Estilo Ghost / Cuadrado) -->
        <div style="display: flex; align-items: center; gap: 10px; margin-left: 16px; margin-right: 8px; user-select: none; padding: 4px 10px; border-radius: 8px; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.06)';" onmouseout="this.style.background='transparent';">
          <div style="display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; color: var(--bg-surface); font-weight: 700; font-size: 1rem; text-transform: uppercase;">
            <%= typeof user !== 'undefined' ? user.username.charAt(0) : 'U' %>
          </div>
          <div style="display: flex; flex-direction: column; line-height: 1.2;">
            <span style="color: rgba(255, 255, 255, 0.55); font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;"><%= typeof user !== 'undefined' ? ((user.rol === 'admin' || (user.username && user.username.toLowerCase() === 'admin')) ? 'Administrador' : 'Operador') : 'Operador' %></span>
            <span style="color: var(--bg-surface); font-weight: 600; font-size: 1rem; text-transform: capitalize; letter-spacing: 0.02em;">
              <%= typeof user !== 'undefined' ? user.username : 'Usuario' %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <% const activeSec = (typeof activeSection !== 'undefined' && activeSection) ? activeSection : 'general'; %>
  <div class="ajustes-container">
    <aside class="ajustes-sidebar" id="ajustes-sidebar">
      <div class="ajustes-sidebar-header">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <h2>AJUSTES</h2>
        <button type="button" class="ajustes-sidebar-toggle" id="ajustes-sidebar-toggle" aria-expanded="true" aria-controls="ajustes-sidebar" title="Contraer barra lateral">
          <i class="fa-solid fa-chevron-left ajustes-toggle-icon-left" aria-hidden="true"></i>
          <i class="fa-solid fa-chevron-right ajustes-toggle-icon-right" aria-hidden="true"></i>
        </button>
      </div>

      <nav class="ajustes-nav">
        <a href="/ajustes/general" title="General" class="ajustes-nav-item <%= activeSec === 'general' ? 'active' : '' %>">
          <i class="fa-solid fa-sliders"></i><span class="ajustes-nav-label">General</span>
        </a>
        <a href="/ajustes/horarios" title="Horarios" class="ajustes-nav-item <%= activeSec === 'horarios' ? 'active' : '' %>">
          <i class="fa-solid fa-clock"></i><span class="ajustes-nav-label">Horarios</span>
        </a>
        <a href="/ajustes/cuenta" title="Cuenta" class="ajustes-nav-item <%= activeSec === 'cuenta' ? 'active' : '' %>">
          <i class="fa-solid fa-user"></i><span class="ajustes-nav-label">Cuenta</span>
        </a>
      </nav>

      <div class="ajustes-section-title">ADMINISTRACIÓN</div>
      <nav class="ajustes-nav">
        <a href="/ajustes/administracion" title="Administración" class="ajustes-nav-item <%= activeSec === 'administracion' ? 'active' : '' %>">
          <i class="fa-solid fa-users-gear"></i><span class="ajustes-nav-label">Administración</span>
        </a>
      </nav>

      <div class="ajustes-sidebar-actions">
        <a href="/abis" title="Volver al Dashboard ABIS" class="ajustes-nav-item sidebar-dashboard-link">
          <i class="fa-solid fa-arrow-left"></i><span class="ajustes-nav-label">Volver a ABIS</span>
        </a>
        <a href="/" title="Portal de Sistemas" class="ajustes-nav-item sidebar-portal-link">
          <i class="fa-solid fa-shapes"></i><span class="ajustes-nav-label">Cambiar Sistema</span>
        </a>
        <a href="/logout" title="Cerrar Sesión" class="ajustes-nav-item sidebar-logout-link">
          <i class="fa-solid fa-arrow-right-from-bracket"></i><span class="ajustes-nav-label">Cerrar Sesión</span>
        </a>
      </div>
    </aside>

    <main class="ajustes-content">
      <% if (activeSec === 'general') { %>
        <%- include('partials/ajustes/general') %>
      <% } else if (activeSec === 'horarios') { %>
        <%- include('partials/ajustes/horarios') %>
      <% } else if (activeSec === 'cuenta') { %>
        <%- include('partials/ajustes/cuenta') %>
      <% } else if (activeSec === 'administracion') { %>
        <%- include('partials/ajustes/administracion') %>
      <% } %>
    </main>
  </div>
  <% if (typeof activeSec !== 'undefined' && activeSec === 'horarios') { %>
  <script type="module">
    import { loadScheduleSettings, setupScheduleEvents } from '/js/modules/ajustes.js?v=7';
    const init = () => {
      setupScheduleEvents();
      loadScheduleSettings();
    };
    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
  <% } %>
  <script type="module" src="/js/components/custom-selects.js?v=3"></script>
  <script src="/js/session-guard.js?v=2"></script>
  <script>
    (() => {
      const container = document.querySelector('.ajustes-container');
      const toggle = document.getElementById('ajustes-sidebar-toggle');
      if (!container || !toggle) return;

      const storageKey = 'abis-ajustes-sidebar-collapsed';
      const isDesktop = () => window.matchMedia('(min-width: 1201px)').matches;
      const updateState = (collapsed) => {
        container.classList.toggle('ajustes-sidebar-collapsed', collapsed);
        toggle.setAttribute('aria-expanded', String(!collapsed));
        toggle.title = collapsed ? 'Expandir barra lateral' : 'Contraer barra lateral';
        toggle.classList.toggle('is-collapsed', collapsed);
      };

      updateState(isDesktop() && localStorage.getItem(storageKey) === 'true');
      toggle.addEventListener('click', () => {
        if (!isDesktop()) return;
        const collapsed = !container.classList.contains('ajustes-sidebar-collapsed');
        updateState(collapsed);
        localStorage.setItem(storageKey, String(collapsed));
      });
      window.addEventListener('resize', () => {
        updateState(isDesktop() && localStorage.getItem(storageKey) === 'true');
      });
    })();
  </script>
  <script>
    window.togglePasswordVisibility = function(inputId, btn) {
      const input = document.getElementById(inputId);
      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';
      if (btn.hasAttribute('aria-pressed')) btn.setAttribute('aria-pressed', String(isPassword));
      if (btn.hasAttribute('aria-label')) btn.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
      btn.innerHTML = isPassword
        ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:100%;height:100%;"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>`
        : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:100%;height:100%;"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>`;
    };
  </script>
</body>
</html>



