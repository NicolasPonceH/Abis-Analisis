<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description"
    content="Sistema ABIS - Plataforma oficial de la Policía de Investigaciones de Chile (PDI) para análisis, auditoría y reportería ejecutiva de enrolamiento biométrico.">
  <title>Ajustes - Sistema ABIS | PDI Chile</title>

  <!-- Favicon y Tipografía Oficial PDI Chile (Open Sans Unificada) -->
  <link rel="icon" type="image/png" href="/assets/logo-pdi.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  
  <link rel="stylesheet" href="/css/styles.css?v=45">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  
<script>
  (function() {
    try {
      const accent = localStorage.getItem('pref-accent') || '#FFD100';
      document.documentElement.style.setProperty('--pdi-gold', accent);
      const glass = localStorage.getItem('pref-glass') !== 'false';
      if (!glass) {
        const style = document.createElement('style');
        style.id = 'style-no-glass';
        style.innerHTML = `* { backdrop-filter: none !important; -webkit-backdrop-filter: none !important; } .settings-card-header, .header-institutional { background: var(--pdi-navy) !important; }`;
        document.head.appendChild(style);
      }
      const transitions = localStorage.getItem('pref-transitions') !== 'false';
      if (!transitions) {
        const style = document.createElement('style');
        style.id = 'style-no-transitions';
        style.innerHTML = `* { transition: none !important; animation: none !important; }`;
        document.head.appendChild(style);
      }
    } catch(e) {}
  })();
</script>
  
  <style>
    body { background-color: var(--bg-app); font-family: 'Open Sans', sans-serif; margin: 0; padding: 0; display: flex; flex-direction: column; min-height: 100vh; overflow: hidden; }
    
    .ajustes-container { display: flex; flex: 1; height: calc(100vh - 60px); overflow: hidden; }
    
    .ajustes-sidebar { width: 260px; background: var(--bg-surface); border-right: 1px solid var(--border-subtle); display: flex; flex-direction: column; padding: 32px 0; box-shadow: 2px 0 10px rgba(0,0,0,0.02); flex-shrink: 0; overflow-y: auto; }
    .ajustes-sidebar-header { padding: 0 24px; margin-bottom: 32px; display: flex; align-items: center; gap: 12px; color: var(--text-primary); }
    .ajustes-sidebar-header svg { width: 24px; height: 24px; stroke-width: 2.5; }
    .ajustes-sidebar-header h2 { font-size: 18px; font-weight: 800; letter-spacing: 0.05em; margin: 0; }
    
    .ajustes-nav { display: flex; flex-direction: column; gap: 4px; padding: 0 12px; }
    .ajustes-nav-item { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 8px; text-decoration: none; font-size: 14.5px; font-weight: 600; color: #475569; transition: all 0.2s ease; }
    .ajustes-nav-item:hover { background: var(--bg-surface-hover); color: var(--text-primary); }
    .ajustes-nav-item.active { background: var(--bg-surface-hover); color: #0B5ED7; font-weight: 700; box-shadow: inset 3px 0 0 #0B5ED7; }
    .ajustes-nav-item i { font-size: 1.14rem; width: 20px; text-align: center; }
    
    .ajustes-section-title { font-size: 11px; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.1em; padding: 0 28px; margin: 24px 0 12px 0; }
    
    .ajustes-content { flex: 1; padding: 40px; overflow-y: auto; background-color: var(--bg-app); }
    .ajustes-page-title { color: var(--text-primary); font-size: 2rem; font-weight: 800; margin: 0 0 8px 0; letter-spacing: -0.02em; }
    .ajustes-page-subtitle { color: var(--text-muted); font-size: 1.07rem; margin: 0 0 32px 0; }
    
    .ajustes-card { background: var(--bg-surface); border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid var(--border-subtle); padding: 24px; margin-bottom: 24px; }
    .ajustes-card-header { font-size: 1.14rem; font-weight: 700; color: var(--text-primary); border-bottom: 1px solid var(--bg-surface-hover); padding-bottom: 16px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }

    .account-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
    .account-grid > .ajustes-card { height: 100%; box-sizing: border-box; }
    .settings-form { display: flex; flex-direction: column; gap: 14px; }
    .settings-form[hidden] { display: none; }
    .settings-form-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .settings-form label { display: block; color: #475569; font-size: 0.92rem; font-weight: 700; margin-bottom: 6px; }
    .settings-form .form-control { width: 100%; box-sizing: border-box; }
    .form-feedback { min-height: 20px; margin: 0; font-size: 0.92rem; font-weight: 700; }
    .form-feedback.success { color: #047857; }
    .form-feedback.error { color: #b91c1c; }
    .admin-form-card { border-top: 4px solid #D4AF37; }
    .admin-action-btn { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--border-medium); background: var(--bg-surface); color: var(--text-secondary); border-radius: 6px; padding: 7px 9px; font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: all 0.2s ease; }
    .admin-action-btn:hover { background: var(--bg-surface-hover); border-color: #93c5fd; color: #0B5ED7; }
    .admin-action-btn.password:hover { background: #fff7ed; border-color: #fdba74; color: #c2410c; }
    .admin-actions { display: flex; justify-content: flex-end; gap: 7px; flex-wrap: wrap; }
    .settings-modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgba(15, 23, 42, 0.48); }
    .settings-modal[hidden], .admin-form-card[hidden] { display: none; }
    .settings-modal-card { width: min(440px, 100%); background: var(--bg-surface); border-radius: 14px; box-shadow: 0 20px 60px rgba(15, 23, 42, 0.24); padding: 24px; }
    .settings-modal-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
    .settings-modal-header h2 { margin: 0; color: var(--text-primary); font-size: 20px; }
    .settings-close-btn { border: 0; background: transparent; color: var(--text-muted); cursor: pointer; font-size: 20px; padding: 0 4px; }
    
    .info-row { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--bg-surface-subtle); }
    .info-row:last-child { border-bottom: none; padding-bottom: 0; }
    .info-label { color: var(--text-muted); font-weight: 600; font-size: 1rem; }
    .info-value { color: var(--text-primary); font-weight: 700; font-size: 1rem; text-align: right; }
    
    @media (max-width: 768px) {
      .ajustes-container { flex-direction: column; overflow: auto; height: auto; }
      .ajustes-sidebar { width: 100%; height: auto; padding: 16px 0; border-right: none; border-bottom: 1px solid var(--border-subtle); }
      .ajustes-content { padding: 20px; overflow: visible; }
      .account-grid, .settings-form-row { grid-template-columns: 1fr; }
    }
  </style>
<script>
  (function() {
    try {
      const fs = localStorage.getItem('pref-fontsize') || '14px';
      document.documentElement.style.fontSize = fs;
      if (localStorage.getItem('pref-contrast') === 'true') document.documentElement.classList.add('high-contrast');
      if (localStorage.getItem('pref-theme') === 'dark') document.documentElement.classList.add('dark-theme');
      if (localStorage.getItem('pref-animations') === 'true') document.documentElement.classList.add('reduce-animations');
    } catch(e) {}
  })();
</script>
</head>

<body>

  <!-- Header Institucional PDI (Reutilizado visualmente) -->
  <header class="header-institutional">
    <div class="header-inner">
      <div class="brand-section">
        <a href="/" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit;">
          <img src="/assets/logo-pdi.png" alt="Policía de Investigaciones de Chile" class="logo-pdi" id="pdi-logo-header" width="76" height="38">
          <div class="brand-titles">
            <div class="brand-title"><span>SISTEMA ABIS</span></div>
            <div class="brand-subtitle">ENROLAMIENTO BIOMÉTRICO</div>
          </div>
        </a>
      </div>

      <!-- Navegación central (vacía en este contexto) -->
      <nav class="tabs-nav navbar-top" id="main-navbar">
      </nav>

      <!-- Contenedor alineado a la derecha -->
      <div style="flex: 1; display: flex; justify-content: flex-end; align-items: center; gap: 16px;">
        <!-- Contenedor del Usuario (Estilo Ghost / Cuadrado) -->
        <div style="display: flex; align-items: center; gap: 10px; margin-left: 16px; margin-right: 8px; user-select: none; padding: 4px 10px; border-radius: 8px; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.06)';" onmouseout="this.style.background='transparent';">
          <div style="display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; color: var(--bg-surface); font-weight: 700; font-size: 1rem; text-transform: uppercase;">
            <%= typeof user !== 'undefined' ? user.username.charAt(0) : 'U' %>
          </div>
          <div style="display: flex; flex-direction: column; line-height: 1.2;">
            <span style="color: rgba(255, 255, 255, 0.55); font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;"><%= typeof user !== 'undefined' ? (user.rol === 'admin' ? 'Administrador' : 'Operador') : 'Operador' %></span>
            <span style="color: var(--bg-surface); font-weight: 600; font-size: 1rem; text-transform: capitalize; letter-spacing: 0.02em;">
              <%= typeof user !== 'undefined' ? user.username : 'Usuario' %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="ajustes-container">
    <aside class="ajustes-sidebar">
      <div class="ajustes-sidebar-header">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        <h2>AJUSTES</h2>
      </div>

      <div style="padding: 0 16px 24px 16px; margin-bottom: 12px; display: flex; flex-direction: column; gap: 8px; border-bottom: 1px solid var(--border-subtle);">
        <a href="/" style="display: flex; align-items: center; justify-content: center; gap: 8px; padding: 7px 12px; border-radius: 6px; text-decoration: none; font-size: 12.5px; font-weight: 700; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); color: #047857; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); box-shadow: 0 2px 8px rgba(16, 185, 129, 0.05); transition: all 0.2s ease;" onmouseover="this.style.background='rgba(16, 185, 129, 0.22)'; this.style.transform='translateY(-1px)';" onmouseout="this.style.background='rgba(16, 185, 129, 0.12)'; this.style.transform='translateY(0)';">
          <i class="fa-solid fa-arrow-left" style="font-size: 11px;"></i> Volver al Dashboard
        </a>
        <a href="/analisis/" target="_blank" style="display: flex; align-items: center; justify-content: center; gap: 8px; padding: 7px 12px; border-radius: 6px; text-decoration: none; font-size: 12.5px; font-weight: 700; background: #FFD700; border: 1px solid #eab308; color: #002855; transition: all 0.2s ease;" onmouseover="this.style.background='#e6c200'; this.style.transform='translateY(-1px)';" onmouseout="this.style.background='#FFD700'; this.style.transform='translateY(0)';">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" style="width: 13px; height: 13px; stroke-width: 2.5;">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <path d="M9 15l2 2 4-4"></path>
          </svg>
          Análisis Documental
        </a>
        <a href="/logout" style="display: flex; align-items: center; justify-content: center; gap: 8px; padding: 7px 12px; border-radius: 6px; text-decoration: none; font-size: 12.5px; font-weight: 700; background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; transition: all 0.2s ease;" onmouseover="this.style.background='#fee2e2';" onmouseout="this.style.background='#fef2f2';">
          <i class="fa-solid fa-arrow-right-from-bracket" style="font-size: 11px;"></i> Cerrar Sesión
        </a>
      </div>

      <nav class="ajustes-nav">
        <a href="/ajustes/general" class="ajustes-nav-item <%= activeSection === 'general' ? 'active' : '' %>">
          <i class="fa-solid fa-sliders"></i> General
        </a>
        <a href="/ajustes/horarios" class="ajustes-nav-item <%= activeSection === 'horarios' ? 'active' : '' %>">
          <i class="fa-solid fa-clock"></i> Horarios
        </a>
        <a href="/ajustes/cuenta" class="ajustes-nav-item <%= activeSection === 'cuenta' ? 'active' : '' %>">
          <i class="fa-solid fa-user"></i> Cuenta
        </a>
      </nav>

      <div class="ajustes-section-title">ADMINISTRACIÓN</div>
      <nav class="ajustes-nav">
        <a href="/ajustes/administracion" class="ajustes-nav-item <%= activeSection === 'administracion' ? 'active' : '' %>">
          <i class="fa-solid fa-users-gear"></i> Administración
        </a>
      </nav>

    </aside>

    <main class="ajustes-content">
      <% if (activeSection === 'general') { %>
        <%- include('partials/ajustes/general') %>
      <% } else if (activeSection === 'horarios') { %>
        <%- include('partials/ajustes/horarios') %>
      <% } else if (activeSection === 'cuenta') { %>
        <%- include('partials/ajustes/cuenta') %>
      <% } else if (activeSection === 'administracion') { %>
        <%- include('partials/ajustes/administracion') %>
      <% } %>
    </main>
  </div>

  <script type="module">
    import { loadScheduleSettings, setupScheduleEvents } from '/js/modules/ajustes.js?v=2';
    
    <% if (activeSection === 'horarios') { %>
      window.addEventListener('DOMContentLoaded', () => {
        setupScheduleEvents();
        loadScheduleSettings();
      });
    <% } %>
  </script>
</body>
</html>



