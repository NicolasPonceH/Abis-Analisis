<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Ingresar - ABIS</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 15% 50%, rgba(0, 35, 76, 0.12), transparent 30%), radial-gradient(circle at 85% 20%, rgba(2, 132, 199, 0.15), transparent 30%), radial-gradient(circle at 50% 90%, rgba(255, 209, 0, 0.1), transparent 35%), linear-gradient(135deg, #eaf0f7 0%, #f8fafc 100%);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
  .card {
    width: 100%;
    max-width: 360px;
    background: #ffffff;
    border-radius: 16px;
    padding: 32px 28px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
    text-align: center;
  }
  .logo-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #002855;
    border-radius: 12px;
    padding: 12px 18px;
    margin-bottom: 18px;
  }
  .logo-badge img { height: 44px; width: auto; display: block; }
  h1 {
    font-size: 18px;
    font-weight: 700;
    color: #002855;
    margin: 0 0 4px;
  }
  p.subtitle {
    font-size: 13px;
    color: #6b7280;
    margin: 0 0 24px;
  }
  .flash {
    background: #ffdad6;
    color: #93000a;
    font-size: 13px;
    padding: 10px 12px;
    border-radius: 8px;
    margin-bottom: 16px;
  }
  label {
    display: block;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #43474f;
    margin-bottom: 6px;
  }
  input[type="password"], input[type="text"] {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #c4c6d0;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    margin-bottom: 18px;
  }
  input[type="password"]:focus, input[type="text"]:focus { outline: none; border-color: #002855; }
  button {
    width: 100%;
    padding: 11px;
    border: none;
    border-radius: 8px;
    background: #FFD700;
    color: #002855;
    font-family: inherit;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.03em;
    cursor: pointer;
  }
  button:hover { background: #e9c400; }
  .footer-note {
    margin-top: 20px;
    font-size: 11px;
    color: #9ca3af;
  }
  .card:has(.flash) { animation: shakeError 350ms ease-in-out; }
  @keyframes shakeError {
    10%, 90% { transform: translateX(-1px); }
    20%, 80% { transform: translateX(2px); }
    30%, 50%, 70% { transform: translateX(-4px); }
    40%, 60% { transform: translateX(4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .card:has(.flash) { animation: none; }
  }

  /* Scanner Animation PDI Theme */
  #scanner-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 40, 85, 0.96); /* Azul PDI */
    z-index: 1000;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(8px);
  }
  .scanner-logo {
    height: 70px;
    width: auto;
    margin-bottom: 30px;
    border-radius: 8px;
    opacity: 0.95;
    box-shadow: 0 4px 15px rgba(255, 215, 0, 0.15);
  }
  .scanner-frame {
    position: relative;
    width: 140px;
    height: 140px;
    display: flex;
    justify-content: center;
    align-items: center;
    border: 1px solid rgba(255, 215, 0, 0.15); /* Oro PDI oscuro */
    background: rgba(0, 20, 50, 0.5);
    border-radius: 12px;
    overflow: hidden;
  }
  .corner {
    position: absolute;
    width: 25px;
    height: 25px;
    border-color: #FFD700; /* Oro PDI */
    border-style: solid;
    border-width: 0;
  }
  .top-left { top: 0; left: 0; border-top-width: 3px; border-left-width: 3px; border-top-left-radius: 12px; }
  .top-right { top: 0; right: 0; border-top-width: 3px; border-right-width: 3px; border-top-right-radius: 12px; }
  .bottom-left { bottom: 0; left: 0; border-bottom-width: 3px; border-left-width: 3px; border-bottom-left-radius: 12px; }
  .bottom-right { bottom: 0; right: 0; border-bottom-width: 3px; border-right-width: 3px; border-bottom-right-radius: 12px; }
  
  .fingerprint-svg {
    width: 65%;
    height: 65%;
    opacity: 0.2;
    stroke: #ffffff;
    transition: all 0.6s ease-out;
  }
  .fingerprint-svg.active {
    stroke: #FFD700;
    opacity: 1;
    filter: drop-shadow(0 0 15px rgba(255, 215, 0, 0.8));
    transform: scale(1.05);
  }
  .laser {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: #FFD700;
    box-shadow: 0 0 20px 5px rgba(255, 215, 0, 0.5);
    animation: scan 1.4s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  }
  @keyframes scan {
    0% { top: 0%; opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }
  .scanner-text {
    margin-top: 35px;
    font-size: 14px;
    font-weight: 600;
    color: #e2e8f0;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    animation: pulse 1s infinite alternate;
  }
  @keyframes pulse {
    0% { opacity: 0.4; }
    100% { opacity: 1; }
  }
</style>
</head>
<body>
  <form class="card" method="post" action="/login">
    <div class="logo-badge">
      <img src="/analisis/static/img/pdi-logo.jpg" alt="PDI">
    </div>
    <h1>ABIS</h1>
    <p class="subtitle">Sistema ABIS Principal — acceso restringido</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash"><%= error %></div>
    <% } %>

    <label for="username">Nombre de usuario</label>
    <input type="text" id="username" name="username" required autofocus>
    
    <label for="password">Contraseña</label>
    <input type="password" id="password" name="password" required>
    
    <button type="submit">Ingresar a ABIS</button>

    <div style="margin-top: 16px; font-size: 13px; display: flex; flex-direction: column; gap: 8px;">
      <a href="/analisis/register" style="color: #002855; text-decoration: none; font-weight: 500;">¿No tienes cuenta? Crea una aquí</a>
      <a href="/analisis/forgot-password" style="color: #002855; text-decoration: none; font-weight: 500;">¿Olvidaste tu contraseña?</a>
    </div>

    <div class="footer-note">Uso interno — Policía de Investigaciones de Chile</div>
  </form>

  <!-- Overlay Animación Huella (Tema PDI) -->
  <div id="scanner-overlay">
    <img src="/analisis/static/img/pdi-logo.jpg" alt="PDI" class="scanner-logo">
    <div class="scanner-frame">
      <span class="corner top-left"></span>
      <span class="corner top-right"></span>
      <span class="corner bottom-left"></span>
      <span class="corner bottom-right"></span>
      <svg class="fingerprint-svg" viewBox="0 0 24 24" fill="none" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"></path>
        <path d="M12 6c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"></path>
        <path d="M12 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"></path>
      </svg>
      <div class="laser"></div>
    </div>
    <div class="scanner-text" style="text-align: center;">Escaneando Credenciales...</div>
  </div>

  <script>
    const form = document.querySelector('form');
    const overlay = document.getElementById('scanner-overlay');
    const fp = document.querySelector('.fingerprint-svg');
    const text = document.querySelector('.scanner-text');
    const laser = document.querySelector('.laser');

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      overlay.style.display = 'flex';
      
      // Simular tiempo de escaneo biométrico
      setTimeout(() => {
        fp.classList.add('active');
        text.innerHTML = '<span style="color: #FFD700;">IDENTIDAD VERIFICADA</span><br><span style="font-size: 20px; color: #ffffff; display: block; margin-top: 14px; font-weight: 800; animation: none; letter-spacing: 0.05em;">BIENVENIDO AL SISTEMA ABIS</span>';
        laser.style.display = 'none';
        
        // Enviar formulario real tras validación visual
        setTimeout(() => {
          form.submit();
        }, 1600);
      }, 2000);
    });
  </script>
</body>
</html>
