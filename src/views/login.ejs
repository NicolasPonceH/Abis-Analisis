<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <meta name="theme-color" content="#061d38"/>
  <title>Ingresar - ABIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --navy-950: #031323;
      --navy-900: #061d38;
      --navy-800: #0b3158;
      --gold: #ffd100;
      --gold-light: #ffe778;
      --ink: #09233f;
      --muted: #607087;
      --line: rgba(9, 35, 63, 0.14);
      --surface: rgba(255, 255, 255, 0.94);
    }

    * { box-sizing: border-box; }

    html, body { min-height: 100%; }

    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100svh;
      color: var(--ink);
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--navy-950);
      -webkit-font-smoothing: antialiased;
    }

    .login-shell {
      position: relative;
      isolation: isolate;
      min-height: 100vh;
      min-height: 100svh;
      overflow: hidden;
      background:
        linear-gradient(90deg, rgba(2, 15, 29, 0.93) 0%, rgba(3, 19, 35, 0.78) 29%, rgba(3, 19, 35, 0.18) 65%, rgba(3, 19, 35, 0.34) 100%),
        linear-gradient(180deg, rgba(2, 18, 34, 0.08), rgba(2, 18, 34, 0.42)),
        url('https://res.cloudinary.com/dirgawanf/image/upload/v1791467374/fondo_login_abis_uagfhe.png') center center / cover no-repeat;
    }

    .login-shell::before {
      position: absolute;
      inset: 0;
      z-index: -1;
      content: '';
      opacity: 0.2;
      pointer-events: none;
      background-image: linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
      background-size: 54px 54px;
      mask-image: linear-gradient(90deg, black, transparent 76%);
    }

    .login-shell::after {
      position: absolute;
      right: -16vw;
      bottom: -32vw;
      z-index: -1;
      width: 65vw;
      height: 65vw;
      content: '';
      border: 1px solid rgba(255, 209, 0, 0.16);
      border-radius: 50%;
      box-shadow: 0 0 0 36px rgba(255, 209, 0, 0.035), 0 0 0 72px rgba(255, 209, 0, 0.025);
      pointer-events: none;
      animation: ambientOrbit 22s linear infinite;
    }

    .login-layout {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: flex-start;
      gap: clamp(40px, 7vw, 130px);
      width: min(1440px, 100%);
      min-height: 100vh;
      min-height: 100svh;
      margin: 0 auto;
      padding: clamp(24px, 14vh, 132px) clamp(24px, 8vw, 128px);
    }

    .card {
      position: relative;
      flex: 0 1 480px;
      width: 100%;
      padding: 32px 40px;
      overflow: hidden;
      border: 1px solid #D5DFEA;
      border-radius: 24px;
      background: #FFFFFF;
      box-shadow: 0 12px 32px rgba(0, 12, 27, 0.08);
      text-align: left;
      animation: cardIn 800ms cubic-bezier(0.16, 1, 1.3, 1) both;
      min-height: 460px;
    }

    .card::before {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      content: '';
      background: linear-gradient(90deg, #FFD400 0%, #FFD400 60px, transparent 60px);
    }

    .brand-row {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 20px;
    }

    .logo-badge {
      display: flex;
      align-items: center;
      padding-right: 16px;
      border-right: 1px solid #E2E8F0;
    }

    .logo-badge img { display: block; width: auto; height: 38px; }

    .brand-kicker {
      margin: 0 0 2px;
      color: #64748B;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .brand-name {
      margin: 0;
      color: #062B57;
      font-size: 19px;
      font-weight: 900;
      letter-spacing: 0.03em;
    }

    .card-heading {
      margin-bottom: 24px;
    }

    .card-heading::before {
      content: '';
      display: block;
      width: 32px;
      height: 3px;
      background: #1769AA;
      border-radius: 2px;
      margin-bottom: 8px;
    }

    h1 {
      margin: 0 0 4px;
      color: #062B57;
      font-size: 25px;
      font-weight: 800;
      letter-spacing: -0.03em;
    }

    p.subtitle {
      max-width: 320px;
      margin: 0;
      color: #64748B;
      font-size: 13px;
      line-height: 1.5;
    }

    .flash {
      margin-bottom: 18px;
      padding: 11px 13px;
      border: 1px solid rgba(147, 0, 10, 0.12);
      border-radius: 12px;
      background: #fff0ee;
      color: #93000a;
      font-size: 12px;
      line-height: 1.4;
    }

    .field { margin-bottom: 16px; }

    label {
      display: flex;
      align-items: center;
      gap: 6px;
      margin: 0 0 6px;
      color: #64748B;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .input-wrap { position: relative; }

    .input-icon {
      position: absolute;
      top: 50%;
      left: 16px;
      width: 18px;
      height: 18px;
      color: #94A3B8;
      pointer-events: none;
      transform: translateY(-50%);
    }

    input[type="password"], input[type="text"] {
      width: 100%;
      height: 48px;
      margin: 0;
      padding: 0 40px;
      border: 1px solid #D5DFEA;
      border-radius: 12px;
      outline: none;
      background: #F8FAFC;
      color: #062B57;
      font: inherit;
      font-size: 14px;
      font-weight: 500;
      transition: all 0.2s ease;
    }

    input[type="password"]::placeholder, input[type="text"]::placeholder { color: #94A3B8; font-weight: 400; }

    input[type="password"]:focus, input[type="text"]:focus {
      border-color: #003B73;
      background: #FFFFFF;
      box-shadow: 0 0 0 4px rgba(0, 59, 115, 0.1);
    }

    .toggle-password {
      position: absolute;
      top: 50%;
      right: 12px;
      display: grid;
      width: 32px;
      height: 32px;
      padding: 0;
      place-items: center;
      border: 0;
      background: transparent;
      color: #94A3B8;
      cursor: pointer;
      transform: translateY(-50%);
    }

    .toggle-password:hover { color: #062B57; }
    .toggle-password svg { width: 18px; height: 18px; }

    .submit-button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      height: 50px;
      margin-top: 20px;
      border: 0;
      border-radius: 12px;
      background: #003B73;
      box-shadow: 0 6px 16px rgba(0, 59, 115, 0.2);
      color: #FFFFFF;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .submit-button svg { width: 18px; height: 18px; transition: transform 0.2s ease; }
    .submit-button:hover { background: #062B57; box-shadow: 0 12px 24px rgba(0, 59, 115, 0.32); transform: translateY(-2px); }
    .submit-button:hover svg { transform: translateX(3px); }
    .submit-button:active { transform: translateY(0); }
    .submit-button:disabled { cursor: wait; opacity: 0.75; transform: none; }

    .card-links {
      display: flex;
      justify-content: space-between;
      margin-top: 20px;
    }

    .card-links a {
      display: flex;
      align-items: center;
      gap: 6px;
      color: #1769AA;
      font-size: 12px;
      font-weight: 600;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .card-links a:hover { color: #062B57; text-decoration: underline; }

    .footer-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid #E2E8F0;
      color: #64748B;
      font-size: 11px;
      font-weight: 500;
    }

    .login-visual {
      position: relative;
      display: flex;
      flex: 1 1 auto;
      align-items: center;
      justify-content: center;
      min-width: 0;
      min-height: 530px;
      color: #fff;
      pointer-events: none;
      animation: visualIn 1000ms 160ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .visual-copy {
      position: absolute;
      right: 1%;
      bottom: 3%;
      max-width: 310px;
      text-align: right;
      text-shadow: 0 3px 20px rgba(0, 15, 31, 0.62);
    }

    .visual-copy .eyebrow {
      margin: 0 0 8px;
      color: var(--gold-light);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .visual-copy h2 {
      margin: 0;
      font-size: clamp(24px, 3vw, 42px);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.03;
    }

    .visual-copy p { margin: 10px 0 0; color: rgba(255,255,255,0.78); font-size: 12px; line-height: 1.5; }

    .abis-orbit {
      position: relative;
      width: clamp(230px, 27vw, 380px);
      aspect-ratio: 1;
      perspective: 1100px;
      filter: drop-shadow(0 24px 40px rgba(0, 10, 25, 0.34));
      transform: translateY(-7%);
    }

    .orbit-glow {
      position: absolute;
      inset: 19%;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 213, 0, 0.34), rgba(31, 122, 190, 0.1) 42%, transparent 70%);
      filter: blur(18px);
      animation: breathe 3.8s ease-in-out infinite;
    }

    .orbit-ring {
      position: absolute;
      inset: 11%;
      border: 1px solid rgba(255, 224, 93, 0.56);
      border-radius: 50%;
      transform-style: preserve-3d;
      animation: ringSpin 11s linear infinite;
    }

    .orbit-ring::after {
      position: absolute;
      top: 9%;
      left: 50%;
      width: 9px;
      height: 9px;
      content: '';
      border-radius: 50%;
      background: var(--gold);
      box-shadow: 0 0 15px 5px rgba(255, 209, 0, 0.72);
      transform: translateX(-50%);
    }

    .orbit-ring.ring-two { inset: 4%; border-color: rgba(137, 213, 255, 0.34); animation-duration: 15s; animation-direction: reverse; transform: rotateX(67deg) rotateZ(18deg); }
    .orbit-ring.ring-three { inset: 16%; border-color: rgba(255,255,255,0.25); animation-duration: 9s; transform: rotateY(67deg) rotateZ(-18deg); }

    .abis-core {
      position: absolute;
      inset: 25%;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255, 232, 125, 0.72);
      border-radius: 31% 69% 58% 42% / 42% 37% 63% 58%;
      background: linear-gradient(145deg, rgba(21, 103, 158, 0.74), rgba(4, 28, 61, 0.94));
      box-shadow: inset 10px 10px 24px rgba(154, 226, 255, 0.16), inset -14px -15px 28px rgba(0, 0, 0, 0.28), 0 0 30px rgba(56, 170, 221, 0.22);
      transform: rotateX(12deg) rotateY(-18deg) translateZ(20px);
      transform-style: preserve-3d;
      animation: coreFloat 5.5s ease-in-out infinite;
    }

    .abis-core::before, .abis-core::after { position: absolute; content: ''; border-radius: 50%; }
    .abis-core::before { top: 13%; right: 18%; width: 22%; height: 15%; background: rgba(255,255,255,0.34); filter: blur(7px); transform: rotate(-24deg); }
    .abis-core::after { inset: 12%; border: 1px solid rgba(255,255,255,0.14); transform: translateZ(9px); }

    .abis-core span { position: relative; z-index: 1; color: #fff; font-size: clamp(24px, 4vw, 49px); font-weight: 800; letter-spacing: 0.03em; text-shadow: 0 3px 15px rgba(0,0,0,0.38); transform: translateZ(25px); }

    /* Overlay de validación: conserva la animación de acceso, ahora con una escena 3D. */
    #scanner-overlay {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: none;
      place-items: center;
      overflow: hidden;
      background: rgba(2, 17, 34, 0.86);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }

    #scanner-overlay.is-visible { display: grid; animation: overlayIn 350ms ease both; }

    .scanner-scene { display: grid; place-items: center; width: min(92vw, 430px); text-align: center; perspective: 900px; }
    .scanner-brand { margin-bottom: 28px; color: rgba(255,255,255,0.8); font-size: 11px; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; }
    .scanner-stage { position: relative; display: grid; width: 220px; height: 220px; place-items: center; transform-style: preserve-3d; animation: stageFloat 4.4s ease-in-out infinite; }
    .scanner-stage::before, .scanner-stage::after { position: absolute; inset: 9%; content: ''; border: 1px solid rgba(255,209,0,0.45); border-radius: 50%; transform: rotateX(66deg); }
    .scanner-stage::after { inset: 0; border-color: rgba(118, 208, 255, 0.25); transform: rotateY(66deg); }
    .scanner-halo { position: absolute; inset: 16%; border: 1px dashed rgba(255,255,255,0.32); border-radius: 50%; animation: ringSpin 7s linear infinite; }
    .scanner-frame { position: relative; display: grid; width: 145px; height: 145px; place-items: center; overflow: hidden; border: 1px solid rgba(255, 209, 0, 0.55); border-radius: 24px; background: linear-gradient(145deg, rgba(21,87,133,0.68), rgba(1,17,36,0.88)); box-shadow: 0 0 35px rgba(255,209,0,0.12), inset 0 0 25px rgba(0,0,0,0.28); transform: translateZ(34px) rotateX(7deg) rotateY(-9deg); }
    .fingerprint-svg { width: 80px; height: 80px; opacity: 0.42; stroke: #d9e9f5; transition: all 600ms ease-out; }
    .fingerprint-svg.active { stroke: var(--gold); opacity: 1; filter: drop-shadow(0 0 15px rgba(255, 215, 0, 0.85)); transform: scale(1.1); }
    .corner { position: absolute; width: 24px; height: 24px; border-color: var(--gold); border-style: solid; border-width: 0; }
    .top-left { top: 12px; left: 12px; border-top-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; }
    .top-right { top: 12px; right: 12px; border-top-width: 2px; border-right-width: 2px; border-top-right-radius: 5px; }
    .bottom-left { bottom: 12px; left: 12px; border-bottom-width: 2px; border-left-width: 2px; border-bottom-left-radius: 5px; }
    .bottom-right { right: 12px; bottom: 12px; border-right-width: 2px; border-bottom-width: 2px; border-bottom-right-radius: 5px; }
    .laser { position: absolute; top: 0; left: 0; width: 100%; height: 2px; background: var(--gold); box-shadow: 0 0 20px 5px rgba(255, 215, 0, 0.58); animation: scan 1.4s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate; }
    .scanner-text { margin-top: 32px; color: #eaf4fc; font-size: 13px; font-weight: 700; letter-spacing: 0.14em; line-height: 1.6; text-transform: uppercase; animation: textPulse 1s infinite alternate; }

    @keyframes cardIn { from { opacity: 0; transform: translate3d(-24px, 12px, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } }
    @keyframes visualIn { from { opacity: 0; transform: translateX(30px) scale(0.96); } to { opacity: 1; transform: translateX(0) scale(1); } }
    @keyframes breathe { 0%, 100% { opacity: 0.55; transform: scale(0.94); } 50% { opacity: 1; transform: scale(1.08); } }
    @keyframes ringSpin { from { transform: rotateX(58deg) rotateZ(0deg); } to { transform: rotateX(58deg) rotateZ(360deg); } }
    @keyframes coreFloat { 0%, 100% { transform: rotateX(12deg) rotateY(-18deg) translate3d(0, 8px, 20px); } 50% { transform: rotateX(-10deg) rotateY(16deg) translate3d(0, -10px, 34px); } }
    @keyframes stageFloat { 0%, 100% { transform: rotateX(0deg) rotateY(-2deg) translateY(5px); } 50% { transform: rotateX(4deg) rotateY(5deg) translateY(-7px); } }
    @keyframes ambientOrbit { to { transform: rotate(360deg); } }
    @keyframes scan { 0% { top: 0%; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { top: 100%; opacity: 0; } }
    @keyframes textPulse { from { opacity: 0.5; } to { opacity: 1; } }
    @keyframes overlayIn { from { opacity: 0; } to { opacity: 1; } }

    .card:has(.flash) { animation: shakeError 350ms ease-in-out; }
    @keyframes shakeError { 10%, 90% { transform: translateX(-1px); } 20%, 80% { transform: translateX(2px); } 30%, 50%, 70% { transform: translateX(-4px); } 40%, 60% { transform: translateX(4px); } }

    @media (max-width: 900px) {
      .login-shell { background-position: 67% center; }
      .login-shell::before { opacity: 0.1; }
      .login-layout { justify-content: flex-start; padding: 28px; }
      .login-visual { position: absolute; inset: 0; opacity: 0.42; }
      .visual-copy { right: 5%; bottom: 5%; }
      .card { z-index: 2; }
    }

    @media (max-width: 560px) {
      .login-shell { background-position: 64% center; }
      .login-shell::after { right: -50vw; bottom: -30vw; width: 120vw; height: 120vw; }
      .login-layout { align-items: flex-start; padding: 16px; }
      .card { align-self: center; padding: 28px 22px 24px; border-radius: 22px; }
      .brand-row { margin-bottom: 25px; }
      .login-visual { display: none; }
      .card-links { flex-direction: column; align-items: center; gap: 9px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: 1ms !important; animation-iteration-count: 1 !important; transition-duration: 1ms !important; }
    }
  </style>
</head>
<body>
  <main class="login-shell">
    <div class="login-layout">
      <div class="card">
        <!-- Decoraciones geométricas -->
        <svg style="position: absolute; top: 16px; right: 24px; width: 44px; height: 44px; opacity: 0.15;" viewBox="0 0 100 100" aria-hidden="true"><path d="M45 0 L80 0 L35 100 L0 100 Z" fill="#64748B"/><path d="M90 0 L125 0 L80 100 L45 100 Z" fill="#64748B"/></svg>
        <svg style="position: absolute; bottom: 16px; left: 24px; width: 44px; height: 44px; opacity: 0.15;" viewBox="0 0 100 100" aria-hidden="true"><path d="M45 0 L80 0 L35 100 L0 100 Z" fill="#64748B"/><path d="M90 0 L125 0 L80 100 L45 100 Z" fill="#64748B"/></svg>

        <div class="brand-row">
          <div class="logo-badge">
            <img src="/assets/logo-pdi.png" alt="PDI">
          </div>
          <div>
            <p class="brand-kicker">PLATAFORMA INSTITUCIONAL</p>
            <p class="brand-name">SISTEMA ABIS</p>
          </div>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="flash" style="background: #ecfdf5; border-color: #a7f3d0; color: #065f46; margin-bottom: 20px;"><%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="flash" style="margin-bottom: 20px;"><%= error %></div>
        <% } %>

        <!-- VISTA: LOGIN -->
        <div id="view-login">
          <div class="card-heading">
            <h1>Bienvenido</h1>
            <p class="subtitle">Ingresa tus credenciales para acceder al sistema de enrolamiento biométrico.</p>
          </div>

          <form method="post" action="/login" id="form-login">
            <div class="field">
              <label for="username"><i class="fa-solid fa-user"></i> NOMBRE DE USUARIO</label>
              <div class="input-wrap">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/></svg>
                <input type="text" id="username" name="username" placeholder="Ingresa tu usuario" autocomplete="username" required autofocus>
              </div>
            </div>

            <div class="field">
              <label for="password"><i class="fa-solid fa-lock"></i> CONTRASEÑA</label>
              <div class="input-wrap">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <input type="password" id="password" name="password" placeholder="Ingresa tu contraseña" autocomplete="current-password" required>
                <button class="toggle-password" type="button" aria-label="Mostrar contraseña" aria-pressed="false" onclick="togglePasswordVisibility('password', this)">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                </button>
              </div>
            </div>

            <button class="submit-button" type="submit">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
              <span>Ingresar a ABIS</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
            </button>

            <div class="card-links">
              <a href="javascript:void(0)" onclick="switchView('register')"><i class="fa-solid fa-user-plus"></i> Crear una cuenta</a>
              <a href="javascript:void(0)" onclick="switchView('forgot')"><i class="fa-regular fa-circle-question"></i> ¿Olvidaste tu contraseña?</a>
            </div>
          </form>
        </div>

        <!-- VISTA: REGISTRO -->
        <div id="view-register" style="display: none;">
          <div class="card-heading">
            <h1>Crear Cuenta</h1>
            <p class="subtitle">Registra un nuevo operador para acceder al sistema ABIS.</p>
          </div>

          <form method="post" action="/register" id="form-register">
            <div class="field">
              <label for="reg-username">Nuevo usuario</label>
              <div class="input-wrap">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                <input type="text" id="reg-username" name="username" placeholder="Elige un nombre de usuario" required>
              </div>
            </div>

            <div class="field">
              <label for="reg-password">Contraseña Segura</label>
              <div class="input-wrap">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <input type="password" id="reg-password" name="password" placeholder="Mínimo 6 caracteres" required>
                <button class="toggle-password" type="button" aria-label="Mostrar contraseña" aria-pressed="false" onclick="togglePasswordVisibility('reg-password', this)">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                </button>
              </div>
            </div>

            <button class="submit-button" type="submit">
              <span>Registrar Operador</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
            </button>

            <div class="card-links" style="justify-content: center; margin-top: 24px;">
              <a href="javascript:void(0)" onclick="switchView('login')"><i class="fa-solid fa-arrow-left"></i> Volver al inicio de sesión</a>
            </div>
          </form>
        </div>

        <!-- VISTA: RECUPERAR CONTRASEÑA -->
        <div id="view-forgot" style="display: none;">
          <div class="card-heading">
            <h1>Recuperar Acceso</h1>
            <p class="subtitle">Procedimiento institucional de reseteo de credenciales.</p>
          </div>
          
          <div style="background: rgba(0, 35, 76, 0.04); border: 1px solid rgba(0, 35, 76, 0.1); border-left: 4px solid #00234c; padding: 20px; border-radius: 8px; margin-bottom: 30px;">
            <p style="margin: 0; color: #00234c; font-size: 14px; line-height: 1.6; font-weight: 500;">
              Por estrictos protocolos de seguridad de la <strong>Policía de Investigaciones de Chile</strong>, la recuperación de credenciales no es un proceso automatizado. 
              <br><br>
              Debe comunicarse directamente con el <strong>Administrador del Sistema</strong> o su Oficial Superior a cargo para solicitar un reseteo manual de su clave de acceso al Sistema ABIS.
            </p>
          </div>

          <div class="card-links" style="justify-content: center;">
            <button class="submit-button" style="background: #e2e8f0; color: #0f172a; box-shadow: none;" onclick="switchView('login')">
              Entendido, volver atrás
            </button>
          </div>
        </div>

        <div class="footer-note">
          <i class="fa-solid fa-shield-halved"></i> Uso interno – Policía de Investigaciones de Chile
        </div>
      </div>

      <section class="login-visual" aria-hidden="true">
        <div class="abis-orbit">
          <div class="orbit-glow"></div>
          <div class="orbit-ring"></div>
          <div class="orbit-ring ring-two"></div>
          <div class="orbit-ring ring-three"></div>
          <div class="abis-core"><span>ABIS</span></div>
        </div>
        <div class="visual-copy">
          <p class="eyebrow">Plataforma Institucional · PDI</p>
          <h2>Análisis e Inteligencia.</h2>
          <p>Plataforma de enrolamiento y verificación biométrica avanzada para la Policía de Investigaciones de Chile.</p>
        </div>
      </section>
    </div>

    <div id="scanner-overlay" aria-hidden="true">
      <div class="scanner-scene">
        <div class="scanner-brand">ABIS · Autenticación biométrica</div>
        <div class="scanner-stage">
          <div class="scanner-halo"></div>
          <div class="scanner-frame">
            <span class="corner top-left"></span>
            <span class="corner top-right"></span>
            <span class="corner bottom-left"></span>
            <span class="corner bottom-right"></span>
            <svg class="fingerprint-svg" viewBox="0 0 24 24" fill="none" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"></path>
              <path d="M12 6c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"></path>
              <path d="M12 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"></path>
            </svg>
            <div class="laser"></div>
          </div>
        </div>
        <div class="scanner-text">Validando credenciales...</div>
      </div>
    </div>
  </main>

  <script>
    const cardEl = document.querySelector('.card');
    const overlay = document.getElementById('scanner-overlay');
    const fp = document.querySelector('.fingerprint-svg');
    const text = document.querySelector('.scanner-text');
    const laser = document.querySelector('.laser');

    window.togglePasswordVisibility = function(inputId, btn) {
      const input = document.getElementById(inputId);
      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';
      btn.setAttribute('aria-pressed', String(isPassword));
      btn.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
    };

    window.switchView = function(viewName) {
      document.getElementById('view-login').style.display = 'none';
      document.getElementById('view-register').style.display = 'none';
      document.getElementById('view-forgot').style.display = 'none';
      document.getElementById('view-' + viewName).style.display = 'block';
    };

    const formLogin = document.getElementById('form-login');
    formLogin.addEventListener('submit', (event) => {
      event.preventDefault();
      const submitButton = formLogin.querySelector('.submit-button');
      submitButton.disabled = true;
      overlay.classList.add('is-visible');
      overlay.setAttribute('aria-hidden', 'false');

      setTimeout(() => {
        fp.classList.add('active');
        text.innerHTML = '<span style="color: #FFD700;">IDENTIDAD VERIFICADA</span><br><span style="font-size: 18px; color: #ffffff; display: block; margin-top: 12px; font-weight: 800; animation: none; letter-spacing: 0.05em;">BIENVENIDO A ABIS</span>';
        laser.style.display = 'none';

        setTimeout(() => formLogin.submit(), 1600);
      }, 2000);
    });
  </script>
</body>
</html>
