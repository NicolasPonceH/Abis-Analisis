<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <meta name="theme-color" content="#061d38"/>
  <title>Ingresar - ABIS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root {
      --navy-950: #031323;
      --navy-900: #061d38;
      --navy-800: #0b3158;
      --gold: #ffd100;
      --gold-light: #ffe778;
      --ink: #09233f;
      --muted: #607087;
      --line: rgba(9, 35, 63, 0.14);
      --surface: rgba(255, 255, 255, 0.94);
    }

    * { box-sizing: border-box; }

    html, body { min-height: 100%; }

    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100svh;
      color: var(--ink);
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--navy-950);
      -webkit-font-smoothing: antialiased;
    }

    .login-shell {
      position: relative;
      isolation: isolate;
      min-height: 100vh;
      min-height: 100svh;
      overflow: hidden;
      background:
        linear-gradient(90deg, rgba(2, 15, 29, 0.93) 0%, rgba(3, 19, 35, 0.78) 29%, rgba(3, 19, 35, 0.18) 65%, rgba(3, 19, 35, 0.34) 100%),
        linear-gradient(180deg, rgba(2, 18, 34, 0.08), rgba(2, 18, 34, 0.42)),
        url('https://res.cloudinary.com/dirgawanf/image/upload/v1791467374/fondo_login_abis_uagfhe.png') center center / cover no-repeat;
    }

    .login-shell::before {
      position: absolute;
      inset: 0;
      z-index: -1;
      content: '';
      opacity: 0.2;
      pointer-events: none;
      background-image: linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
      background-size: 54px 54px;
      mask-image: linear-gradient(90deg, black, transparent 76%);
    }

    .login-shell::after {
      position: absolute;
      right: -16vw;
      bottom: -32vw;
      z-index: -1;
      width: 65vw;
      height: 65vw;
      content: '';
      border: 1px solid rgba(255, 209, 0, 0.16);
      border-radius: 50%;
      box-shadow: 0 0 0 36px rgba(255, 209, 0, 0.035), 0 0 0 72px rgba(255, 209, 0, 0.025);
      pointer-events: none;
      animation: ambientOrbit 22s linear infinite;
    }

    .login-layout {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: clamp(40px, 7vw, 130px);
      width: min(1440px, 100%);
      min-height: 100vh;
      min-height: 100svh;
      margin: 0 auto;
      padding: clamp(24px, 4vh, 48px) clamp(24px, 8vw, 128px);
    }

    .card {
      position: relative;
      flex: 0 1 480px;
      width: 100%;
      padding: clamp(28px, 4vw, 42px) clamp(24px, 4vw, 36px);
      overflow: hidden;
      border: 1px solid #D5DFEA;
      border-radius: 24px;
      background: #FFFFFF;
      box-shadow: 0 16px 40px rgba(0, 12, 27, 0.08);
      text-align: left;
      animation: cardIn 800ms cubic-bezier(0.16, 1, 1.3, 1) both;
    }

    .card::before {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      content: '';
      background: linear-gradient(90deg, #FFD400 0%, #FFD400 60px, transparent 60px);
    }

    .brand-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }

    .logo-badge {
      display: flex;
      align-items: center;
      padding-right: 12px;
      border-right: 1px solid #D5DFEA;
    }

    .logo-badge img { display: block; width: auto; height: 38px; }

    .brand-kicker {
      margin: 0 0 2px;
      color: #64748B;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .brand-name {
      margin: 0;
      color: #062B57;
      font-size: 19px;
      font-weight: 900;
      letter-spacing: 0.02em;
    }

    .card-heading {
      margin-bottom: 24px;
    }

    .card-heading::before {
      content: '';
      display: block;
      width: 32px;
      height: 3px;
      background: #1769AA;
      border-radius: 2px;
      margin-bottom: 8px;
    }

    h1 {
      margin: 0 0 4px;
      color: #062B57;
      font-size: 26px;
      font-weight: 800;
      letter-spacing: -0.03em;
    }

    p.subtitle {
      max-width: 320px;
      margin: 0;
      color: #64748B;
      font-size: 13px;
      line-height: 1.4;
    }

    .flash {
      margin-bottom: 18px;
      padding: 11px 13px;
      border: 1px solid rgba(147, 0, 10, 0.12);
      border-radius: 12px;
      background: #fff0ee;
      color: #93000a;
      font-size: 12px;
      line-height: 1.4;
    }

    .field { margin-bottom: 16px; }

    label {
      display: flex;
      align-items: center;
      gap: 6px;
      margin: 0 0 6px;
      color: #64748B;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .input-wrap { position: relative; }

    .input-icon {
      position: absolute;
      top: 50%;
      left: 16px;
      width: 18px;
      height: 18px;
      color: #94A3B8;
      pointer-events: none;
      transform: translateY(-50%);
    }

    input[type="password"], input[type="text"] {
      width: 100%;
      height: 52px;
      margin: 0;
      padding: 0 44px;
      border: 1px solid #D5DFEA;
      border-radius: 12px;
      outline: none;
      background: #F8FAFC;
      color: #062B57;
      font: inherit;
      font-size: 14px;
      font-weight: 500;
      transition: all 0.2s ease;
    }

    input[type="password"]::placeholder, input[type="text"]::placeholder { color: #94A3B8; font-weight: 400; }

    input[type="password"]:focus, input[type="text"]:focus {
      border-color: #003B73;
      background: #FFFFFF;
      box-shadow: 0 0 0 4px rgba(0, 59, 115, 0.1);
    }

    .toggle-password {
      position: absolute;
      top: 50%;
      right: 12px;
      display: grid;
      width: 32px;
      height: 32px;
      padding: 0;
      place-items: center;
      border: 0;
      background: transparent;
      color: #94A3B8;
      cursor: pointer;
      transform: translateY(-50%);
    }

    .toggle-password:hover { color: #062B57; }
    .toggle-password svg { width: 18px; height: 18px; }

    .submit-button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      height: 48px;
      margin-top: 20px;
      border: 0;
      border-radius: 12px;
      background: #003B73;
      box-shadow: 0 4px 12px rgba(0, 59, 115, 0.16);
      color: #FFD400;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .submit-button svg { width: 18px; height: 18px; transition: transform 0.2s ease; color: #FFD400; }
    .submit-button:hover { background: #062B57; box-shadow: 0 8px 16px rgba(0, 59, 115, 0.24); transform: translateY(-2px); }
    .submit-button:hover svg:last-child { transform: translateX(3px); }
    .submit-button:active { transform: translateY(0); }
    .submit-button:disabled { cursor: wait; opacity: 0.75; transform: none; }

    .card-links {
      display: flex;
      justify-content: space-between;
      margin-top: 16px;
    }

    .card-links a {
      display: flex;
      align-items: center;
      gap: 4px;
      color: #1769AA;
      font-size: 12px;
      font-weight: 500;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .card-links a:hover { color: #062B57; }

    .footer-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid #E2E8F0;
      color: #64748B;
      font-size: 11px;
      font-weight: 500;
    }

    .login-visual {
      position: relative;
      display: flex;
      flex: 1 1 auto;
      align-items: center;
      justify-content: center;
      min-width: 0;
      min-height: 530px;
      color: #fff;
      pointer-events: none;
      animation: visualIn 1000ms 160ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .visual-copy {
      position: absolute;
      right: -30%;
      bottom: -6%;
      width: min(390px, 31vw);
      max-width: 390px;
      text-align: right;
      text-shadow: 0 3px 20px rgba(0, 15, 31, 0.62);
    }

    .visual-copy .eyebrow {
      margin: 0 0 10px;
      color: var(--gold-light);
      font-size: 10.5px;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }

    .visual-copy .eyebrow i {
      color: var(--gold);
      font-size: 11px;
    }

    .visual-copy h2 {
      margin: 0;
      font-size: clamp(26px, 3.2vw, 44px);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.08;
      color: #ffffff;
      text-shadow: 0 2px 14px rgba(0, 15, 31, 0.7);
    }

    .visual-copy p {
      margin: 12px 0 0;
      color: rgba(255, 255, 255, 0.88);
      font-size: 12.5px;
      line-height: 1.55;
    }

    .abis-orbit {
      position: relative;
      width: clamp(230px, 27vw, 380px);
      aspect-ratio: 1;
      perspective: 1100px;
      filter: drop-shadow(0 24px 40px rgba(0, 10, 25, 0.34));
      transform: translateY(-7%);
      transform-style: preserve-3d;
      isolation: isolate;
      animation: sceneFloat 8s ease-in-out infinite;
    }

    .abis-orbit::before {
      position: absolute;
      inset: 22%;
      content: '';
      border: 1px solid rgba(104, 203, 255, 0.16);
      border-radius: 50%;
      box-shadow: 0 0 45px rgba(51, 166, 235, 0.15), inset 0 0 35px rgba(50, 162, 226, 0.12);
      transform: translateZ(-35px) rotateX(68deg) rotateY(-14deg);
      animation: innerPulse 4.5s ease-in-out infinite;
    }

    .abis-orbit::after {
      position: absolute;
      inset: 7%;
      content: '';
      border: 1px solid rgba(255, 215, 0, 0.11);
      border-radius: 50%;
      transform: translateZ(-70px) rotateX(72deg) rotateZ(24deg);
      animation: ringDrift 18s linear infinite reverse;
    }

    .orbit-grid {
      position: absolute;
      inset: 3%;
      border-radius: 50%;
      opacity: 0.42;
      background: repeating-radial-gradient(circle at center, transparent 0 17px, rgba(123, 208, 255, 0.11) 18px 19px, transparent 20px 34px);
      -webkit-mask-image: radial-gradient(circle, #000 0 58%, transparent 78%);
      mask-image: radial-gradient(circle, #000 0 58%, transparent 78%);
      transform: translateZ(-84px) rotateX(66deg) rotateZ(-12deg);
      animation: gridPulse 6s ease-in-out infinite;
    }

    .orbit-glow {
      position: absolute;
      inset: 19%;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 213, 0, 0.44), rgba(31, 122, 190, 0.18) 34%, rgba(0, 99, 177, 0.08) 52%, transparent 72%);
      filter: blur(22px);
      transform: translateZ(-20px);
      animation: breathe 3.8s ease-in-out infinite, glowColor 8s ease-in-out infinite;
    }

    .orbit-plane {
      position: absolute;
      inset: 8%;
      border: 1px solid rgba(168, 226, 255, 0.36);
      border-radius: 50%;
      transform-style: preserve-3d;
      box-shadow: 0 0 22px rgba(74, 186, 255, 0.14);
    }

    .plane-one { transform: rotateX(70deg) rotateZ(8deg) translateZ(8px); animation: planeOne 12s linear infinite; }
    .plane-two { inset: 14%; border-color: rgba(255, 215, 0, 0.32); transform: rotateY(70deg) rotateZ(-20deg) translateZ(17px); animation: planeTwo 15s linear infinite reverse; }
    .plane-three { inset: 1%; border-color: rgba(255, 255, 255, 0.15); transform: rotateX(54deg) rotateY(26deg) rotateZ(38deg) translateZ(-18px); animation: planeThree 20s linear infinite; }

    .orbit-ring {
      position: absolute;
      inset: 11%;
      border: 1px solid rgba(255, 224, 93, 0.56);
      border-radius: 50%;
      transform-style: preserve-3d;
      animation: ringSpin 11s linear infinite;
    }

    .orbit-ring::after {
      position: absolute;
      top: 9%;
      left: 50%;
      width: 9px;
      height: 9px;
      content: '';
      border-radius: 50%;
      background: var(--gold);
      box-shadow: 0 0 15px 5px rgba(255, 209, 0, 0.72);
      transform: translateX(-50%);
    }

    .orbit-ring.ring-two { inset: 4%; border-color: rgba(137, 213, 255, 0.34); animation-duration: 15s; animation-direction: reverse; transform: rotateX(67deg) rotateZ(18deg); }
    .orbit-ring.ring-three { inset: 16%; border-color: rgba(255,255,255,0.25); animation-duration: 9s; transform: rotateY(67deg) rotateZ(-18deg); }

    .orbit-particle {
      position: absolute;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #9ee7ff;
      box-shadow: 0 0 8px 3px rgba(91, 207, 255, 0.78);
      transform-style: preserve-3d;
    }

    .particle-one { top: 15%; left: 25%; animation: particleOne 7s ease-in-out infinite; }
    .particle-two { top: 30%; right: 10%; width: 4px; height: 4px; background: var(--gold); box-shadow: 0 0 10px 4px rgba(255, 215, 0, 0.7); animation: particleTwo 8s ease-in-out infinite 0.8s; }
    .particle-three { bottom: 16%; left: 14%; width: 4px; height: 4px; animation: particleThree 9s ease-in-out infinite 1.3s; }
    .particle-four { right: 24%; bottom: 10%; width: 7px; height: 7px; background: #fff; box-shadow: 0 0 10px 3px rgba(255, 255, 255, 0.65); animation: particleFour 6s ease-in-out infinite 0.4s; }

    .orbit-metric {
      position: absolute;
      z-index: 5;
      display: grid;
      gap: 2px;
      min-width: 82px;
      padding: 7px 9px;
      border: 1px solid rgba(122, 212, 255, 0.32);
      border-radius: 7px;
      background: linear-gradient(135deg, rgba(5, 35, 67, 0.68), rgba(8, 78, 123, 0.24));
      box-shadow: 0 10px 28px rgba(0, 11, 30, 0.2), inset 0 0 15px rgba(104, 209, 255, 0.08);
      color: rgba(224, 247, 255, 0.68);
      font-size: 7px;
      font-weight: 800;
      letter-spacing: 0.13em;
      line-height: 1.2;
      text-align: left;
      transform: translateZ(48px);
      animation: metricFloat 5s ease-in-out infinite;
    }

    .orbit-metric strong { color: #9fe7ff; font-size: 10px; letter-spacing: 0.08em; }
    .metric-one { top: 11%; right: -4%; }
    .metric-two { bottom: 17%; left: -8%; animation-delay: -2.2s; }

    .telegram-signal,
    .fingerprint-orbit {
      position: absolute;
      z-index: 6;
      display: grid;
      place-items: center;
      color: #9fe7ff;
      filter: drop-shadow(0 0 10px rgba(80, 205, 255, 0.52));
      transform-style: preserve-3d;
    }

    .telegram-signal {
      width: 48px;
      height: 48px;
      border: 1px solid rgba(100, 210, 255, 0.42);
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, rgba(84, 201, 255, 0.32), rgba(1, 42, 78, 0.66));
      box-shadow: 0 0 0 7px rgba(65, 183, 239, 0.05), inset 0 0 16px rgba(120, 222, 255, 0.13);
      top: 50%;
      left: 50%;
      margin: -24px;
      animation: telegramOrbit 12s linear infinite;
    }

    .telegram-signal svg { width: 24px; height: 24px; transform: translateZ(15px) rotate(-7deg); }
    .fingerprint-orbit {
      top: 50%;
      left: 50%;
      margin: -29px;
      width: 58px;
      height: 58px;
      color: #ffd95a;
      filter: drop-shadow(0 0 12px rgba(255, 211, 42, 0.52));
      animation: fingerprintOrbit 15s linear infinite reverse -1.7s;
    }

    .fingerprint-orbit::before { position: absolute; inset: 0; content: ''; border: 1px dashed rgba(255, 216, 78, 0.55); border-radius: 50%; animation: fingerprintSpin 8s linear infinite; }
    .fingerprint-orbit svg { width: 40px; height: 40px; transform: translateZ(18px); }

    .abis-core {
      position: absolute;
      inset: 25%;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255, 232, 125, 0.72);
      border-radius: 31% 69% 58% 42% / 42% 37% 63% 58%;
      background: linear-gradient(145deg, rgba(21, 103, 158, 0.74), rgba(4, 28, 61, 0.94));
      box-shadow: inset 10px 10px 24px rgba(154, 226, 255, 0.16), inset -14px -15px 28px rgba(0, 0, 0, 0.28), 0 0 30px rgba(56, 170, 221, 0.22), 0 0 75px rgba(45, 171, 242, 0.2);
      transform: rotateX(12deg) rotateY(-18deg) translateZ(20px);
      transform-style: preserve-3d;
      animation: coreFloat 5.5s ease-in-out infinite;
    }

    .abis-core::before, .abis-core::after { position: absolute; content: ''; border-radius: 50%; }
    .abis-core::before { top: 13%; right: 18%; width: 22%; height: 15%; background: rgba(255,255,255,0.34); filter: blur(7px); transform: rotate(-24deg); }
    .abis-core::after { inset: 12%; border: 1px solid rgba(255,255,255,0.14); transform: translateZ(9px); }

    .abis-core span { position: relative; z-index: 1; color: #fff; font-size: clamp(24px, 4vw, 49px); font-weight: 800; letter-spacing: 0.03em; text-shadow: 0 3px 15px rgba(0,0,0,0.38), 0 0 18px rgba(130, 220, 255, 0.35); transform: translateZ(25px); }
    .abis-core small { position: absolute; z-index: 2; bottom: 20%; color: rgba(202, 240, 255, 0.68); font-size: clamp(5px, 0.55vw, 8px); font-weight: 700; letter-spacing: 0.18em; transform: translateZ(28px); white-space: nowrap; }

    /* Overlay de validación: conserva la animación de acceso, ahora con una escena 3D. */
    #scanner-overlay {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: none;
      place-items: center;
      overflow: hidden;
      background: rgba(2, 17, 34, 0.86);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }

    #scanner-overlay.is-visible { display: grid; animation: overlayIn 350ms ease both; }

    .scanner-scene { display: grid; place-items: center; width: min(92vw, 430px); text-align: center; perspective: 900px; }
    .scanner-brand { margin-bottom: 28px; color: rgba(255,255,255,0.8); font-size: 11px; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; }
    .scanner-stage { position: relative; display: grid; width: 270px; height: 270px; place-items: center; transform-style: preserve-3d; animation: stageFloat 4.4s ease-in-out infinite; }
    .scanner-stage::before, .scanner-stage::after { position: absolute; inset: 9%; content: ''; border: 1px solid rgba(255,209,0,0.45); border-radius: 50%; transform: rotateX(66deg); }
    .scanner-stage::after { inset: 0; border-color: rgba(118, 208, 255, 0.25); transform: rotateY(66deg); }
    .scanner-halo { position: absolute; inset: 16%; border: 1px dashed rgba(255,255,255,0.32); border-radius: 50%; animation: ringSpin 7s linear infinite; }
    .scanner-scan-grid { position: absolute; inset: 7%; border: 1px solid rgba(113, 213, 255, 0.18); border-radius: 50%; background: repeating-radial-gradient(circle, transparent 0 18px, rgba(102, 204, 255, 0.08) 19px 20px); transform: rotateX(65deg) translateZ(-17px); animation: gridScan 5s ease-in-out infinite; }
    .scanner-particle { position: absolute; width: 5px; height: 5px; border-radius: 50%; background: #9ce9ff; box-shadow: 0 0 12px 4px rgba(76, 207, 255, 0.75); }
    .scan-particle-one { top: 19%; left: 13%; animation: scanParticleOne 3.8s ease-in-out infinite; }
    .scan-particle-two { right: 10%; bottom: 20%; background: var(--gold); box-shadow: 0 0 12px 4px rgba(255, 215, 0, 0.7); animation: scanParticleTwo 4.4s ease-in-out infinite -1.2s; }
    .scan-particle-three { top: 34%; right: 4%; width: 3px; height: 3px; animation: scanParticleThree 5s ease-in-out infinite -2s; }
    .scanner-frame { position: relative; display: grid; width: 190px; height: 208px; place-items: center; overflow: hidden; border: 1px solid rgba(255, 209, 0, 0.55); border-radius: 30px; background: linear-gradient(145deg, rgba(21,87,133,0.68), rgba(1,17,36,0.88)); box-shadow: 0 0 35px rgba(255,209,0,0.12), inset 0 0 25px rgba(0,0,0,0.28); transform: translateZ(34px) rotateX(7deg) rotateY(-9deg); }
    .fingerprint-icon { display: block; width: 158px; height: 178px; color: #a8b3bf; font-family: 'Material Symbols Outlined'; font-size: 158px; font-style: normal; font-weight: 400; line-height: 178px; text-align: center; white-space: nowrap; font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 48; opacity: 0.88; transition: color 600ms ease-out, opacity 600ms ease-out, filter 600ms ease-out, transform 600ms ease-out; filter: drop-shadow(0 0 8px rgba(168, 179, 191, 0.36)); animation: fingerprintGlow 2.4s ease-in-out infinite; }
    .fingerprint-icon.active { color: #9affd3; opacity: 1; filter: drop-shadow(0 0 15px rgba(65, 239, 174, 0.95)); transform: scale(1.1); animation: fingerprintVerifiedGlow 700ms ease-out forwards; }
    .corner { position: absolute; width: 24px; height: 24px; border-color: var(--gold); border-style: solid; border-width: 0; }
    .top-left { top: 12px; left: 12px; border-top-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; }
    .top-right { top: 12px; right: 12px; border-top-width: 2px; border-right-width: 2px; border-top-right-radius: 5px; }
    .bottom-left { bottom: 12px; left: 12px; border-bottom-width: 2px; border-left-width: 2px; border-bottom-left-radius: 5px; }
    .bottom-right { right: 12px; bottom: 12px; border-right-width: 2px; border-bottom-width: 2px; border-bottom-right-radius: 5px; }
    .laser { position: absolute; top: 0; left: 0; width: 100%; height: 2px; background: var(--gold); box-shadow: 0 0 20px 5px rgba(255, 215, 0, 0.58); animation: scan 1.4s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate; }
    .scanner-text { margin-top: 32px; color: #eaf4fc; font-size: 13px; font-weight: 700; letter-spacing: 0.14em; line-height: 1.6; text-transform: uppercase; animation: textPulse 1s infinite alternate; }
    .scanner-status-row { display: flex; align-items: center; gap: 8px; width: min(100%, 310px); margin-top: 18px; color: rgba(187, 226, 244, 0.76); font-size: 8px; font-weight: 800; letter-spacing: 0.12em; text-align: left; }
    .scanner-status-dot { width: 7px; height: 7px; flex: 0 0 auto; border-radius: 50%; background: #43d9a0; box-shadow: 0 0 10px #43d9a0; animation: statusBlink 1.2s ease-in-out infinite; }
    .scanner-status { flex: 1; }
    .scanner-status-code { color: rgba(255, 216, 91, 0.74); font-size: 7px; }
    .scanner-progress { position: relative; width: min(100%, 310px); height: 5px; margin-top: 10px; overflow: hidden; border: 1px solid rgba(112, 208, 255, 0.25); border-radius: 99px; background: rgba(102, 188, 229, 0.12); box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.28); }
    .scanner-progress-fill { display: block; width: 0; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #22a9e8, #ffd32f, #fff0a0); box-shadow: 0 0 12px rgba(255, 215, 0, 0.72); transition: width 450ms cubic-bezier(0.22, 1, 0.36, 1); }
    #scanner-overlay.is-verified .scanner-frame { border-color: rgba(72, 231, 168, 0.88); box-shadow: 0 0 40px rgba(72, 231, 168, 0.26), inset 0 0 25px rgba(0,0,0,0.28); }
    #scanner-overlay.is-verified .scanner-status-dot { background: #54f0ad; box-shadow: 0 0 12px #54f0ad; }

    @keyframes cardIn { from { opacity: 0; transform: translate3d(-24px, 12px, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } }
    @keyframes visualIn { from { opacity: 0; transform: translateX(30px) scale(0.96); } to { opacity: 1; transform: translateX(0) scale(1); } }
    @keyframes breathe { 0%, 100% { opacity: 0.55; transform: scale(0.94); } 50% { opacity: 1; transform: scale(1.08); } }
    @keyframes sceneFloat { 0%, 100% { transform: translateY(-7%) rotateX(0deg) rotateY(0deg); } 50% { transform: translateY(-10%) rotateX(1.5deg) rotateY(-2deg); } }
    @keyframes innerPulse { 0%, 100% { opacity: 0.45; transform: translateZ(-35px) rotateX(68deg) rotateY(-14deg) scale(0.94); } 50% { opacity: 1; transform: translateZ(-35px) rotateX(68deg) rotateY(-14deg) scale(1.06); } }
    @keyframes ringDrift { to { transform: translateZ(-70px) rotateX(72deg) rotateZ(384deg); } }
    @keyframes gridPulse { 0%, 100% { opacity: 0.22; } 50% { opacity: 0.52; } }
    @keyframes glowColor { 0%, 100% { filter: blur(22px) hue-rotate(0deg); } 50% { filter: blur(25px) hue-rotate(18deg); } }
    @keyframes planeOne { to { transform: rotateX(70deg) rotateZ(368deg) translateZ(8px); } }
    @keyframes planeTwo { to { transform: rotateY(70deg) rotateZ(-380deg) translateZ(17px); } }
    @keyframes planeThree { to { transform: rotateX(414deg) rotateY(26deg) rotateZ(38deg) translateZ(-18px); } }
    @keyframes metricFloat { 0%, 100% { opacity: 0.72; transform: translate3d(0, 5px, 48px); } 50% { opacity: 1; transform: translate3d(0, -5px, 58px); } }
    @keyframes particleOne { 0%, 100% { transform: translate3d(0, 0, 35px) scale(0.8); opacity: 0.45; } 50% { transform: translate3d(34px, 17px, 75px) scale(1.35); opacity: 1; } }
    @keyframes particleTwo { 0%, 100% { transform: translate3d(0, 0, 20px); opacity: 0.35; } 50% { transform: translate3d(-24px, 33px, 72px); opacity: 1; } }
    @keyframes particleThree { 0%, 100% { transform: translate3d(0, 0, 42px); opacity: 0.3; } 50% { transform: translate3d(42px, -28px, 80px); opacity: 0.95; } }
    @keyframes particleFour { 0%, 100% { transform: translate3d(0, 0, 25px) scale(0.7); opacity: 0.3; } 50% { transform: translate3d(-28px, -30px, 68px) scale(1.2); opacity: 1; } }
    @keyframes telegramOrbit { from { transform: rotate(0deg) translateX(clamp(105px, 14vw, 150px)) rotate(-7deg) translateZ(42px); } to { transform: rotate(360deg) translateX(clamp(105px, 14vw, 150px)) rotate(-7deg) translateZ(42px); } }
    @keyframes fingerprintOrbit { from { transform: rotate(180deg) translateX(clamp(112px, 15vw, 160px)) rotate(-180deg) translateZ(55px); } to { transform: rotate(-180deg) translateX(clamp(112px, 15vw, 160px)) rotate(180deg) translateZ(55px); } }
    @keyframes fingerprintSpin { to { transform: rotate(360deg); } }
    @keyframes gridScan { 0%, 100% { opacity: 0.28; transform: rotateX(65deg) translateZ(-17px) scale(0.92); } 50% { opacity: 0.72; transform: rotateX(65deg) translateZ(-17px) scale(1.06); } }
    @keyframes scanParticleOne { 0%, 100% { transform: translate3d(0, 0, 22px); opacity: 0.25; } 50% { transform: translate3d(30px, 45px, 65px); opacity: 1; } }
    @keyframes scanParticleTwo { 0%, 100% { transform: translate3d(0, 0, 22px); opacity: 0.3; } 50% { transform: translate3d(-45px, -38px, 70px); opacity: 1; } }
    @keyframes scanParticleThree { 0%, 100% { transform: translate3d(0, 0, 22px); opacity: 0.2; } 50% { transform: translate3d(-26px, 30px, 60px); opacity: 0.95; } }
    @keyframes statusBlink { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
    @keyframes fingerprintGlow { 0%, 100% { opacity: 0.68; filter: drop-shadow(0 0 6px rgba(168, 179, 191, 0.24)); } 50% { opacity: 1; filter: drop-shadow(0 0 16px rgba(190, 204, 216, 0.62)); } }
    @keyframes fingerprintVerifiedGlow { from { opacity: 0.85; filter: drop-shadow(0 0 8px rgba(65, 239, 174, 0.55)); } to { opacity: 1; filter: drop-shadow(0 0 20px rgba(65, 239, 174, 1)); } }
    @keyframes ringSpin { from { transform: rotateX(58deg) rotateZ(0deg); } to { transform: rotateX(58deg) rotateZ(360deg); } }
    @keyframes coreFloat { 0%, 100% { transform: rotateX(12deg) rotateY(-18deg) translate3d(0, 8px, 20px); } 50% { transform: rotateX(-10deg) rotateY(16deg) translate3d(0, -10px, 34px); } }
    @keyframes stageFloat { 0%, 100% { transform: rotateX(0deg) rotateY(-2deg) translateY(5px); } 50% { transform: rotateX(4deg) rotateY(5deg) translateY(-7px); } }
    @keyframes ambientOrbit { to { transform: rotate(360deg); } }
    @keyframes scan { 0% { top: 0%; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { top: 100%; opacity: 0; } }
    @keyframes textPulse { from { opacity: 0.5; } to { opacity: 1; } }
    @keyframes overlayIn { from { opacity: 0; } to { opacity: 1; } }

    .card:has(.flash) { animation: shakeError 350ms ease-in-out; }
    @keyframes shakeError { 10%, 90% { transform: translateX(-1px); } 20%, 80% { transform: translateX(2px); } 30%, 50%, 70% { transform: translateX(-4px); } 40%, 60% { transform: translateX(4px); } }

    @media (max-width: 900px) {
      .login-shell { background-position: 67% center; }
      .login-shell::before { opacity: 0.1; }
      .login-layout { justify-content: flex-start; padding: 28px; }
      .login-visual { position: absolute; inset: 0; opacity: 0.42; }
      .visual-copy { right: -25%; bottom: -2%; width: min(420px, 72vw); max-width: 420px; }
      .card { z-index: 2; }
    }

    @media (max-width: 560px) {
      .login-shell { background-position: 64% center; }
      .login-shell::after { right: -50vw; bottom: -30vw; width: 120vw; height: 120vw; }
      .login-layout { align-items: flex-start; padding: 16px; }
      .card { align-self: center; padding: 28px 22px 24px; border-radius: 22px; }
      .brand-row { margin-bottom: 25px; }
      .login-visual { display: none; }
      .card-links { flex-direction: column; align-items: center; gap: 9px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .abis-orbit,
      .orbit-glow,
      .orbit-plane,
      .orbit-particle,
      .orbit-metric,
      .abis-core,
      .orbit-grid,
      .abis-orbit::before,
      .abis-orbit::after {
        animation: none !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: 1ms !important; animation-iteration-count: 1 !important; transition-duration: 1ms !important; }
    }
  </style>
</head>
<body>
  <main class="login-shell">
    <div class="login-layout">
      <div class="card">
        <!-- Decoraciones geométricas -->
        <svg style="position: absolute; top: 16px; right: 24px; width: 44px; height: 44px; opacity: 0.15;" viewBox="0 0 130 100" aria-hidden="true"><path d="M45 0 L80 0 L35 100 L0 100 Z" fill="#64748B"/><path d="M90 0 L125 0 L80 100 L45 100 Z" fill="#64748B"/></svg>
        <svg style="position: absolute; bottom: 16px; left: 24px; width: 44px; height: 44px; opacity: 0.15;" viewBox="0 0 130 100" aria-hidden="true"><path d="M45 0 L80 0 L35 100 L0 100 Z" fill="#64748B"/><path d="M90 0 L125 0 L80 100 L45 100 Z" fill="#64748B"/></svg>

        <div class="brand-row">
          <div class="logo-badge">
            <img src="/assets/logo-pdi.png" alt="PDI">
          </div>
          <div>
            <p class="brand-kicker">PLATAFORMA INSTITUCIONAL</p>
            <p class="brand-name">SISTEMA ABIS</p>
          </div>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="flash" style="background: #ecfdf5; border-color: #a7f3d0; color: #065f46; margin-bottom: 20px;"><%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="flash" style="margin-bottom: 20px;"><%= error %></div>
        <% } %>

        <!-- VISTA: LOGIN -->
        <div id="view-login">
          <div class="card-heading">
            <h1>Bienvenido</h1>
            <p class="subtitle">Ingresa tus credenciales para acceder a la plataforma de monitoreo y enrolamiento biométrico.</p>
          </div>

          <form method="post" action="/login" id="form-login">
            <div class="field">
              <label for="username"><i class="fa-solid fa-user"></i> NOMBRE DE USUARIO</label>
              <div class="input-wrap">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/></svg>
                <input type="text" id="username" name="username" placeholder="Ingresa tu usuario" autocomplete="username" required autofocus>
              </div>
            </div>

            <div class="field">
              <label for="password"><i class="fa-solid fa-lock"></i> CONTRASEÑA</label>
              <div class="input-wrap">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <input type="password" id="password" name="password" placeholder="Ingresa tu contraseña" autocomplete="current-password" required>
                <button class="toggle-password" type="button" aria-label="Mostrar contraseña" aria-pressed="false" onclick="togglePasswordVisibility('password', this)">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                </button>
              </div>
            </div>

            <button class="submit-button" type="submit">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
              <span>Ingresar a ABIS</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
            </button>

            <div class="card-links">
              <a href="javascript:void(0)" onclick="switchView('register')"><i class="fa-solid fa-user-plus"></i> Crear una cuenta</a>
              <a href="javascript:void(0)" onclick="switchView('forgot')"><i class="fa-regular fa-circle-question"></i> ¿Olvidaste tu contraseña?</a>
            </div>
          </form>
        </div>

        <!-- VISTA: REGISTRO -->
        <div id="view-register" style="display: none;">
          <div class="card-heading">
            <h1>Crear Cuenta</h1>
            <p class="subtitle">Registra un nuevo operador para acceder al sistema ABIS.</p>
          </div>

          <form method="post" action="/register" id="form-register">
            <div class="field">
              <label for="reg-username">Nuevo usuario</label>
              <div class="input-wrap">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                <input type="text" id="reg-username" name="username" placeholder="Elige un nombre de usuario" required>
              </div>
            </div>

            <div class="field">
              <label for="reg-password">Contraseña Segura</label>
              <div class="input-wrap">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <input type="password" id="reg-password" name="password" placeholder="Mínimo 6 caracteres" required>
                <button class="toggle-password" type="button" aria-label="Mostrar contraseña" aria-pressed="false" onclick="togglePasswordVisibility('reg-password', this)">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                </button>
              </div>
            </div>

            <button class="submit-button" type="submit">
              <span>Registrar Operador</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
            </button>

            <div class="card-links" style="justify-content: center; margin-top: 24px;">
              <a href="javascript:void(0)" onclick="switchView('login')"><i class="fa-solid fa-arrow-left"></i> Volver al inicio de sesión</a>
            </div>
          </form>
        </div>

        <!-- VISTA: RECUPERAR CONTRASEÑA -->
        <div id="view-forgot" style="display: none;">
          <div class="card-heading">
            <h1>Recuperar Acceso</h1>
            <p class="subtitle">Procedimiento institucional de reseteo de credenciales.</p>
          </div>
          
          <div style="background: rgba(0, 35, 76, 0.04); border: 1px solid rgba(0, 35, 76, 0.1); border-left: 4px solid #00234c; padding: 20px; border-radius: 8px; margin-bottom: 30px;">
            <p style="margin: 0; color: #00234c; font-size: 14px; line-height: 1.6; font-weight: 500;">
              Por estrictos protocolos de seguridad de la <strong>Policía de Investigaciones de Chile</strong>, la recuperación de credenciales no es un proceso automatizado. 
              <br><br>
              Debe comunicarse directamente con el <strong>Administrador del Sistema</strong> o su Oficial Superior a cargo para solicitar un reseteo manual de su clave de acceso al Sistema ABIS.
            </p>
          </div>

          <div class="card-links" style="justify-content: center;">
            <button class="submit-button" style="background: #FFD400; color: #003B73; box-shadow: none;" onclick="switchView('login')">
              Entendido, volver atrás
            </button>
          </div>
        </div>

        <div class="footer-note">
          <i class="fa-solid fa-shield-halved"></i> Uso interno – Policía de Investigaciones de Chile
        </div>
      </div>

      <section class="login-visual" aria-hidden="true">
        <div class="abis-orbit">
          <div class="orbit-grid"></div>
          <div class="orbit-glow"></div>
          <div class="orbit-plane plane-one"></div>
          <div class="orbit-plane plane-two"></div>
          <div class="orbit-plane plane-three"></div>
          <div class="orbit-ring"></div>
          <div class="orbit-ring ring-two"></div>
          <div class="orbit-ring ring-three"></div>
          <div class="orbit-particle particle-one"></div>
          <div class="orbit-particle particle-two"></div>
          <div class="orbit-particle particle-three"></div>
          <div class="orbit-particle particle-four"></div>
          <div class="telegram-signal" aria-label="Telegram conectado">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M21.5 3.4 18.2 20c-.25 1.17-.9 1.46-1.82.91l-5.03-3.7-2.43 2.34c-.27.27-.5.5-1.02.5l.36-5.12 9.32-8.42c.41-.36-.09-.56-.64-.2L5.43 13.24.47 11.7c-1.08-.34-1.1-1.08.23-1.6L20.08 2.5c.91-.34 1.71.2 1.42.9Z" fill="currentColor"/>
            </svg>
          </div>
          <div class="fingerprint-orbit" aria-label="Huella biométrica activa">
            <svg viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <path d="M32 8a21 21 0 0 0-21 21c0 7.1 2.1 11.7 3.8 15.4M32 14a15 15 0 0 0-15 15c0 5.5 1.4 8.8 2.7 12.1M32 20a9 9 0 0 0-9 9c0 4.9 1.1 7.4 2 10.1M32 26a3 3 0 0 0-3 3c0 5.8 1.1 9.5 3.1 13.7M32 8a21 21 0 0 1 21 21c0 7.1-2.1 11.7-3.8 15.4M32 14a15 15 0 0 1 15 15c0 5.5-1.4 8.8-2.7 12.1M32 20a9 9 0 0 1 9 9c0 4.9-1.1 7.4-2 10.1M32 26a3 3 0 0 1 3 3c0 5.8-1.1 9.5-3.1 13.7M21 48c3.2 4 6.9 6 11 6s7.8-2 11-6M17 52c4.3 3.2 9.3 4.8 15 4.8s10.7-1.6 15-4.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="abis-core">
            <span>ABIS</span>
            <small>BIOMETRIC INTELLIGENCE</small>
          </div>
        </div>
        <div class="visual-copy">
          <p class="eyebrow"><i class="fa-solid fa-satellite-dish"></i> Monitoreo & Automatización · PDI Chile</p>
          <h2>Monitoreo y Automatización.</h2>
          <p>Supervisión continua en tiempo real de enrolamiento biométrico, auditoría operativa y despacho automatizado de reportes ejecutivos para la Policía de Investigaciones de Chile.</p>
        </div>
      </section>
    </div>

    <div id="scanner-overlay" aria-hidden="true">
      <div class="scanner-scene">
        <div class="scanner-brand">ABIS · Autenticación biométrica</div>
        <div class="scanner-stage">
          <div class="scanner-halo"></div>
          <div class="scanner-scan-grid"></div>
          <div class="scanner-particle scan-particle-one"></div>
          <div class="scanner-particle scan-particle-two"></div>
          <div class="scanner-particle scan-particle-three"></div>
          <div class="scanner-frame">
            <span class="corner top-left"></span>
            <span class="corner top-right"></span>
            <span class="corner bottom-left"></span>
            <span class="corner bottom-right"></span>
            <span class="material-symbols-outlined fingerprint-icon" aria-hidden="true">fingerprint</span>
            <div class="laser"></div>
          </div>
        </div>
        <div class="scanner-text">Validando credenciales...</div>
        <div class="scanner-status-row">
          <span class="scanner-status-dot"></span>
          <span class="scanner-status">INICIANDO PROTOCOLO SEGURO</span>
          <span class="scanner-status-code">ABIS-SECURE</span>
        </div>
        <div class="scanner-progress" role="progressbar" aria-label="Progreso de validación" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <span class="scanner-progress-fill"></span>
        </div>
      </div>
    </div>
  </main>

  <script>
    const cardEl = document.querySelector('.card');
    const overlay = document.getElementById('scanner-overlay');
    const fp = document.querySelector('.fingerprint-icon');
    const text = document.querySelector('.scanner-text');
    const laser = document.querySelector('.laser');
    const scannerStatus = document.querySelector('.scanner-status');
    const progressBar = document.querySelector('.scanner-progress');
    const progressFill = document.querySelector('.scanner-progress-fill');

    function updateScannerProgress(value, message) {
      if (progressFill) progressFill.style.width = `${value}%`;
      if (progressBar) progressBar.setAttribute('aria-valuenow', String(value));
      if (scannerStatus && message) scannerStatus.textContent = message;
    }

    window.togglePasswordVisibility = function(inputId, btn) {
      const input = document.getElementById(inputId);
      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';
      btn.setAttribute('aria-pressed', String(isPassword));
      btn.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
      btn.innerHTML = isPassword
        ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>`
        : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg>`;
    };

    window.switchView = function(viewName) {
      document.getElementById('view-login').style.display = 'none';
      document.getElementById('view-register').style.display = 'none';
      document.getElementById('view-forgot').style.display = 'none';
      document.getElementById('view-' + viewName).style.display = 'block';
    };

    const formLogin = document.getElementById('form-login');
    formLogin.addEventListener('submit', (event) => {
      event.preventDefault();
      const submitButton = formLogin.querySelector('.submit-button');
      submitButton.disabled = true;
      overlay.classList.add('is-visible');
      overlay.setAttribute('aria-hidden', 'false');
      updateScannerProgress(12, 'INICIANDO PROTOCOLO SEGURO');

      setTimeout(() => updateScannerProgress(34, 'LEYENDO IDENTIDAD DIGITAL'), 450);
      setTimeout(() => updateScannerProgress(67, 'VALIDANDO FIRMA BIOMÉTRICA'), 1000);
      setTimeout(() => updateScannerProgress(88, 'CRUZANDO NODO ABIS'), 1500);

      setTimeout(() => {
        fp.classList.add('active');
        overlay.classList.add('is-verified');
        updateScannerProgress(100, 'ACCESO AUTORIZADO');
        text.innerHTML = '<span style="color: #FFD700;">IDENTIDAD VERIFICADA</span><br><span style="font-size: 18px; color: #ffffff; display: block; margin-top: 12px; font-weight: 800; animation: none; letter-spacing: 0.05em;">BIENVENIDO A ABIS</span>';
        laser.style.display = 'none';

        setTimeout(() => formLogin.submit(), 1600);
      }, 2000);
    });
  </script>
</body>
</html>
